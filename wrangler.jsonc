{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lina-blog",
	"compatibility_date": "2026-09-25",
	"assets": {
		// Only `/` runs the Worker first (curl responses and language redirects).
		// Other static pages are served from assets without starting the Worker.
		"run_worker_first": ["/"]
	},
	"observability": {
		"enabled": true
	}
}
