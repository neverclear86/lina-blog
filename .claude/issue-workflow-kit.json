      "DOC_COMMENT_RE": "^(/[*][*]|[*])",
      "TEST_PATH_RE": "[.](test|spec)[.][jt]sx?$",
      "DOCS_PATH_RE": "^(docs|design)/|[.]md$",
      "CONFIG_PATH_RE": "^[.](claude|github)/|[.](json|jsonc|ya?ml|toml)$|[.]config[.]m?[jt]s$|^astro[.]config[.]mjs$",
      "FORMAT_EXT_RE": "[.](ts|tsx|js|jsx|mjs|cjs|json|jsonc|astro|css)$",
      "FORMAT_FILE_CMD": "bunx biome format --write --no-errors-on-unmatched --files-ignore-unknown=true",
      "PUSH_CHECK_CMD": "bunx biome ci",
      "PROJECT_MARKER_FILE": "biome.json",
      "MERGE_BUILD_CMD": "bun install --frozen-lockfile && bunx astro check"
    },
    "modules": {
      "split": true,
      "design": true,
      "gate": true,
      "ci": true,
      "retro": true,
      "ports": true,
      "plan-tests": false,
      "hooks": true,
      "screenshots": true
    },
    "conditions": {
      "長く動くプロセスを立てる": true,
      "base が既定ブランチでない": false,
      "テストが外部の API に接続する": false,
      "テストが固定のポートを使う": false,
      "導入先に編集や停止で走る project hooks がある": false,
      "build が外部 API を叩く": false,
      "複数の platform 向けにイメージを作る": false,
      "変更履歴のファイルを保っている": false
    }
  },
