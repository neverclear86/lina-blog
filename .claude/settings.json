{
  "permissions": {
    "allow": [
      "Bash(gh issue close:*)",
      "Bash(gh issue edit:*)",
      "Bash(git -C * push --force-with-lease*)",
      "Bash(git push --force-with-lease*)"
    ],
    "deny": [
      "Bash(git -C * push --force-with-lease* main)",
      "Bash(git -C * push --force-with-lease* main *)",
      "Bash(git -C * push --force-with-lease*:main)",
      "Bash(git -C * push --force-with-lease*:main *)",
      "Bash(git -C * push --force-with-lease* +main)",
      "Bash(git -C * push --force-with-lease* +main *)",
      "Bash(git -C * push --force-with-lease*refs/heads/main*)",
      "Bash(git push --force-with-lease* main)",
      "Bash(git push --force-with-lease* main *)",
      "Bash(git push --force-with-lease*:main)",
      "Bash(git push --force-with-lease*:main *)",
      "Bash(git push --force-with-lease* +main)",
      "Bash(git push --force-with-lease* +main *)",
      "Bash(git push --force-with-lease*refs/heads/main*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny-force-push-main.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/biome-check.sh"
          }
        ]
      }
    ]
  }
}
