---
/**
 * Sample article with every Markdown syntax the site supports, rendered the way articles are.
 * `devPages()` in `src/dev/dev-pages.ts` serves it at `/dev/markdown/`.
 */
import ArticleBody from "../components/ArticleBody.astro";
import Layout from "../layouts/Layout.astro";
import { Content } from "../markdown/sample.md";
---

<Layout lang="ja" footer="compact">
  <main id="main" tabindex="-1">
    <ArticleBody lang="ja"><Content /></ArticleBody>
  </main>
</Layout>

<style>
main {
  max-width: 760px;
  margin-inline: auto;
  padding: 24px 16px 40px;
}

@media (min-width: 768px) {
  main {
    padding: 48px 20px;
  }
}
</style>
