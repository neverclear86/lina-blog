---
/**
 * The page at `/dev/components/`: samples of the plan A styles, the components and the avatar
 * images. `src/dev/sections/` has a file for each section, in the order they come here; the data
 * they show is in `src/dev/samples.ts`, and the classes that more than one section uses are in
 * `src/dev/layout.css`. `devPages()` in `src/dev/dev-pages.ts` serves it.
 */
import Layout from "../layouts/Layout.astro";
import AArticleEndSamples from "./sections/AArticleEndSamples.astro";
import AArticleHeadSamples from "./sections/AArticleHeadSamples.astro";
import AArticleTocSamples from "./sections/AArticleTocSamples.astro";
import ABreadcrumbSamples from "./sections/ABreadcrumbSamples.astro";
import AContactBandSamples from "./sections/AContactBandSamples.astro";
import AHeadingsSamples from "./sections/AHeadingsSamples.astro";
import AHeroAccountSamples from "./sections/AHeroAccountSamples.astro";
import AHeroPosesSamples from "./sections/AHeroPosesSamples.astro";
import ALabelsSamples from "./sections/ALabelsSamples.astro";
import APageHeadSamples from "./sections/APageHeadSamples.astro";
import AReadingProgressSamples from "./sections/AReadingProgressSamples.astro";
import AThreeViewSamples from "./sections/AThreeViewSamples.astro";
import AvatarSamples from "./sections/AvatarSamples.astro";
import AWindowSamples from "./sections/AWindowSamples.astro";
import AWinTitleSamples from "./sections/AWinTitleSamples.astro";
import ContactFormSamples from "./sections/ContactFormSamples.astro";
import EnglishSamples from "./sections/EnglishSamples.astro";
import ExternalNoteSamples from "./sections/ExternalNoteSamples.astro";
import FaceIconSamples from "./sections/FaceIconSamples.astro";
import LatestPostsSamples from "./sections/LatestPostsSamples.astro";
import LatestVideosSamples from "./sections/LatestVideosSamples.astro";
import NameLogoSamples from "./sections/NameLogoSamples.astro";
import PlanAControlsSamples from "./sections/PlanAControlsSamples.astro";
import PostListSamples from "./sections/PostListSamples.astro";
import PostNavSamples from "./sections/PostNavSamples.astro";
import SiteFooterSamples from "./sections/SiteFooterSamples.astro";
import SkipLinkSamples from "./sections/SkipLinkSamples.astro";
import SponsorNoticeSamples from "./sections/SponsorNoticeSamples.astro";
import ThemeToggleSamples from "./sections/ThemeToggleSamples.astro";
import "./layout.css";
---

<Layout lang="ja">
  <script is:inline slot="head">
  const theme = new URLSearchParams(location.search).get("theme");
  if (theme === "light" || theme === "dark") {
    document.documentElement.dataset.theme = theme;
  }
  </script>
  <main id="main" tabindex="-1" class="page">
    <h1>部品の確認</h1>
    <p><a href="?theme=light">ライト</a> / <a href="?theme=dark">ダーク</a></p>

    <AWindowSamples />
    <AHeroAccountSamples />
    <ALabelsSamples />
    <AHeadingsSamples />
    <APageHeadSamples />
    <ABreadcrumbSamples />
    <AArticleHeadSamples />
    <AArticleTocSamples />
    <AReadingProgressSamples />
    <AThreeViewSamples />
    <AHeroPosesSamples />
    <AContactBandSamples />
    <AArticleEndSamples />
    <SkipLinkSamples />
    <ThemeToggleSamples />
    <ExternalNoteSamples />
    <FaceIconSamples />
    <NameLogoSamples />
    <AvatarSamples />
    <LatestPostsSamples />
    <LatestVideosSamples />
    <PostListSamples />
    <SponsorNoticeSamples />
    <PostNavSamples />
    <PlanAControlsSamples />
    <ContactFormSamples />
    <AWinTitleSamples />
    <EnglishSamples />
    <SiteFooterSamples />
  </main>
</Layout>

<style>
.page {
  padding: 16px;
}
</style>
