---
import Bubble from "../components/Bubble.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TerminalCard from "../components/TerminalCard.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout lang="ja">
  <script is:inline slot="head">
  const theme = new URLSearchParams(location.search).get("theme");
  if (theme === "light" || theme === "dark") {
    document.documentElement.dataset.theme = theme;
  }
  </script>
  <main class="page">
    <h1>部品の確認</h1>
    <p><a href="?theme=light">ライト</a> / <a href="?theme=dark">ダーク</a></p>

    <section id="shapes">
      <h2>形と影</h2>
      <div class="row">
        <div class="shadow">
          <div class="shapeS sample small chip">shapeS</div>
        </div>
        <div class="shadow"><div class="shape sample surf">shape</div></div>
        <div class="shadowInk">
          <div class="shape sample orange">shadowInk</div>
        </div>
        <div class="shadow wide">
          <div class="shapeL sample large surf">shapeL</div>
        </div>
      </div>
      <div class="cbg">
        <div class="row">
          <div class="shadowF wide">
            <div class="shapeL sample large paper">shadowF</div>
          </div>
        </div>
      </div>
    </section>

    <section id="focus">
      <h2>lift とフォーカス</h2>
      <div class="row">
        <a class="part" href="#focus"
          ><span class="shadow lift"
            ><span class="shape sample surf">通常</span></span
          ></a
        >
        <a class="part" href="#focus"
          ><span class="shadow lift is-lift"
            ><span class="shape sample surf">lift</span></span
          ></a
        >
        <a class="part is-focus" href="#focus"
          ><span class="shadow lift"
            ><span class="shape sample surf">フォーカス</span></span
          ></a
        >
        <a class="is-focus" href="#focus">本文のリンク</a>
      </div>
      <div class="cbg">
        <div class="row">
          <a class="part is-focus" href="#focus"
            ><span class="shadowInk lift"
              ><span class="shape sample orange">フォーカス</span></span
            ></a
          >
        </div>
      </div>
    </section>

    <section id="cards">
      <h2>ターミナル窓カード</h2>
      <div class="cards">
        <TerminalCard title="~/works/nostr-no-su" href="#cards">
          <p class="card-body">リンクのカード</p>
        </TerminalCard>
        <TerminalCard
          title="~/works/nostr-no-su"
          href="#cards"
          class="is-focus"
        >
          <p class="card-body">フォーカス</p>
        </TerminalCard>
        <TerminalCard title="lina --stream">
          <p class="card-body">リンクでないカード</p>
        </TerminalCard>
        <TerminalCard title="lina --stream" class="is-lift">
          <p class="card-body">lift</p>
        </TerminalCard>
        <TerminalCard
          title="~/works/a-very-long-project-name-for-the-ellipsis"
          shape="shapeL"
        >
          <p class="card-body">shapeL と長い題</p>
        </TerminalCard>
      </div>
      <div class="cbg">
        <TerminalCard
          title="new-message.txt"
          shape="shapeL"
          shadow="fshadow"
          tone="paper"
          lift={false}
        >
          <p class="card-body">
            <a class="is-focus" href="#cards">紙の面のフォーカス</a>
          </p>
        </TerminalCard>
      </div>
    </section>

    <section id="bubbles">
      <h2>吹き出し</h2>
      <div class="row">
        <Bubble>
          <span>今日もITで遊んでる〜</span>
          <span>⸜(*ˊᗜˋ*)⸝</span>
        </Bubble>
        <Bubble>
          <span
            >長い本文は吹き出しの幅に収まるように折り返す。長い本文は吹き出しの幅に収まるように折り返す。長い本文は吹き出しの幅に収まるように折り返す。</span
          >
        </Bubble>
      </div>
    </section>

    <section id="headings">
      <h2>セクション見出し</h2>
      <div class="stack">
        <SectionHeading
          label="~/about"
          title="ABOUT"
          subtitle="創好リナってこんな人"
        >
          <p class="heading-aside">
            名前の由来はLinux。配信もするし、開発もする、バーチャルイキリプログラマです。
          </p>
        </SectionHeading>
        <SectionHeading
          label="~/contact"
          title="CONTACT"
          subtitle="お問い合わせ"
          as="h3"
        />
        <div lang="en">
          <SectionHeading
            label="~/works"
            title="WORKS"
            subtitle="Things I made"
            as="h3"
          >
            <a href="#headings">See all</a>
          </SectionHeading>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
.page {
  padding: 16px;
}

.row {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
  align-items: flex-start;
}

.sample {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120px;
  height: 64px;
}

.small {
  width: 80px;
  height: 28px;
}

.wide {
  width: min(100%, 480px);
}

.large {
  width: 100%;
  height: 160px;
}

.chip {
  background: var(--chip);
}

.surf {
  background: var(--surf);
}

.orange {
  background: var(--orange);
  color: var(--ink);
}

.paper {
  background: var(--paper);
  color: var(--ink);
}

.part {
  display: inline-block;
  text-decoration: none;
}

.part > span {
  display: block;
}

.cbg {
  padding: 24px;
  margin-top: 24px;
  background: var(--cbg);
  color: var(--cfg);
  --focus-ring: var(--cfg);
}

section {
  margin-top: 40px;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  gap: 32px;
}

.card-body {
  margin: 0;
  padding: 20px 22px;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 40px;
}

.heading-aside {
  margin: 0;
  max-width: 480px;
}
</style>
