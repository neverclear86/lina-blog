---
import Bubble from "../components/Bubble.astro";
import Button from "../components/Button.astro";
import Chip from "../components/Chip.astro";
import IconButton from "../components/IconButton.astro";
import IconLink from "../components/IconLink.astro";
import GitHubIcon from "../components/icons/GitHubIcon.astro";
import NostrIcon from "../components/icons/NostrIcon.astro";
import RssIcon from "../components/icons/RssIcon.astro";
import XIcon from "../components/icons/XIcon.astro";
import YouTubeIcon from "../components/icons/YouTubeIcon.astro";
import ZennIcon from "../components/icons/ZennIcon.astro";
import Kao from "../components/Kao.astro";
import PixelArt from "../components/PixelArt.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Tape from "../components/Tape.astro";
import TerminalCard from "../components/TerminalCard.astro";
import { translate } from "../i18n/ui";
import Layout from "../layouts/Layout.astro";

// Commands for the typing samples: 16 characters (the design) and 10.
const COMMANDS = ["$ npm run deploy", "$ git push"];
---

<Layout lang="ja">
  <script is:inline slot="head">
  const theme = new URLSearchParams(location.search).get("theme");
  if (theme === "light" || theme === "dark") {
    document.documentElement.dataset.theme = theme;
  }
  </script>
  <main class="page">
    <h1>部品の確認</h1>
    <p><a href="?theme=light">ライト</a> / <a href="?theme=dark">ダーク</a></p>

    <section id="shapes">
      <h2>形と影</h2>
      <div class="row">
        <div class="shadow">
          <div class="shapeS sample small chip">shapeS</div>
        </div>
        <div class="shadow"><div class="shape sample surf">shape</div></div>
        <div class="shadowInk">
          <div class="shape sample orange">shadowInk</div>
        </div>
        <div class="shadow wide">
          <div class="shapeL sample large surf">shapeL</div>
        </div>
      </div>
      <div class="cbg">
        <div class="row">
          <div class="shadowF wide">
            <div class="shapeL sample large paper">shadowF</div>
          </div>
        </div>
      </div>
    </section>

    <section id="focus">
      <h2>lift とフォーカス</h2>
      <div class="row">
        <a class="part" href="#focus"
          ><span class="shadow lift"
            ><span class="shape sample surf">通常</span></span
          ></a
        >
        <a class="part" href="#focus"
          ><span class="shadow lift is-lift"
            ><span class="shape sample surf">lift</span></span
          ></a
        >
        <a class="part is-focus" href="#focus"
          ><span class="shadow lift"
            ><span class="shape sample surf">フォーカス</span></span
          ></a
        >
        <a class="is-focus" href="#focus">本文のリンク</a>
      </div>
      <div class="cbg">
        <div class="row">
          <a class="part is-focus" href="#focus"
            ><span class="shadowInk lift"
              ><span class="shape sample orange">フォーカス</span></span
            ></a
          >
        </div>
      </div>
    </section>

    <section id="cards">
      <h2>ターミナル窓カード</h2>
      <div class="cards">
        <TerminalCard title="~/works/nostr-no-su" href="#cards">
          <p class="card-body">リンクのカード</p>
        </TerminalCard>
        <TerminalCard
          title="~/works/nostr-no-su"
          href="#cards"
          class="is-focus"
        >
          <p class="card-body">フォーカス</p>
        </TerminalCard>
        <TerminalCard title="lina --stream">
          <p class="card-body">リンクでないカード</p>
        </TerminalCard>
        <TerminalCard title="lina --stream" class="is-lift">
          <p class="card-body">lift</p>
        </TerminalCard>
        <TerminalCard
          title="~/works/a-very-long-project-name-for-the-ellipsis"
          shape="shapeL"
        >
          <p class="card-body">shapeL と長い題</p>
        </TerminalCard>
      </div>
      <div class="cbg">
        <TerminalCard
          title="new-message.txt"
          shape="shapeL"
          shadow="fshadow"
          tone="paper"
          lift={false}
        >
          <p class="card-body">
            <a class="is-focus" href="#cards">紙の面のフォーカス</a>
          </p>
        </TerminalCard>
      </div>
    </section>

    <section id="bubbles">
      <h2>吹き出し</h2>
      <div class="row">
        <Bubble>
          <span>今日もITで遊んでる〜</span>
          <span>⸜(*ˊᗜˋ*)⸝</span>
        </Bubble>
        <Bubble>
          <span
            >長い本文は吹き出しの幅に収まるように折り返す。長い本文は吹き出しの幅に収まるように折り返す。長い本文は吹き出しの幅に収まるように折り返す。</span
          >
        </Bubble>
      </div>
    </section>

    <section id="headings">
      <h2>セクション見出し</h2>
      <div class="stack">
        <SectionHeading
          label="~/about"
          title="ABOUT"
          subtitle="創好リナってこんな人"
        >
          <p class="heading-aside">
            名前の由来はLinux。配信もするし、開発もする、バーチャルイキリプログラマです。
          </p>
        </SectionHeading>
        <SectionHeading
          label="~/contact"
          title="CONTACT"
          subtitle="お問い合わせ"
          as="h3"
        />
        <div lang="en">
          <SectionHeading
            label="~/works"
            title="WORKS"
            subtitle="Things I made"
            as="h3"
          >
            <a href="#headings">See all</a>
          </SectionHeading>
        </div>
      </div>
    </section>

    <section id="buttons">
      <h2>ボタン</h2>
      <div class="row">
        <Button href="#buttons">お問い合わせ</Button>
        <Button href="#buttons" class="is-hover">お問い合わせ</Button>
        <Button href="#buttons" class="is-focus">お問い合わせ</Button>
      </div>
      <div class="cbg">
        <div class="form">
          <div class="row">
            <Button size="lg" shadow="ink" type="submit">送信する</Button>
            <Button size="lg" shadow="ink" type="submit" class="is-hover"
              >送信する</Button
            >
            <Button size="lg" shadow="ink" type="submit" class="is-focus"
              >送信する</Button
            >
            <Button size="lg" shadow="ink" type="submit" disabled
              >送信する</Button
            >
          </div>
        </div>
      </div>
    </section>

    <section id="icons">
      <h2>アイコン</h2>
      <div class="row">
        <IconButton label="ライト・ダークを切り替え"
          ><svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg></IconButton
        >
        <IconButton label="ライト・ダークを切り替え" class="is-hover"
          ><svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg></IconButton
        >
        <IconButton label="ライト・ダークを切り替え" class="is-focus"
          ><svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg></IconButton
        >
        <IconButton label="メニューを開く" tone="inverse"
          ><svg
            aria-hidden="true"
            width="18"
            height="12"
            viewBox="0 0 18 12"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M0 1h18M0 6h18M0 11h10"></path>
          </svg></IconButton
        >
        <IconButton label="メニューを開く" tone="inverse" class="is-focus"
          ><svg
            aria-hidden="true"
            width="18"
            height="12"
            viewBox="0 0 18 12"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M0 1h18M0 6h18M0 11h10"></path>
          </svg></IconButton
        >
      </div>
      <div class="row">
        <IconLink href="#icons" label="YouTube"><YouTubeIcon /></IconLink>
        <IconLink
          href="#icons"
          label={translate("ja", "social.twitter")}
          rel="me"
          ><XIcon /></IconLink
        >
        <IconLink
          href="#icons"
          label={translate("ja", "social.twitter")}
          rel="me"
          class="is-hover"
          ><XIcon /></IconLink
        >
        <IconLink
          href="#icons"
          label={translate("ja", "social.twitter")}
          rel="me"
          class="is-focus"
          ><XIcon /></IconLink
        >
      </div>
      <div class="row">
        <IconLink href="#icons" label="YouTube"><YouTubeIcon /></IconLink>
        <IconLink href="#icons" label={translate("ja", "social.twitter")}
          ><XIcon /></IconLink
        >
        <IconLink href="#icons" label="GitHub"><GitHubIcon /></IconLink>
        <IconLink href="#icons" label="Nostr"><NostrIcon /></IconLink>
        <IconLink href="#icons" label="Zenn"><ZennIcon /></IconLink>
        <IconLink href="#icons" label="RSS"><RssIcon /></IconLink>
      </div>
      <div class="row">
        <div class="narrow">
          <IconLink href="#icons" label={translate("ja", "social.twitter")}
            ><XIcon /></IconLink
          >
        </div>
      </div>
    </section>

    <section id="chips">
      <h2>チップ</h2>
      <div class="row">
        <Chip tone="pink" tilt>バーチャルイキリプログラマ</Chip>
        <Chip tone="pink">NEW</Chip>
        <Chip tone="orange">制作記</Chip>
        <Chip>技術</Chip>
      </div>
      <div class="row">
        <div class="narrow-chip">
          <Chip>とても長いタグの名前がここに入る</Chip>
        </div>
      </div>
    </section>

    <section id="tape">
      <h2>テープ</h2>
      <div class="strip">
        <Tape />
        <span class="strip-text">幅 160px、高さ 40px（Hero の下端）</span>
      </div>
      <div class="strip strip-mobile">
        <Tape width="64px" />
        <span class="strip-text">幅 64px、高さ 36px（モバイル）</span>
      </div>
    </section>

    <section id="pixel-art">
      <h2>ドット絵</h2>
      <div class="row">
        <PixelArt />
        <PixelArt bob />
      </div>
    </section>

    <section id="english" lang="en">
      <h2>英語</h2>
      <div class="row">
        <Button href="#english">Contact</Button>
        <Button size="lg" shadow="ink">Send</Button>
        <IconButton label="Switch between light and dark"
          ><svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg></IconButton
        >
        <IconLink
          href="#english"
          label={translate("en", "social.twitter")}
          rel="me"
          ><XIcon /></IconLink
        >
      </div>
      <div class="row">
        <IconLink href="#english" label="YouTube"><YouTubeIcon /></IconLink>
        <IconLink href="#english" label={translate("en", "social.twitter")}
          ><XIcon /></IconLink
        >
        <IconLink href="#english" label="GitHub"><GitHubIcon /></IconLink>
        <IconLink href="#english" label="Nostr"><NostrIcon /></IconLink>
        <IconLink href="#english" label="Zenn"><ZennIcon /></IconLink>
        <IconLink href="#english" label="RSS"><RssIcon /></IconLink>
      </div>
    </section>
    <section id="motion">
      <h2>動き</h2>
      <div class="row">
        <PixelArt class="bob" width={96} />
        <p class="motion-text">
          配信もするし、開発もする。<span class="caret" aria-hidden="true"
            >▍</span
          >
        </p>
      </div>
      <div class="row">
        {COMMANDS.map((command) => (
  <span class="prompt">
    <span class="a-typeLoop" style={`--type-steps: ${[...command].length}`}>
      {command}
    </span>
    <span class="caret" aria-hidden="true">
      ▍
    </span>
  </span>
))}
      </div>
      <div class="row">
        <Bubble>
          <span>今日もITで遊んでる〜</span>
          <span class="kao-bubble"
            ><Kao faces={["⸜(*ˊᗜˋ*)⸝", "(๑•̀ㅂ•́)و✧", "✌︎('ω'✌︎ )"]} /></span
          >
        </Bubble>
      </div>
      <div class="band">
        <span>status: online</span>
        <Kao faces={["⸜(*ˊᗜˋ*)⸝", "ᐠ( ᐛ )ᐟ", "(๑•̀ㅂ•́)و✧"]} />
      </div>
    </section>
  </main>
</Layout>

<style>
.page {
  padding: 16px;
}

.row {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
  align-items: flex-start;
}

.sample {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120px;
  height: 64px;
}

.small {
  width: 80px;
  height: 28px;
}

.wide {
  width: min(100%, 480px);
}

.large {
  width: 100%;
  height: 160px;
}

.chip {
  background: var(--chip);
}

.surf {
  background: var(--surf);
}

.strip {
  display: flex;
  align-items: stretch;
  width: min(100%, 480px);
  height: 40px;
  margin-bottom: 16px;
  background: var(--inv);
  color: var(--invfg);
}

.strip-mobile {
  height: 36px;
}

.strip-text {
  display: flex;
  align-items: center;
  padding: 0 12px;
  font-size: 13px;
}

.orange {
  background: var(--orange);
  color: var(--ink);
}

.paper {
  background: var(--paper);
  color: var(--ink);
}

.part {
  display: inline-block;
  text-decoration: none;
}

.part > span {
  display: block;
}

.cbg {
  padding: 24px;
  margin-top: 24px;
  background: var(--cbg);
  color: var(--cfg);
  --focus-ring: var(--cfg);
}

section {
  margin-top: 40px;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  gap: 32px;
}

.card-body {
  margin: 0;
  padding: 20px 22px;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 40px;
}

.heading-aside {
  margin: 0;
  max-width: 480px;
}

.row + .row {
  margin-top: 24px;
}

.form {
  padding: 24px;
  background: var(--paper);
  color: var(--ink);
  --focus-ring: var(--ink);
}

.narrow {
  width: 60px;
}

.narrow-chip {
  width: 100px;
}

.motion-text {
  margin: 0;
}

.prompt {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--muted);
}

.kao-bubble {
  font-size: 18px;
  font-weight: 700;
}

.band {
  display: flex;
  gap: 8px;
  align-items: center;
  height: 40px;
  margin-top: 24px;
  padding: 0 24px;
  background: var(--inv);
  color: var(--invfg);
  font-family: var(--font-mono);
  font-size: 13px;
}
</style>
