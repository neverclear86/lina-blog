---
import { Image, Picture } from "astro:assets";
import type { ComponentProps } from "astro/types";
import { AVATAR_IMAGES, avatarAlt, THUMBS_UP_BAND } from "../avatar-images";
import ArticleBody from "../components/ArticleBody.astro";
import ArticleEnd from "../components/ArticleEnd.astro";
import ArticleToc from "../components/ArticleToc.astro";
import AvatarThreeView from "../components/AvatarThreeView.astro";
import ContactBand from "../components/ContactBand.astro";
import ContactForm from "../components/ContactForm.astro";
import FaceIcon from "../components/FaceIcon.astro";
import HeroAccount from "../components/HeroAccount.astro";
import HeroPoses from "../components/HeroPoses.astro";
import GitHubIcon from "../components/icons/GitHubIcon.astro";
import RssIcon from "../components/icons/RssIcon.astro";
import XIcon from "../components/icons/XIcon.astro";
import YouTubeIcon from "../components/icons/YouTubeIcon.astro";
import LatestPosts from "../components/LatestPosts.astro";
import LatestVideoFeature from "../components/LatestVideoFeature.astro";
import LatestVideoList from "../components/LatestVideoList.astro";
import NameLogo from "../components/NameLogo.astro";
import PageHead from "../components/PageHead.astro";
import PostNav from "../components/PostNav.astro";
import PostRows from "../components/PostRows.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import SectionTitle from "../components/SectionTitle.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SponsorNotice from "../components/SponsorNotice.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import WorkTile from "../components/WorkTile.astro";
import { translate } from "../i18n/ui";
import Layout from "../layouts/Layout.astro";
import { sponsorNotice } from "../sponsor-notice";
import type { YouTubeVideo } from "../youtube-feed";

const samplePosts: ComponentProps<typeof LatestPosts>["posts"] = [
  {
    data: {
      title: "サイトをAstroで作り直した話",
      slug: "sample-post-devlog",
      date: new Date("2026-09-20"),
      tags: ["制作記"],
    },
  },
  {
    data: {
      title: "Cloudflare Workersで静的なページとAPIを同じWorkerから配信する",
      slug: "sample-post-tech-devlog",
      date: new Date("2026-09-12"),
      tags: ["技術", "制作記"],
    },
  },
  {
    data: {
      title: "配信の機材を少しずつ入れ替えた一週間",
      slug: "sample-post-diary",
      date: new Date("2026-09-05"),
      tags: ["日記"],
    },
  },
  {
    data: {
      title: "いちばん古い記事は出ない",
      slug: "sample-post-oldest",
      date: new Date("2026-08-01"),
      tags: ["技術"],
    },
  },
];

// Sponsors for the notice samples: one with a URL, whose name is a link, and one without.
const sampleNotices = [
  { name: "サンプル株式会社", url: "https://example.com/" },
  { name: "サンプル株式会社" },
]
  .map(sponsorNotice)
  .filter((notice) => notice !== undefined);

// Posts for the samples of the links to the posts next to a post: a short title, and a title that
// wraps to three lines or more at 390px.
const samplePrevPost: ComponentProps<typeof PostNav>["prev"] = {
  data: { title: "短い題", slug: "sample-post-short" },
};
const sampleNextPost: ComponentProps<typeof PostNav>["next"] = {
  data: {
    title:
      "Cloudflare Workersで静的なページとAPIを同じWorkerから配信し、お問い合わせのフォームまで1つにまとめた構成の記録",
    slug: "sample-post-long-title",
  },
};

// Items for the table of contents samples: the last has a long text with a word that has no
// break, to show that an item wraps and never pushes the window wider.
const sampleToc: ComponentProps<typeof ArticleToc>["items"] = [
  { slug: "a-article-toc", text: "なぜ公開するのか" },
  { slug: "a-article-toc", text: "READMEを本気で書く" },
  {
    slug: "a-article-toc",
    text: "長い見出しは折り返される。区切りの無い語も supercalifragilisticexpialidocious",
  },
  { slug: "a-article-toc", text: "おわりに" },
];

// Posts for the post rows samples: a title that wraps to three lines or more at 390px, three
// tags and a sponsor. They are not in date order, to show that the rows keep the order they are
// given.
const sampleListPosts: ComponentProps<typeof PostRows>["posts"] = [
  {
    data: {
      title: "サイトをAstroで作り直した話",
      slug: "sample-post-devlog",
      date: new Date("2026-09-20"),
      tags: ["制作記"],
    },
  },
  {
    data: {
      title:
        "Cloudflare Workersで静的なページとAPIを同じWorkerから配信し、お問い合わせのフォームまで1つにまとめた構成の記録",
      slug: "sample-post-long-title",
      date: new Date("2026-09-12"),
      tags: ["技術", "制作記", "日記"],
    },
  },
  {
    data: {
      title: "配信の機材を少しずつ入れ替えた一週間",
      slug: "sample-post-diary",
      date: new Date("2026-08-20"),
      tags: ["日記"],
    },
  },
  {
    data: {
      title: "キーボードを提供していただいたので使ってみた",
      slug: "sample-post-sponsor",
      date: new Date("2026-08-28"),
      tags: ["技術"],
      sponsor: { name: "サンプル株式会社" },
    },
  },
  {
    data: {
      title: "短い題",
      slug: "sample-post-short",
      date: new Date("2026-08-01"),
      tags: ["技術"],
    },
  },
];

const sampleVideo = (
  id: string,
  title: string,
  publishedAt: string,
): YouTubeVideo => ({
  id,
  title,
  publishedAt: new Date(publishedAt),
  url: `https://www.youtube.com/watch?v=${id}`,
  thumbnail: {
    src: `https://i.ytimg.com/vi/${id}/hqdefault.jpg`,
    srcset: `https://i.ytimg.com/vi/${id}/mqdefault.jpg 320w, https://i.ytimg.com/vi/${id}/hqdefault.jpg 480w`,
  },
});

// Videos for the Latest samples. The IDs do not exist on i.ytimg.com, so the thumbnails do
// not load and the boxes stay empty.
const sampleVideos: YouTubeVideo[] = [
  sampleVideo(
    "AAAAAAAAAAA",
    "長いタイトルの見本。".repeat(10),
    "2026-09-27T15:30:00Z",
  ),
  sampleVideo(
    "BBBBBBBBBBB",
    "長いタイトルの見本。".repeat(10),
    "2026-09-20T10:00:00Z",
  ),
  sampleVideo("CCCCCCCCCCC", "短いタイトル", "2026-09-13T10:00:00Z"),
];
---

<Layout lang="ja">
  <script is:inline slot="head">
  const theme = new URLSearchParams(location.search).get("theme");
  if (theme === "light" || theme === "dark") {
    document.documentElement.dataset.theme = theme;
  }
  </script>
  <main class="page">
    <h1>部品の確認</h1>
    <p><a href="?theme=light">ライト</a> / <a href="?theme=dark">ダーク</a></p>

    <section id="a-window">
      <h2>A案: 窓・角の目盛り・背景の装飾</h2>
      <div class="a-samples">
        <div class="win a-sample"><code>div.win</code></div>
        <a class="win a-sample" href="#a-window"><code>a.win</code></a>
        <a class="win is-hover a-sample" href="#a-window"
          ><code>a.win.is-hover</code></a
        >
        <a class="win is-focus a-sample" href="#a-window"
          ><code>a.win.is-focus</code></a
        >
        <div class="ticks a-sample"><code>div.ticks</code></div>
        <div class="win acct a-sample">
          <a class="ticks-acc a-inner" href="#a-window"
            ><code>div.win.acct a.ticks-acc</code></a
          >
        </div>
        <div class="win acct is-hover a-sample">
          <div class="ticks-acc a-inner">
            <code>div.win.acct.is-hover</code>
          </div>
        </div>
        <div class="win acct is-focus a-sample">
          <div class="ticks-acc a-inner">
            <code>div.win.acct.is-focus</code>
          </div>
        </div>
        <div class="gridbg a-sample"><code>div.gridbg</code></div>
        <Image
          src={THUMBS_UP_BAND.src}
          alt=""
          width={240}
          class="av-shadow a-avatar"
        />
      </div>
      <div class="stripes"></div>
    </section>

    <section id="a-hero-account">
      <h2>A案: Hero のアカウントの窓</h2>
      <div class="a-acct a-acct-520"><HeroAccount lang="ja" /></div>
      <div class="a-acct a-acct-459"><HeroAccount lang="en" /></div>
      <div class="a-acct a-acct-317"><HeroAccount lang="ja" /></div>
    </section>

    <section id="a-labels">
      <h2>A案: ラベル・タグ・カテゴリのチップ</h2>
      <div class="row">
        <span class="label">label</span>
        <span class="label">[YYYY.MM.DD] · youtube</span>
        <span class="label">最新動画のサムネイル</span>
      </div>
      <div class="row">
        <span class="tag">制作記</span>
        <span class="tag">astro</span>
        <span class="tag">cloudflare workers</span>
        <span class="chip-acc">制作記</span>
        <span class="chip-acc">NEW</span>
      </div>
      <div class="a-panel">
        <span class="label">label</span>
        <span class="tag">制作記</span>
        <span class="chip-acc">制作記</span>
      </div>
      <div class="a-narrow">
        <span class="tag">とても長いタグの名前がここに入る</span>
        <span class="chip-acc">とても長いカテゴリの名前がここに入る</span>
      </div>
    </section>

    <section id="a-headings">
      <h2>A案: セクションの見出し</h2>
      <div class="stack">
        <SectionTitle
          no="02"
          label="latest"
          path="~/latest"
          title="さいきんの配信"
        />
        <SectionTitle
          no="01"
          label="about"
          path="~/about"
          title={"はじめまして、\n創好リナです。"}
          size="md"
        />
        <SectionTitle no="03" label="blog" path="~/blog" title="さいきんの記事">
          <a slot="link" href="#a-headings"
            >記事一覧 <span aria-hidden="true">→</span></a
          >
        </SectionTitle>
        <SectionTitle no="04" label="works" as="h2">
          <a slot="link" href="#a-headings"
            >ls ~/works <span aria-hidden="true">→</span></a
          >
        </SectionTitle>
        <div lang="en">
          <SectionTitle
            no="05"
            label="a-section-with-a-very-long-english-name"
            path="~/long"
            title="Supercalifragilisticexpialidocious-heading-without-any-space"
            as="h3"
          >
            <a slot="link" href="#a-headings"
              >ls ~/works <span aria-hidden="true">→</span></a
            >
          </SectionTitle>
        </div>
        <SectionTitle no="06" label="focus" title="フォーカスの表示">
          <a slot="link" class="is-focus" href="#a-headings"
            >ls ~/focus <span aria-hidden="true">→</span></a
          >
        </SectionTitle>
      </div>
    </section>

    <section id="a-page-head">
      <h2>A案: ページの頭とナビの切り替え</h2>
      <div class="row">
        <a class="ws on" href="#a-page-head" aria-current="page">.ws.on</a>
        <a class="ws" href="#a-page-head">.ws</a>
        <a class="ws is-hover" href="#a-page-head">.ws.is-hover</a>
        <a class="ws is-focus" href="#a-page-head">.ws.is-focus</a>
      </div>
      <PageHead>
        <nav
          aria-label="パンくず"
          style="font-family: var(--font-mono); font-size: 13px; color: var(--muted)"
        >
          ~ / blog / <span style="color: var(--text)">tags</span>
        </nav>
        <h1>技術の記事</h1>
        <div class="row">
          <a class="ws" href="#a-page-head">すべて</a>
          <a class="ws on" href="#a-page-head" aria-current="page">技術</a>
        </div>
      </PageHead>
    </section>

    <section id="a-article-toc">
      <h2>A案: 記事の目次</h2>
      <div class="a-toc a-toc-window">
        <ArticleToc items={sampleToc} lang="ja" variant="window" />
      </div>
      <div class="a-toc a-toc-window">
        <ArticleToc items={sampleToc} lang="ja" variant="window" current={1} />
      </div>
      <div class="a-toc a-toc-sheet">
        <ArticleToc items={sampleToc} lang="ja" variant="sheet" />
      </div>
    </section>

    <section id="a-reading-progress">
      <h2>A案: 読み進み</h2>
      <div class="stack">
        <div class="a-progress a-progress-0">
          <ReadingProgress variant="bar" />
        </div>
        <div class="a-progress a-progress-half">
          <ReadingProgress variant="bar" />
        </div>
        <div class="a-progress a-progress-full">
          <ReadingProgress variant="bar" />
        </div>
        <div class="a-progress a-progress-0">
          <ReadingProgress variant="line" />
        </div>
        <div class="a-progress a-progress-half">
          <ReadingProgress variant="line" />
        </div>
        <div class="a-progress a-progress-full">
          <ReadingProgress variant="line" />
        </div>
      </div>
    </section>

    <section id="a-works">
      <h2>A案: 作品のタイル</h2>
      <div class="a-tiles">
        <WorkTile
          lang="ja"
          title="ikili.pro"
          description="創好リナの個人サイト兼ブログ。Astro と Cloudflare Workers で作っている。"
          tech={["astro", "typescript", "cloudflare"]}
          link={{ href: "#a-works", external: false }}
        />
        <WorkTile
          lang="ja"
          title="placeholder-work"
          description="外部のサイトへのリンクになる作品。名前の後ろに ↗ が付く。"
          tech={["typescript"]}
          link={{ href: "#a-works", external: true }}
        />
        <WorkTile
          lang="ja"
          class="is-hover"
          title="is-hover"
          description="ホバーのとき。枠が回った後の角度になる。"
          tech={["astro"]}
          link={{ href: "#a-works", external: false }}
        />
        <WorkTile
          lang="ja"
          class="is-focus"
          title="is-focus"
          description="キーボードのフォーカスのとき。枠が回った後の角度になり、輪が付く。"
          tech={["astro"]}
          link={{ href: "#a-works", external: false }}
        />
        <WorkTile
          lang="ja"
          title="a-work-with-a-very-long-name-that-has-no-break-in-it-at-all-1234567890"
          description="Averyveryverylongwordwithoutanybreakinthedescriptionthatmustwrapinsidethewindow"
          tech={[
  "a-technology-with-a-very-long-name-that-the-tag-cuts-with-an-ellipsis",
  "astro",
]}
        />
        <WorkTile
          lang="en"
          title="no-tags"
          description="A work without technologies, with a link to another site."
          tech={[]}
          link={{ href: "#a-works", external: true }}
        />
      </div>
    </section>

    <section id="a-three-view">
      <h2>A案: アバターの三面図</h2>
      <AvatarThreeView lang="ja" />
      <div lang="en"><AvatarThreeView lang="en" /></div>
    </section>

    <section id="a-hero-poses">
      <h2>A案: Hero のポーズの切り替え</h2>
      <div class="pose-sample"><HeroPoses lang="ja" /></div>
      <div class="pose-sample" lang="en"><HeroPoses lang="en" /></div>
    </section>

    <section id="a-contact-band">
      <h2>A案: お問い合わせの帯</h2>
      <ContactBand lang="ja" />
    </section>

    <section id="a-article-end">
      <h2>A案: 記事の終わりの窓</h2>
      <ArticleEnd
        title="サンプルの記事の題"
        url="https://ikili.pro/blog/sample/"
      />
    </section>

    <section id="theme-toggle">
      <h2>テーマの切り替え</h2>
      <div class="row">
        <ThemeToggle lang="ja" />
        <ThemeToggle lang="ja" variant="labeled" />
      </div>
    </section>

    <section id="face-icon">
      <h2>顔アイコン</h2>
      <div class="row">
        <FaceIcon kind="mark" size={27} alt="" />
        <FaceIcon kind="mark" size={28} alt="" />
        <FaceIcon kind="mark" size={44} alt="" />
        <FaceIcon kind="mark" size={45} alt="" />
        <FaceIcon kind="mark" size={96} alt="" />
      </div>
      <div class="row">
        <div class="inv-face">
          <FaceIcon kind="mark" size={28} alt="" tone="inverse" />
        </div>
        <div class="inv-face">
          <FaceIcon kind="mark" size={45} alt="" tone="inverse" />
        </div>
        <div class="inv-face">
          <FaceIcon kind="mark" size={96} alt="" tone="inverse" />
        </div>
      </div>
      <div class="row">
        <FaceIcon kind="avatar" size={24} alt="" />
        <FaceIcon kind="avatar" size={39} alt="" />
        <FaceIcon kind="avatar" size={40} alt="" />
        <FaceIcon kind="avatar" size={96} alt="創好リナ アイコン" />
      </div>
    </section>

    <section id="name-logo">
      <h2>ネームロゴ</h2>
      <div class="row">
        <figure class="logo-sample logo-82">
          <NameLogo variant="compact" label="/lina $_" />
          <figcaption>compact 82px（スマホのヘッダー）</figcaption>
        </figure>
        <figure class="logo-sample logo-92">
          <NameLogo variant="compact" label="/lina $_" />
          <figcaption>compact 92px（PC のヘッダー）</figcaption>
        </figure>
      </div>
      <div class="row">
        <figure class="logo-sample logo-296">
          <NameLogo variant="full" label="/tsukusu/lina $_" />
          <figcaption>full 296px（スラッシュ 32px）</figcaption>
        </figure>
        <figure class="logo-sample logo-420">
          <NameLogo variant="full" label="/tsukusu/lina $_" />
          <figcaption>full 420px（PC のフッター）</figcaption>
        </figure>
      </div>
      <div class="row">
        <figure class="logo-sample logo-576 blink-on">
          <NameLogo
            variant="full-sub"
            label="/tsukusu/lina $_ # 創好リナ ── VIRTUAL IKIRI PROGRAMMER"
          />
          <figcaption>
            full-sub 576px、カーソルは親の .blink-on で点滅
          </figcaption>
        </figure>
      </div>
    </section>

    <section id="avatar">
      <h2>アバター（v2.1）</h2>
      <div class="row">
        {AVATAR_IMAGES.map((avatar) => (
  <figure class="avatar-sample" data-name={avatar.name}>
    <Picture
      src={avatar.src}
      alt={avatarAlt(avatar, "ja")}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={avatar.widths}
      sizes={avatar.sizes}
      priority={avatar.priority}
      class="avatar-img"
    />
    <figcaption class="avatar-caption">
      {avatar.name}
      <br />
      alt: {avatarAlt(avatar, "ja") || "（空）"}
    </figcaption>
  </figure>
))}
      </div>
    </section>

    <section id="latest-posts">
      <h2>最新記事</h2>
      <div class="latest-samples">
        <LatestPosts id="blog-ja" lang="ja" posts={samplePosts} />
        <div lang="en">
          <LatestPosts id="blog-en" lang="en" posts={samplePosts} />
        </div>
        <LatestPosts id="blog-empty" lang="ja" posts={[]} />
      </div>
    </section>

    <section id="latest-videos">
      <h2>最新の動画</h2>
      <div class="stack">
        <div class="latest-video-sample">
          <LatestVideoFeature lang="ja" video={sampleVideos[0]} />
        </div>
        <div class="latest-video-sample">
          <LatestVideoFeature
            lang="ja"
            video={sampleVideos[0]}
            class="is-hover"
          />
        </div>
        <div class="latest-video-sample">
          <LatestVideoFeature
            lang="ja"
            video={sampleVideos[0]}
            class="is-focus"
          />
        </div>
        <div class="latest-video-sample">
          <LatestVideoFeature lang="ja" video={undefined} />
        </div>
        <div class="latest-video-narrow" lang="en">
          <LatestVideoFeature lang="en" video={undefined} />
        </div>
        <div class="latest-video-narrow">
          <LatestVideoFeature lang="ja" video={sampleVideos[2]} />
        </div>
        <div class="latest-list-sample">
          <LatestVideoList lang="ja" videos={sampleVideos} />
        </div>
        <div class="latest-list-narrow" lang="en">
          <LatestVideoList lang="en" videos={sampleVideos.slice(0, 1)} />
        </div>
        <div class="latest-list-sample">
          <LatestVideoList lang="ja" videos={[]} />
        </div>
      </div>
    </section>

    <section id="post-list">
      <h2>記事の一覧</h2>
      <div class="stack">
        <PostRows
          path="~/blog"
          posts={sampleListPosts}
          emptyText={translate("ja", "latest.blog.noPosts")}
        />
        <PostRows
          path="~/blog/tags/tech"
          posts={[]}
          emptyText={translate("ja", "blog.tagPage.tech.noPosts")}
        />
        <PostRows
          path="~/blog"
          posts={sampleListPosts}
          emptyText={translate("en", "latest.blog.noPosts")}
          lang="en"
        >
          <a slot="action" href="/blog/" hreflang="ja"
            >{translate("en", "latest.blog.all")}{" "}
            <span aria-hidden="true">→</span></a
          >
        </PostRows>
      </div>
    </section>

    <section id="sponsor-notice">
      <h2>PR 表示</h2>
      <div class="stack">
        {sampleNotices.map((notice) => <SponsorNotice notice={notice} />)}
      </div>
    </section>

    <section id="post-nav">
      <h2>前後の記事</h2>
      <div class="stack">
        <PostNav prev={samplePrevPost} next={sampleNextPost} />
        <PostNav prev={samplePrevPost} next={undefined} />
        <PostNav prev={undefined} next={sampleNextPost} />
      </div>
    </section>

    <section id="plan-a-controls">
      <h2>A案のボタンとリンク</h2>
      <div class="row">
        <a class="btn btn-acc" href="#plan-a-controls">お問い合わせ</a>
        <a class="btn btn-acc is-hover" href="#plan-a-controls">お問い合わせ</a>
        <a class="btn btn-acc is-focus" href="#plan-a-controls">お問い合わせ</a>
      </div>
      <div class="row">
        <a class="btn btn-ink" href="#plan-a-controls">フォームをひらく →</a>
        <a class="btn btn-ink is-hover" href="#plan-a-controls"
          >フォームをひらく →</a
        >
        <a class="btn btn-ink is-focus" href="#plan-a-controls"
          >フォームをひらく →</a
        >
      </div>
      <div class="row">
        <a class="btn btn-ghost" href="#plan-a-controls">YouTubeチャンネルへ</a>
