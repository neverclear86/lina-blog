---
import { Image, Picture } from "astro:assets";
import type { ComponentProps } from "astro/types";
import { AVATAR_IMAGES, avatarAlt, THUMBS_UP_BAND } from "../avatar-images";
import ArticleBody from "../components/ArticleBody.astro";
import Bubble from "../components/Bubble.astro";
import Button from "../components/Button.astro";
import Chip from "../components/Chip.astro";
import FaceIcon from "../components/FaceIcon.astro";
import IconButton from "../components/IconButton.astro";
import IconLink from "../components/IconLink.astro";
import GitHubIcon from "../components/icons/GitHubIcon.astro";
import NostrIcon from "../components/icons/NostrIcon.astro";
import RssIcon from "../components/icons/RssIcon.astro";
import XIcon from "../components/icons/XIcon.astro";
import YouTubeIcon from "../components/icons/YouTubeIcon.astro";
import ZennIcon from "../components/icons/ZennIcon.astro";
import Kao from "../components/Kao.astro";
import LatestPosts from "../components/LatestPosts.astro";
import LatestVideoFeature from "../components/LatestVideoFeature.astro";
import LatestVideoList from "../components/LatestVideoList.astro";
import NameLogo from "../components/NameLogo.astro";
import PixelArt from "../components/PixelArt.astro";
import PostCard from "../components/PostCard.astro";
import PostList from "../components/PostList.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Tape from "../components/Tape.astro";
import TerminalCard from "../components/TerminalCard.astro";
import WorkTile from "../components/WorkTile.astro";
import { translate } from "../i18n/ui";
import Layout from "../layouts/Layout.astro";
import type { YouTubeVideo } from "../youtube-feed";

// Commands for the typing samples: 16 characters (the design) and 10.
const COMMANDS = ["$ npm run deploy", "$ git push"];

const samplePosts: ComponentProps<typeof LatestPosts>["posts"] = [
  {
    data: {
      title: "サイトをAstroで作り直した話",
      slug: "sample-post-devlog",
      date: new Date("2026-09-20"),
      tags: ["制作記"],
    },
  },
  {
    data: {
      title: "Cloudflare Workersで静的なページとAPIを同じWorkerから配信する",
      slug: "sample-post-tech-devlog",
      date: new Date("2026-09-12"),
      tags: ["技術", "制作記"],
    },
  },
  {
    data: {
      title: "配信の機材を少しずつ入れ替えた一週間",
      slug: "sample-post-diary",
      date: new Date("2026-09-05"),
      tags: ["日記"],
    },
  },
  {
    data: {
      title: "いちばん古い記事は出ない",
      slug: "sample-post-oldest",
      date: new Date("2026-08-01"),
      tags: ["技術"],
    },
  },
];

// Posts for the post list samples: a title that wraps to three lines or more at 390px, three
// tags, a sponsor, a ZWJ emoji and a flag. They are not in date order, to show that the list
// keeps the order it is given.
const sampleListPosts: ComponentProps<typeof PostList>["posts"] = [
  {
    data: {
      title: "サイトをAstroで作り直した話",
      slug: "sample-post-devlog",
      date: new Date("2026-09-20"),
      tags: ["制作記"],
      emoji: "🛠️",
    },
  },
  {
    data: {
      title:
        "Cloudflare Workersで静的なページとAPIを同じWorkerから配信し、お問い合わせのフォームまで1つにまとめた構成の記録",
      slug: "sample-post-long-title",
      date: new Date("2026-09-12"),
      tags: ["技術", "制作記", "日記"],
      emoji: "🧑‍💻",
    },
  },
  {
    data: {
      title: "配信の機材を少しずつ入れ替えた一週間",
      slug: "sample-post-diary",
      date: new Date("2026-08-20"),
      tags: ["日記"],
      emoji: "🇯🇵",
    },
  },
  {
    data: {
      title: "キーボードを提供していただいたので使ってみた",
      slug: "sample-post-sponsor",
      date: new Date("2026-08-28"),
      tags: ["技術"],
      emoji: "⌨️",
      sponsor: { name: "サンプル株式会社" },
    },
  },
  {
    data: {
      title: "短い題",
      slug: "sample-post-short",
      date: new Date("2026-08-01"),
      tags: ["技術"],
      emoji: "📝",
    },
  },
];

const sampleVideo = (
  id: string,
  title: string,
  publishedAt: string,
): YouTubeVideo => ({
  id,
  title,
  publishedAt: new Date(publishedAt),
  url: `https://www.youtube.com/watch?v=${id}`,
  thumbnail: {
    src: `https://i.ytimg.com/vi/${id}/hqdefault.jpg`,
    srcset: `https://i.ytimg.com/vi/${id}/mqdefault.jpg 320w, https://i.ytimg.com/vi/${id}/hqdefault.jpg 480w`,
  },
});

// Videos for the Latest samples. The IDs do not exist on i.ytimg.com, so the thumbnails do
// not load and the boxes stay in --ph.
const sampleVideos: YouTubeVideo[] = [
  sampleVideo(
    "AAAAAAAAAAA",
    "長いタイトルの見本。".repeat(10),
    "2026-09-27T15:30:00Z",
  ),
  sampleVideo(
    "BBBBBBBBBBB",
    "長いタイトルの見本。".repeat(10),
    "2026-09-20T10:00:00Z",
  ),
  sampleVideo("CCCCCCCCCCC", "短いタイトル", "2026-09-13T10:00:00Z"),
];
---

<Layout lang="ja">
  <script is:inline slot="head">
  const theme = new URLSearchParams(location.search).get("theme");
  if (theme === "light" || theme === "dark") {
    document.documentElement.dataset.theme = theme;
  }
  </script>
  <main class="page">
    <h1>部品の確認</h1>
    <p><a href="?theme=light">ライト</a> / <a href="?theme=dark">ダーク</a></p>

    <section id="a-window">
      <h2>A案: 窓・角の目盛り・背景の装飾</h2>
      <div class="a-samples">
        <div class="win a-sample"><code>div.win</code></div>
        <a class="win a-sample" href="#a-window"><code>a.win</code></a>
        <a class="win is-hover a-sample" href="#a-window"
          ><code>a.win.is-hover</code></a
        >
        <a class="win is-focus a-sample" href="#a-window"
          ><code>a.win.is-focus</code></a
        >
        <div class="ticks a-sample"><code>div.ticks</code></div>
        <div class="win acct a-sample">
          <a class="ticks-acc a-inner" href="#a-window"
            ><code>div.win.acct a.ticks-acc</code></a
          >
        </div>
        <div class="win acct is-hover a-sample">
          <div class="ticks-acc a-inner">
            <code>div.win.acct.is-hover</code>
          </div>
        </div>
        <div class="win acct is-focus a-sample">
          <div class="ticks-acc a-inner">
            <code>div.win.acct.is-focus</code>
          </div>
        </div>
        <div class="gridbg a-sample"><code>div.gridbg</code></div>
        <Image
          src={THUMBS_UP_BAND.src}
          alt=""
          width={240}
          class="av-shadow a-avatar"
        />
      </div>
      <div class="stripes"></div>
    </section>

    <section id="a-labels">
      <h2>A案: ラベル・タグ・カテゴリのチップ</h2>
      <div class="row">
        <span class="label">label</span>
        <span class="label">[YYYY.MM.DD] · youtube</span>
        <span class="label">最新動画のサムネイル</span>
      </div>
      <div class="row">
        <span class="tag">制作記</span>
        <span class="tag">astro</span>
        <span class="tag">cloudflare workers</span>
        <span class="chip-acc">制作記</span>
        <span class="chip-acc">NEW</span>
      </div>
      <div class="a-panel">
        <span class="label">label</span>
        <span class="tag">制作記</span>
        <span class="chip-acc">制作記</span>
      </div>
      <div class="a-narrow">
        <span class="tag">とても長いタグの名前がここに入る</span>
        <span class="chip-acc">とても長いカテゴリの名前がここに入る</span>
      </div>
    </section>

    <section id="a-headings">
      <h2>A案: セクションの見出し</h2>
      <div class="stack">
        <SectionTitle
          no="02"
          label="latest"
          path="~/latest"
          title="さいきんの配信"
        />
        <SectionTitle
          no="01"
          label="about"
          path="~/about"
          title={"はじめまして、\n創好リナです。"}
          size="md"
        />
        <SectionTitle no="03" label="blog" path="~/blog" title="さいきんの記事">
          <a slot="link" href="#a-headings"
            >記事一覧 <span aria-hidden="true">→</span></a
          >
        </SectionTitle>
        <SectionTitle no="04" label="works" as="h2">
          <a slot="link" href="#a-headings"
            >ls ~/works <span aria-hidden="true">→</span></a
          >
        </SectionTitle>
        <div lang="en">
          <SectionTitle
            no="05"
            label="a-section-with-a-very-long-english-name"
            path="~/long"
            title="Supercalifragilisticexpialidocious-heading-without-any-space"
            as="h3"
          >
            <a slot="link" href="#a-headings"
              >ls ~/works <span aria-hidden="true">→</span></a
            >
          </SectionTitle>
        </div>
        <SectionTitle no="06" label="focus" title="フォーカスの表示">
          <a slot="link" class="is-focus" href="#a-headings"
            >ls ~/focus <span aria-hidden="true">→</span></a
          >
        </SectionTitle>
      </div>
    </section>

    <section id="a-works">
      <h2>A案: 作品のタイル</h2>
      <div class="a-tiles">
        <WorkTile
          lang="ja"
          title="ikili.pro"
          description="創好リナの個人サイト兼ブログ。Astro と Cloudflare Workers で作っている。"
          tech={["astro", "typescript", "cloudflare"]}
          link={{ href: "#a-works", external: false }}
        />
        <WorkTile
          lang="ja"
          title="placeholder-work"
          description="外部のサイトへのリンクになる作品。名前の後ろに ↗ が付く。"
          tech={["typescript"]}
          link={{ href: "#a-works", external: true }}
        />
        <WorkTile
          lang="ja"
          class="is-hover"
          title="is-hover"
          description="ホバーのとき。枠が回った後の角度になる。"
          tech={["astro"]}
          link={{ href: "#a-works", external: false }}
        />
        <WorkTile
          lang="ja"
          class="is-focus"
          title="is-focus"
          description="キーボードのフォーカスのとき。枠が回った後の角度になり、輪が付く。"
          tech={["astro"]}
          link={{ href: "#a-works", external: false }}
        />
        <WorkTile
          lang="ja"
          title="a-work-with-a-very-long-name-that-has-no-break-in-it-at-all-1234567890"
          description="Averyveryverylongwordwithoutanybreakinthedescriptionthatmustwrapinsidethewindow"
          tech={[
  "a-technology-with-a-very-long-name-that-the-tag-cuts-with-an-ellipsis",
  "astro",
]}
        />
        <WorkTile
          lang="en"
          title="no-tags"
          description="A work without technologies, with a link to another site."
          tech={[]}
          link={{ href: "#a-works", external: true }}
        />
      </div>
    </section>

    <section id="shapes">
      <h2>形と影</h2>
      <div class="row">
        <div class="shadow">
          <div class="shapeS sample small chip">shapeS</div>
        </div>
        <div class="shadow"><div class="shape sample surf">shape</div></div>
        <div class="shadowInk">
          <div class="shape sample orange">shadowInk</div>
        </div>
        <div class="shadow wide">
          <div class="shapeL sample large surf">shapeL</div>
        </div>
      </div>
      <div class="cbg">
        <div class="row">
          <div class="shadowF wide">
            <div class="shapeL sample large paper">shadowF</div>
          </div>
        </div>
      </div>
    </section>

    <section id="focus">
      <h2>lift とフォーカス</h2>
      <div class="row">
        <a class="part" href="#focus"
          ><span class="shadow lift"
            ><span class="shape sample surf">通常</span></span
          ></a
        >
        <a class="part" href="#focus"
          ><span class="shadow lift is-lift"
            ><span class="shape sample surf">lift</span></span
          ></a
        >
        <a class="part is-focus" href="#focus"
          ><span class="shadow lift"
            ><span class="shape sample surf">フォーカス</span></span
          ></a
        >
        <a class="is-focus" href="#focus">本文のリンク</a>
      </div>
      <div class="cbg">
        <div class="row">
          <a class="part is-focus" href="#focus"
            ><span class="shadowInk lift"
              ><span class="shape sample orange">フォーカス</span></span
            ></a
          >
        </div>
      </div>
    </section>

    <section id="cards">
      <h2>ターミナル窓カード</h2>
      <div class="cards">
        <TerminalCard title="~/works/nostr-no-su" href="#cards">
          <p class="card-body">リンクのカード</p>
        </TerminalCard>
        <TerminalCard
          title="~/works/nostr-no-su"
          href="#cards"
          class="is-focus"
        >
          <p class="card-body">フォーカス</p>
        </TerminalCard>
        <TerminalCard title="lina --stream">
          <p class="card-body">リンクでないカード</p>
        </TerminalCard>
        <TerminalCard title="lina --stream" class="is-lift">
          <p class="card-body">lift</p>
        </TerminalCard>
        <TerminalCard
          title="~/works/a-very-long-project-name-for-the-ellipsis"
          shape="shapeL"
        >
          <p class="card-body">shapeL と長い題</p>
        </TerminalCard>
      </div>
      <div class="cbg">
        <TerminalCard
          title="new-message.txt"
          shape="shapeL"
          shadow="fshadow"
          tone="paper"
          lift={false}
        >
          <p class="card-body">
            <a class="is-focus" href="#cards">紙の面のフォーカス</a>
          </p>
        </TerminalCard>
      </div>
    </section>

    <section id="bubbles">
      <h2>吹き出し</h2>
      <div class="row">
        <Bubble>
          <span>今日もITで遊んでる〜</span>
          <span>⸜(*ˊᗜˋ*)⸝</span>
        </Bubble>
        <Bubble>
          <span
            >長い本文は吹き出しの幅に収まるように折り返す。長い本文は吹き出しの幅に収まるように折り返す。長い本文は吹き出しの幅に収まるように折り返す。</span
          >
        </Bubble>
      </div>
    </section>

    <section id="headings">
      <h2>セクション見出し</h2>
      <div class="stack">
        <SectionHeading
          label="~/about"
          title="ABOUT"
          subtitle="創好リナってこんな人"
        >
          <p class="heading-aside">
            名前の由来はLinux。配信もするし、開発もする、バーチャルイキリプログラマです。
          </p>
        </SectionHeading>
        <div class="cbg">
          <SectionHeading
            label="$ mail lina"
            title="CONTACT"
            subtitle="お問い合わせ"
            as="h3"
            variant="contact"
          />
        </div>
        <div lang="en">
          <SectionHeading
            label="~/works"
            title="WORKS"
            subtitle="Things I made"
            as="h3"
          >
            <a href="#headings">See all</a>
          </SectionHeading>
        </div>
      </div>
    </section>

    <section id="buttons">
      <h2>ボタン</h2>
      <div class="row">
        <Button href="#buttons">お問い合わせ</Button>
        <Button href="#buttons" class="is-hover">お問い合わせ</Button>
        <Button href="#buttons" class="is-focus">お問い合わせ</Button>
      </div>
      <div class="cbg">
        <div class="form">
          <div class="row">
            <Button size="lg" shadow="ink" type="submit">送信する</Button>
            <Button size="lg" shadow="ink" type="submit" class="is-hover"
              >送信する</Button
            >
            <Button size="lg" shadow="ink" type="submit" class="is-focus"
              >送信する</Button
            >
            <Button size="lg" shadow="ink" type="submit" disabled
              >送信する</Button
            >
          </div>
        </div>
      </div>
    </section>

    <section id="icons">
      <h2>アイコン</h2>
      <div class="row">
        <IconButton label="ライト・ダークを切り替え"
          ><svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg></IconButton
        >
        <IconButton label="ライト・ダークを切り替え" class="is-hover"
          ><svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg></IconButton
        >
        <IconButton label="ライト・ダークを切り替え" class="is-focus"
          ><svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg></IconButton
        >
        <IconButton label="メニューを開く" tone="inverse"
          ><svg
            aria-hidden="true"
            width="18"
            height="12"
            viewBox="0 0 18 12"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M0 1h18M0 6h18M0 11h10"></path>
          </svg></IconButton
        >
        <IconButton label="メニューを開く" tone="inverse" class="is-focus"
          ><svg
            aria-hidden="true"
            width="18"
            height="12"
            viewBox="0 0 18 12"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M0 1h18M0 6h18M0 11h10"></path>
          </svg></IconButton
        >
      </div>
      <div class="row">
        <IconLink href="#icons" label="YouTube"><YouTubeIcon /></IconLink>
        <IconLink
          href="#icons"
          label={translate("ja", "social.twitter")}
          rel="me"
          ><XIcon /></IconLink
        >
        <IconLink
          href="#icons"
          label={translate("ja", "social.twitter")}
          rel="me"
          class="is-hover"
          ><XIcon /></IconLink
        >
        <IconLink
          href="#icons"
          label={translate("ja", "social.twitter")}
          rel="me"
          class="is-focus"
          ><XIcon /></IconLink
        >
      </div>
      <div class="row">
        <IconLink href="#icons" label="YouTube"><YouTubeIcon /></IconLink>
        <IconLink href="#icons" label={translate("ja", "social.twitter")}
          ><XIcon /></IconLink
        >
        <IconLink href="#icons" label="GitHub"><GitHubIcon /></IconLink>
        <IconLink href="#icons" label="Nostr"><NostrIcon /></IconLink>
        <IconLink href="#icons" label="Zenn"><ZennIcon /></IconLink>
        <IconLink href="#icons" label="RSS"><RssIcon /></IconLink>
      </div>
      <div class="row">
        <div class="narrow">
          <IconLink href="#icons" label={translate("ja", "social.twitter")}
            ><XIcon /></IconLink
          >
        </div>
      </div>
    </section>

    <section id="face-icon">
      <h2>顔アイコン</h2>
      <div class="row">
        <FaceIcon kind="mark" size={27} alt="" />
        <FaceIcon kind="mark" size={28} alt="" />
        <FaceIcon kind="mark" size={44} alt="" />
        <FaceIcon kind="mark" size={45} alt="" />
        <FaceIcon kind="mark" size={96} alt="" />
      </div>
      <div class="row">
        <div class="inv-face">
          <FaceIcon kind="mark" size={28} alt="" tone="inverse" />
        </div>
        <div class="inv-face">
          <FaceIcon kind="mark" size={45} alt="" tone="inverse" />
        </div>
        <div class="inv-face">
          <FaceIcon kind="mark" size={96} alt="" tone="inverse" />
        </div>
      </div>
      <div class="row">
        <FaceIcon kind="avatar" size={24} alt="" />
        <FaceIcon kind="avatar" size={39} alt="" />
        <FaceIcon kind="avatar" size={40} alt="" />
        <FaceIcon kind="avatar" size={96} alt="創好リナ アイコン" />
      </div>
    </section>

    <section id="name-logo">
      <h2>ネームロゴ</h2>
      <div class="row">
        <figure class="logo-sample logo-82">
          <NameLogo variant="compact" label="/lina $_" />
          <figcaption>compact 82px（スマホのヘッダー）</figcaption>
        </figure>
        <figure class="logo-sample logo-92">
          <NameLogo variant="compact" label="/lina $_" />
          <figcaption>compact 92px（PC のヘッダー）</figcaption>
        </figure>
      </div>
      <div class="row">
        <figure class="logo-sample logo-296">
          <NameLogo variant="full" label="/tsukusu/lina $_" />
          <figcaption>full 296px（スラッシュ 32px）</figcaption>
        </figure>
        <figure class="logo-sample logo-420">
          <NameLogo variant="full" label="/tsukusu/lina $_" />
          <figcaption>full 420px（PC のフッター）</figcaption>
        </figure>
      </div>
      <div class="row">
        <figure class="logo-sample logo-576 blink-on">
          <NameLogo
            variant="full-sub"
            label="/tsukusu/lina $_ # 創好リナ ── VIRTUAL IKIRI PROGRAMMER"
          />
          <figcaption>
            full-sub 576px、カーソルは親の .blink-on で点滅
          </figcaption>
        </figure>
      </div>
    </section>

    <section id="chips">
      <h2>チップ</h2>
      <div class="row">
        <Chip tone="pink" tilt>バーチャルイキリプログラマ</Chip>
        <Chip tone="pink">NEW</Chip>
