---
import Breadcrumb from "../../components/Breadcrumb.astro";
import PageHead from "../../components/PageHead.astro";
import { tagCrumbs } from "../samples";
---

<section id="a-page-head" class="dev-section">
  <h2>A案: ページの頭とナビの切り替え</h2>
  <div class="dev-row">
    <a class="ws on" href="#a-page-head" aria-current="page">.ws.on</a>
    <a class="ws" href="#a-page-head">.ws</a>
    <a class="ws is-hover" href="#a-page-head">.ws.is-hover</a>
    <a class="ws is-focus" href="#a-page-head">.ws.is-focus</a>
  </div>
  <PageHead>
    <Breadcrumb lang="ja" items={tagCrumbs} />
    <h1>技術の記事</h1>
    <div class="dev-row">
      <a class="ws" href="#a-page-head">すべて</a>
      <a class="ws on" href="#a-page-head" aria-current="page">技術</a>
    </div>
  </PageHead>
</section>
