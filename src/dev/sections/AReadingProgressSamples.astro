---
import ReadingProgress from "../../components/ReadingProgress.astro";
---

<section id="a-reading-progress" class="dev-section">
  <h2>A案: 読み進み</h2>
  <div class="dev-stack">
    <div class="a-progress a-progress-0">
      <ReadingProgress variant="bar" />
    </div>
    <div class="a-progress a-progress-half">
      <ReadingProgress variant="bar" />
    </div>
    <div class="a-progress a-progress-full">
      <ReadingProgress variant="bar" />
    </div>
    <div class="a-progress a-progress-0">
      <ReadingProgress variant="line" />
    </div>
    <div class="a-progress a-progress-half">
      <ReadingProgress variant="line" />
    </div>
    <div class="a-progress a-progress-full">
      <ReadingProgress variant="line" />
    </div>
  </div>
</section>

<style>
.a-progress {
  max-width: 240px;
}

.a-progress-0 {
  --reading-progress: 0;
}

.a-progress-half {
  --reading-progress: 0.5;
}

.a-progress-full {
  --reading-progress: 1;
}
</style>
