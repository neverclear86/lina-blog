---
import ArticleBody from "../../components/ArticleBody.astro";
import GitHubIcon from "../../components/icons/GitHubIcon.astro";
import RssIcon from "../../components/icons/RssIcon.astro";
import XIcon from "../../components/icons/XIcon.astro";
import YouTubeIcon from "../../components/icons/YouTubeIcon.astro";
import { translate } from "../../i18n/ui";
---

<section id="plan-a-controls" class="dev-section">
  <h2>A案のボタンとリンク</h2>
  <div class="dev-row">
    <a class="btn btn-acc" href="#plan-a-controls">お問い合わせ</a>
    <a class="btn btn-acc is-hover" href="#plan-a-controls">お問い合わせ</a>
    <a class="btn btn-acc is-focus" href="#plan-a-controls">お問い合わせ</a>
  </div>
  <div class="dev-row">
    <a class="btn btn-ink" href="#plan-a-controls">フォームをひらく →</a>
    <a class="btn btn-ink is-hover" href="#plan-a-controls"
      >フォームをひらく →</a
    >
    <a class="btn btn-ink is-focus" href="#plan-a-controls"
      >フォームをひらく →</a
    >
  </div>
  <div class="dev-row">
    <a class="btn btn-ghost" href="#plan-a-controls">YouTubeチャンネルへ</a>
    <a class="btn btn-ghost is-hover" href="#plan-a-controls"
      >YouTubeチャンネルへ</a
    >
    <a class="btn btn-ghost is-focus" href="#plan-a-controls"
      >YouTubeチャンネルへ</a
    >
  </div>
  <div class="dev-row">
    <a class="btn btn-acc narrow-btn" href="#plan-a-controls"
      >長い文言のボタンは幅の中で折り返し、横にはみ出さない</a
    >
  </div>
  <div class="dev-row">
    <a class="sq" href="#plan-a-controls" aria-label="YouTube"
      ><YouTubeIcon /></a
    >
    <a
      class="sq"
      href="#plan-a-controls"
      aria-label={translate("ja", "social.twitter")}
      rel="me"
      ><XIcon /></a
    >
    <a class="sq is-hover" href="#plan-a-controls" aria-label="GitHub"
      ><GitHubIcon /></a
    >
    <a class="sq is-focus" href="#plan-a-controls" aria-label="RSS"
      ><RssIcon /></a
    >
  </div>
  <div class="dev-row">
    <button class="iconbtn" type="button" aria-label="ライトとダークを切り替え">
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        ></path>
      </svg>
    </button>
    <button
      class="iconbtn is-hover"
      type="button"
      aria-label="ライトとダークを切り替え"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        ></path>
      </svg>
    </button>
    <button
      class="iconbtn iconbtn-acc"
      type="button"
      aria-label="メニューを開く"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="square"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h10"></path>
      </svg>
    </button>
    <button
      class="iconbtn iconbtn-acc is-focus"
      type="button"
      aria-label="メニューを開く"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="square"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h10"></path>
      </svg>
    </button>
  </div>
  <div class="dev-row">
    <a href="#plan-a-controls">本文のリンク</a>
    <a class="is-hover" href="#plan-a-controls">ホバーのリンク</a>
    <a class="is-focus" href="#plan-a-controls">フォーカスのリンク</a>
  </div>
  <div class="dev-row">
    <a class="a-link-card is-hover" href="#plan-a-controls">
      <span class="label">.link-title</span>
      <strong class="link-title">ホバーのカードのタイトル</strong>
    </a>
    <a class="a-link-card is-focus" href="#plan-a-controls">
      <span class="label">.link-title</span>
      <strong class="link-title">フォーカスのカードのタイトル</strong>
    </a>
  </div>
  <div class="dev-row">
    <ArticleBody lang="ja"
      ><p>
        記事の本文の中の<a href="#plan-a-controls">リンク</a
        >は、色だけでなく下線でも区別する。
      </p></ArticleBody
    >
  </div>
  <div class="dev-row">
    <div class="on-keyword">
      <a class="btn on-keyword-btn is-focus" href="#plan-a-controls"
        >オレンジの地の中のボタン</a
      >
    </div>
  </div>
</section>

<style>
.a-link-card {
  display: flex;
  flex-direction: column;
  gap: 6px;
  max-width: 240px;
  text-decoration: none;
}

.narrow-btn {
  max-width: 200px;
}

.sq :global(svg) {
  width: 18px;
  height: 18px;
}

.on-keyword {
  padding: 24px;
  background: var(--keyword);
  color: var(--ink);
  --focus-ring: var(--ink);
}

.on-keyword-btn {
  background: var(--ink);
  color: var(--ivory);
}
</style>
