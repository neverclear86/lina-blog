---
import { Picture } from "astro:assets";
import { AVATAR_IMAGES, avatarAlt } from "../../avatar-images";
---

<section id="avatar" class="dev-section">
  <h2>アバター（v2.1）</h2>
  <div class="dev-row">
    {AVATAR_IMAGES.map((avatar) => (
  <figure class="avatar-sample" data-name={avatar.name}>
    <Picture
      src={avatar.src}
      alt={avatarAlt(avatar, "ja")}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={avatar.widths}
      sizes={avatar.sizes}
      priority={avatar.priority}
      class="avatar-img"
    />
    <figcaption class="avatar-caption">
      {avatar.name}
      <br />
      alt: {avatarAlt(avatar, "ja") || "（空）"}
    </figcaption>
  </figure>
))}
  </div>
</section>

<style>
.avatar-sample {
  margin: 0;
}

.avatar-img {
  display: block;
  width: auto;
  height: 400px;
}

.avatar-sample[data-name^="threeview"] .avatar-img {
  height: 520px;
}

.avatar-sample[data-name="lgtm-bastup"] .avatar-img {
  width: 340px;
  height: auto;
}

.avatar-sample[data-name="hate"] .avatar-img {
  width: 72px;
  height: 96px;
}

.avatar-caption {
  margin-top: 8px;
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--muted);
}
</style>
