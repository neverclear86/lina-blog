---
import SkipLink from "../../components/SkipLink.astro";
---

<section id="skip-link" class="dev-section">
  <h2>スキップリンク</h2>
  <p>最初の Tab で出る先頭のリンクの見本（<code>is-focus</code>）。</p>
  <div class="skip-samples">
    <div class="skip-sample"><SkipLink lang="ja" class="is-focus" /></div>
    <div class="skip-sample"><SkipLink lang="en" class="is-focus" /></div>
  </div>
</section>

<style>
/*
 * A `transform` makes the box the containing block of the skip link, which is fixed to the
 * viewport, so each sample shows its position (8px from the top, 16px from the left).
 */
.skip-sample {
  position: relative;
  height: 62px;
  max-width: 320px;
  transform: translate(0);
  border: 1px dashed var(--line2);
}

/* The block of the samples. */
.skip-samples {
  display: grid;
  gap: 16px;
}
</style>
