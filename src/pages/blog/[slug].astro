---
/**
 * The page of a blog post, `/blog/<slug>/`, in Japanese only. The head is `ArticleHead`: the
 * breadcrumb `~ / blog / <year> / <slug>.md`, the category chips (`tags`), the topic tags
 * (`topics`, none when the post has no topics), the `h1`, and the date, the reading time and the
 * author. Below it, `<Content />` in `ArticleBody` fills a column of at most 760px. From 1024px a
 * column of 240px, `.toc-col`, stands at its left. A post with `sponsor` has its PR notice
 * (`SponsorNotice`) between the head and the columns. `emoji` is not shown. At the end of the body
 * column, after `ArticleEnd`, `PostNav` holds the links to the posts one step older (`prev`) and
 * one step newer (`next`), which `getStaticPaths` gives as props.
 *
 * From 1024px `.toc-col` holds the table of contents of the `h2` headings of the post in a window
 * (`ArticleToc`) that sticks 88px below the top of the viewport; below 1024px the same items are
 * in a closed `<details>` before the body. The hidden `h2` of the footnotes is not an item. A post
 * without an `h2` of its own has no table of contents, and `.toc-col` stays empty so that the
 * body keeps its place.
 *
 * The script of the page (`article-reading`) sets `--reading-progress` on `<html>` while the
 * reader scrolls (0 until the top of `.article-body` reaches the bottom of the site header, 1 when
 * its bottom reaches the middle of the viewport, or at the bottom of the page when it cannot or
 * when it passes the middle before its top reaches the header), which the line under the site
 * header (`readingProgress` of `Layout`) and the bar under the window of the table of contents
 * (`ReadingProgress`) draw, and marks the item of the `h2` that the reader is in with
 * `aria-current="location"`. The line and the bar are hidden until it runs.
 *
 * A post that is on Nostr has the link `nostr ↗` to its article on njump (`nostrArticleUrl`) in
 * the head. The page has the compact footer.
 *
 * After the body, in the same column and before `PostNav`, `ArticleEnd` is the window of the end of
 * the post, with the buttons that share the post's address on Twitter (self-proclaimed X) and
 * Nostr and copy it.
 */
import { type CollectionEntry, getCollection, render } from "astro:content";
import { nostrPublishedSlugs } from "virtual:lina-published-slugs";
import type { GetStaticPaths } from "astro";
import { blogPostUrl } from "../../article-share";
import { blogPostPaths, blogPostToc, readingMinutes } from "../../blog-pages";
import ArticleBody from "../../components/ArticleBody.astro";
import ArticleEnd from "../../components/ArticleEnd.astro";
import ArticleHead from "../../components/ArticleHead.astro";
import ArticleToc from "../../components/ArticleToc.astro";
import PostNav from "../../components/PostNav.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import SponsorNotice from "../../components/SponsorNotice.astro";
import Layout from "../../layouts/Layout.astro";
import { nostrArticleUrl } from "../../nostr-address";
import { postOgImagePath } from "../../og-pages";
import { NOSTR_NPUB } from "../../profile-links";
import { isNostrPublished } from "../../published-articles";
import { sponsorNotice } from "../../sponsor-notice";

export const getStaticPaths = (async () =>
  blogPostPaths(await getCollection("blog"))) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<"blog">;
  prev: CollectionEntry<"blog"> | undefined;
  next: CollectionEntry<"blog"> | undefined;
}

const { post, prev, next } = Astro.props;
const { title, slug, date, tags, topics, sponsor, description } = post.data;
const { Content, headings } = await render(post);
const toc = blogPostToc(headings);
const { site } = Astro;
if (!site) {
  throw new Error(
    "`site` in astro.config.mjs is required to build the pages of posts.",
  );
}
const url = blogPostUrl(slug, site);
const minutes = readingMinutes(post.body);
const notice = sponsorNotice(sponsor);
const nostrUrl = isNostrPublished(slug, nostrPublishedSlugs)
  ? nostrArticleUrl({ npub: NOSTR_NPUB, slug })
  : undefined;
---

<Layout
  lang="ja"
  title={title}
  description={description}
  image={postOgImagePath(slug)}
  footer="compact"
  readingProgress
>
  <main id="main" tabindex="-1">
    <ArticleHead
      title={title}
      slug={slug}
      date={date}
      tags={tags}
      topics={topics}
      minutes={minutes}
      nostrUrl={nostrUrl}
      site={site}
    />
    <div class="body">
      {notice && (
  <div class="sponsor">
    <SponsorNotice notice={notice} />
  </div>
)}
      <div class="cols">
        <div class="toc-col">
          {toc.length > 0 && (
  <aside class="toc-side">
    <ArticleToc items={toc} lang="ja" variant="window" />
    <ReadingProgress variant="bar" hidden />
  </aside>
)}
        </div>
        <div class="text">
          {toc.length > 0 && (
  <div class="toc-sheet">
    <ArticleToc items={toc} lang="ja" variant="sheet" />
  </div>
)}
          <ArticleBody lang="ja"><Content /></ArticleBody>
          <ArticleEnd title={title} url={url} />
          <PostNav prev={prev} next={next} />
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
.body {
  box-sizing: border-box;
  max-width: 1440px;
  margin: 0 auto;
  padding: 24px 16px 40px;
}
.sponsor {
  max-width: 900px;
  margin-bottom: 24px;
}
.toc-col {
  display: none;
}
.toc-sheet {
  margin-bottom: 24px;
}
.text {
  min-width: 0;
  max-width: 760px;
}

@media (min-width: 768px) {
  .body {
    padding: 56px 20px 96px;
  }
  .sponsor {
    margin-bottom: 48px;
  }
}

@media (min-width: 900px) {
  .body {
    padding: 56px 64px 96px;
  }
}

@media (min-width: 1024px) {
  .toc-col {
    display: block;
    flex: 0 0 240px;
    align-self: stretch;
  }
  .toc-side {
    position: sticky;
    top: 88px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .toc-sheet {
    display: none;
  }
  .cols {
    display: flex;
    gap: 48px;
    align-items: flex-start;
  }
  .text {
    flex: 1 1 0;
  }
}
</style>

<script>
import "../../components/article-reading";
</script>
