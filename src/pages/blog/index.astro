---
import { getCollection } from "astro:content";
import BlogIndex from "../../components/blog/BlogIndex.astro";
import { translate } from "../../i18n/ui";
import Layout from "../../layouts/Layout.astro";
import { blogListText } from "../../lib/blog/blog-pages";
import { postsNewestFirst } from "../../lib/blog/latest-posts";

const posts = await getCollection("blog");
const title = translate("ja", blogListText(undefined).title);
---

<Layout lang="ja" title={title}>
  <BlogIndex posts={postsNewestFirst(posts)} />
</Layout>
