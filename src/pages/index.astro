---
import AboutFullBody from "../components/AboutFullBody.astro";
import HeroStanding from "../components/HeroStanding.astro";
import Logo from "../components/Logo.astro";
import PixelArt from "../components/PixelArt.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <h1><Logo size={36} alt="" />ikili.pro</h1>
    <p>準備中です。</p>
    <PixelArt />
    <div class="preview-standing"><HeroStanding /></div>
    <div class="preview-full-body"><AboutFullBody /></div>
  </main>
</Layout>

<style>
/* 画像の部品をビルドで描画させる仮の配置。Hero と About のセクションができたら消す。 */
.preview-standing {
  width: 259px;
}

@media (min-width: 768px) {
  .preview-standing {
    width: 466px;
  }
}

.preview-full-body {
  width: 151px;
}

main {
  color-scheme: light dark;
  background: Canvas;
  color: CanvasText;
}
:global(:root[data-theme="light"]) main {
  color-scheme: light;
}
:global(:root[data-theme="dark"]) main {
  color-scheme: dark;
}
</style>
