---
import { Picture } from "astro:assets";
import { type CollectionEntry, getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import Chip from "../../../components/Chip.astro";
import Logo from "../../../components/Logo.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import TerminalCard from "../../../components/TerminalCard.astro";
import type { Locale } from "../../../i18n/locales";
import { translate } from "../../../i18n/ui";
import Layout from "../../../layouts/Layout.astro";
import { workLinkRows, workPagePaths } from "../../../work-pages";

export const getStaticPaths = (async () =>
  workPagePaths(await getCollection("works"))) satisfies GetStaticPaths;

interface Props {
  lang: Locale;
  work: CollectionEntry<"works">;
}

const { lang, work } = Astro.props;
const { title, description, tech, thumbnail, links } = work.data;

if (!Astro.site) {
  throw new Error(
    "`site` in astro.config.mjs is required to build the pages of works.",
  );
}

const rows = workLinkRows(links, lang, Astro.site);
const cardTitle = `~/works/${title}`;
---

<Layout lang={lang} title={title} description={description[lang]}>
  <main class="work">
    <a class="back" href={`/${lang}/#works`}
      ><span aria-hidden="true">←</span> {translate(lang, "works.back")}</a
    >
    <SectionHeading
      as="h1"
      label={cardTitle}
      title={title}
      subtitle={translate(lang, "works.pageSubtitle")}
    />
    <div class:list={["top", { single: !thumbnail }]}>
      {thumbnail && (
  <div class="visual">
    <TerminalCard title={cardTitle} lift={false}>
      {thumbnail === "logo" ? (
        <div class="thumb logo-face">
          <Logo size={120} alt="" tone="inverse" />
        </div>
      ) : (
        <div class="thumb photo">
          <Picture
            src={thumbnail}
            alt=""
            formats={["avif", "webp"]}
            widths={[400, 800, 1200, 1600]}
            sizes="(min-width: 1024px) 60vw, 100vw"
          />
        </div>
      )}
    </TerminalCard>
  </div>
)}
      <div class="info">
        <p class="description">{description[lang]}</p>
        {tech.length > 0 && (
  <ul class="tech" aria-label={translate(lang, "works.tech")}>
    {tech.map((name) => (
      <li>
        <Chip>{name}</Chip>
      </li>
    ))}
  </ul>
)}
        {rows.length > 0 && (
  <section class="links">
    <h2>{translate(lang, "works.links")}</h2>
    <ul>
      {rows.map((row) => (
        <li>
          <a href={row.href}>
            <span class="kind">{row.kind}</span>
            <span class="text">
              {row.text}
              {row.external && <span aria-hidden="true"> ↗</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
      </div>
    </div>
  </main>
</Layout>

<style>
.work {
  display: flex;
  flex-direction: column;
  padding: 56px 18px;
}

@media (min-width: 768px) {
  .work {
    padding: 72px 40px;
  }
}

@media (min-width: 1024px) {
  .work {
    padding: 88px 64px;
  }
}

.back {
  align-self: flex-start;
  margin-bottom: 24px;
  font-size: 15px;
  font-weight: 900;
  color: inherit;
}

.back:hover {
  opacity: 0.8;
}

.top {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  align-items: start;
  gap: 32px;
  margin-top: 32px;
}

@media (min-width: 768px) {
  .top {
    gap: 40px;
    margin-top: 40px;
  }
}

@media (min-width: 1024px) {
  .top {
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 56px;
    margin-top: 44px;
  }

  .top.single {
    grid-template-columns: minmax(0, 720px);
  }
}

.visual {
  min-width: 0;
}

.thumb {
  display: flex;
  aspect-ratio: 16 / 9;
}

.photo :global(picture) {
  display: contents;
}

.photo :global(img) {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.logo-face {
  align-items: center;
  justify-content: center;
  background: var(--inv);
}

@media (max-width: 767px) {
  .logo-face :global(img) {
    width: 80px;
    height: 80px;
  }
}

.info {
  display: flex;
  flex-direction: column;
  gap: 28px;
  min-width: 0;
}

.single .info {
  max-width: 720px;
}

.description {
  margin: 0;
  font-size: 17px;
  font-weight: 500;
  line-height: 1.85;
  color: var(--fg);
}

.tech {
  margin: 0;
  padding: 0;
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.links h2 {
  margin: 0;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--legacy-line);
  font-size: 16px;
  font-weight: 900;
}

.links ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.links a {
  display: flex;
  align-items: baseline;
  gap: 16px;
  padding: 14px 0;
  border-bottom: 1px solid var(--hair);
  color: inherit;
  text-decoration: none;
}

.links a:hover {
  opacity: 0.8;
}

.kind {
  flex: 0 0 96px;
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--muted);
}

.text {
  min-width: 0;
  font-size: 16px;
  font-weight: 900;
  overflow-wrap: anywhere;
}
</style>
