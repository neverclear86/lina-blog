---
import { Picture } from "astro:assets";
import { type CollectionEntry, getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import FaceIcon from "../../../components/FaceIcon.astro";
import { homeSectionPath } from "../../../components/site-nav";
import type { Locale } from "../../../i18n/locales";
import { translate } from "../../../i18n/ui";
import Layout from "../../../layouts/Layout.astro";
import { workLinkRows, workPagePaths } from "../../../work-pages";

export const getStaticPaths = (async () =>
  workPagePaths(await getCollection("works"))) satisfies GetStaticPaths;

interface Props {
  lang: Locale;
  work: CollectionEntry<"works">;
}

const { lang, work } = Astro.props;
const { title, description, tech, thumbnail, links } = work.data;

if (!Astro.site) {
  throw new Error(
    "`site` in astro.config.mjs is required to build the pages of works.",
  );
}

const rows = workLinkRows(links, lang, Astro.site);
const metaRows = rows.filter(
  (row) => row.kind === "demo" || row.kind === "repo",
);
const relatedRows = rows.filter(
  (row) => row.kind === "video" || row.kind === "blog",
);
---

<Layout lang={lang} title={title} description={description[lang]}>
  <main>
    <section class="head gridbg">
      <div class="deco" aria-hidden="true">
        <div class="hatch"></div>
        <div class="band"></div>
      </div>
      <div class="head-inner">
        <nav aria-label={translate(lang, "works.breadcrumb")}>
          <ol class="crumbs">
            <li>
              <a href={`/${lang}/`}>~</a>
              <span aria-hidden="true">/</span>
            </li>
            <li>
              <a href={homeSectionPath(lang, "works")}>works</a>
              <span aria-hidden="true">/</span>
            </li>
            <li>
              <span class="slug" aria-current="page">{work.data.slug}</span>
            </li>
          </ol>
        </nav>
        {tech.length > 0 && (
  <ul class="tech" aria-label={translate(lang, "works.tech")}>
    {tech.map((name) => (
      <li>
        <span class="tag">{name}</span>
      </li>
    ))}
  </ul>
)}
        <h1>{title}</h1>
        {metaRows.length > 0 && (
  <dl class="meta">
    {metaRows.map((row) => (
      <div class="cell">
        <dt class="label">{row.kind}</dt>
        <dd>
          <a href={row.href}>
            {row.text}
            {row.external && (
              <>
                <span aria-hidden="true"> ↗</span>
                <span class="sr-only">
                  {" "}
                  {translate(lang, "works.external")}
                </span>
              </>
            )}
          </a>
        </dd>
      </div>
    ))}
  </dl>
)}
      </div>
    </section>
    <div class="body">
      {thumbnail === "logo" && (
  <div class="thumb win gridbg logo">
    <FaceIcon kind="mark" size={120} alt="" />
  </div>
)}
      {thumbnail !== undefined && thumbnail !== "logo" && (
  <div class="thumb win photo">
    <Picture
      src={thumbnail}
      alt=""
      formats={["avif", "webp"]}
      widths={[400, 800, 1200, 1600]}
      sizes="(min-width: 1028px) 900px, (min-width: 900px) calc(100vw - 128px), (min-width: 768px) calc(100vw - 40px), calc(100vw - 32px)"
    />
  </div>
)}
      <p class="description">{description[lang]}</p>
      {relatedRows.length > 0 && (
  <section class="related" aria-labelledby="related-heading">
    <h2 class="label" id="related-heading">
      {translate(lang, "works.related")}
    </h2>
    <ul class="tiles">
      {relatedRows.map((row) => (
        <li>
          <a class="tile win" href={row.href}>
            <span class="label">{row.kind}</span>
            <strong>
              {row.text}
              {row.external && (
                <>
                  <span aria-hidden="true"> ↗</span>
                  <span class="sr-only">
                    {" "}
                    {translate(lang, "works.external")}
                  </span>
                </>
              )}
            </strong>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
    </div>
  </main>
</Layout>

<style>
.head {
  position: relative;
  overflow: hidden;
  border-bottom: 1px solid var(--line);
  background-size: 32px 32px;
}

.deco {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.hatch {
  display: none;
}

.band {
  position: absolute;
  top: -40%;
  right: -40px;
  width: 64px;
  height: 200%;
  background: var(--keyword);
  transform: rotate(22deg);
}

.head-inner {
  position: relative;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 14px;
  max-width: 1440px;
  margin: 0 auto;
  padding: 28px 16px 24px;
}

.crumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin: 0;
  padding: 0;
  list-style: none;
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--muted);
}

.crumbs li {
  display: flex;
  align-items: center;
  gap: 4px;
}

.crumbs a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 24px;
  min-height: 24px;
}

.slug {
  color: var(--text);
  overflow-wrap: anywhere;
}

.tech {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 0;
  padding: 0;
  list-style: none;
}

h1 {
  max-width: 900px;
  margin: 0;
  padding-right: 40px;
  font-size: 28px;
  font-weight: 900;
  line-height: 1.4;
  overflow-wrap: anywhere;
  text-wrap: balance;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin: 0;
  padding-right: 56px;
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--muted);
}

.cell {
  display: flex;
  gap: 6px;
  min-width: 0;
}

.meta dd {
  min-width: 0;
  margin: 0;
  overflow-wrap: anywhere;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

@media (min-width: 768px) {
  .head {
    background-size: 48px 48px;
  }

  .deco {
    display: none;
  }

  .head-inner {
    gap: 22px;
    padding: 64px 20px 48px;
  }

  .crumbs {
    font-size: 13px;
  }

  .tech {
    gap: 8px;
  }

  h1 {
    padding-right: 0;
    font-size: 32px;
    line-height: 1.3;
  }

  .meta {
    gap: 0;
    max-width: 900px;
    padding-right: 0;
    font-size: 14px;
    color: var(--text);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--shade);
  }

  .cell {
    flex-direction: column;
    gap: 4px;
    padding: 12px 20px;
    border-right: 1px solid var(--line);
  }

  .cell:first-child {
    padding-left: 0;
  }

  .cell:last-child {
    border-right: 0;
  }
}

@media (min-width: 900px) {
  .head-inner {
    padding: 64px 64px 48px;
  }

  h1 {
    font-size: 52px;
  }
}

@media (min-width: 1280px) {
  .deco {
    display: block;
  }

  .hatch {
    position: absolute;
    top: -60%;
    right: calc(6% + 150px);
    display: block;
    width: 28px;
    height: 220%;
    opacity: 0.7;
    transform: rotate(22deg);
    background: repeating-linear-gradient(
      to bottom,
      var(--keyword) 0 5px,
      transparent 5px 15px
    );
  }

  .band {
    top: -60%;
    right: 6%;
    width: 120px;
    height: 220%;
  }
}

.body {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 28px;
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
  padding: 24px 16px 40px;
}

.body > * {
  min-width: 0;
  max-width: 900px;
  margin: 0;
}

.thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 16 / 9;
  overflow: hidden;
}

.photo :global(picture) {
  display: contents;
}

.photo :global(img) {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

@media (max-width: 767px) {
  .logo :global(img) {
    width: 80px;
    height: 80px;
  }
}

.body > .description {
  max-width: 760px;
  font-size: 17px;
  font-weight: 500;
  line-height: 1.9;
  color: var(--text);
}

.related {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.related h2 {
  margin: 0;
  font-weight: 400;
}

.tiles {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
  gap: 12px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.tiles li {
  display: flex;
  min-width: 0;
}

.tile {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 6px;
  width: 100%;
  padding: 18px 20px;
  text-decoration: none;
}

.tile strong {
  font-size: 15px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.tile:hover strong,
.tile:focus-visible strong {
  text-decoration: underline 2px var(--keyword);
  text-underline-offset: 4px;
}

:root[data-theme="dark"] .tile:hover strong,
:root[data-theme="dark"] .tile:focus-visible strong {
  text-decoration: none;
}

@media (min-width: 768px) {
  .body {
    gap: 40px;
    padding: 56px 20px 96px;
  }

  .body > .description {
    font-size: 19px;
    line-height: 2;
  }
}

@media (min-width: 900px) {
  .body {
    padding-inline: 64px;
  }
}
</style>
