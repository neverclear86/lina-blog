---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import About from "../../components/About.astro";
import HeroStanding from "../../components/HeroStanding.astro";
import LatestPosts from "../../components/LatestPosts.astro";
import LatestSection from "../../components/LatestSection.astro";
import Logo from "../../components/Logo.astro";
import { LOCALES, type Locale } from "../../i18n/locales";
import { translate } from "../../i18n/ui";
import Layout from "../../layouts/Layout.astro";

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({
    params: { lang },
    props: { lang },
  }))) satisfies GetStaticPaths;

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const posts = await getCollection("blog");
---

<Layout lang={lang}>
  <main>
    <h1><Logo size={36} alt="" />ikili.pro</h1>
    <p>{translate(lang, "home.comingSoon")}</p>
    <div class="preview-standing"><HeroStanding /></div>
    <About lang={lang} />
    <LatestSection lang={lang}>
      <LatestPosts slot="blog" lang={lang} posts={posts} />
    </LatestSection>
  </main>
</Layout>

<style>
/* HeroStanding をビルドで描画させる仮の配置。Hero のセクションができたら消す。 */
.preview-standing {
  width: 259px;
}

@media (min-width: 768px) {
  .preview-standing {
    width: 466px;
  }
}
</style>
