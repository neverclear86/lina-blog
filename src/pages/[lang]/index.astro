---
import type { GetStaticPaths } from "astro";
import AboutFullBody from "../../components/AboutFullBody.astro";
import HeroStanding from "../../components/HeroStanding.astro";
import Logo from "../../components/Logo.astro";
import PixelArt from "../../components/PixelArt.astro";
import { LOCALES, type Locale } from "../../i18n/locales";
import { translate } from "../../i18n/ui";
import Layout from "../../layouts/Layout.astro";

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({
    params: { lang },
    props: { lang },
  }))) satisfies GetStaticPaths;

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<Layout lang={lang}>
  <main>
    <h1><Logo size={36} alt="" />ikili.pro</h1>
    <p>{translate(lang, "home.comingSoon")}</p>
    <PixelArt />
    <div class="preview-standing"><HeroStanding /></div>
    <div class="preview-full-body"><AboutFullBody /></div>
  </main>
</Layout>

<style>
/* 画像の部品をビルドで描画させる仮の配置。Hero と About のセクションができたら消す。 */
.preview-standing {
  width: 259px;
}

@media (min-width: 768px) {
  .preview-standing {
    width: 466px;
  }
}

.preview-full-body {
  width: 151px;
}
</style>
