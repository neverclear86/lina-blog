---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import About from "../../components/home/About.astro";
import ContactBand from "../../components/home/ContactBand.astro";
import Hero from "../../components/home/Hero.astro";
import LatestPosts from "../../components/home/LatestPosts.astro";
import LatestSection from "../../components/home/LatestSection.astro";
import LatestVideoFeature from "../../components/home/LatestVideoFeature.astro";
import LatestVideoList from "../../components/home/LatestVideoList.astro";
import { LOCALES, type Locale } from "../../i18n/locales";
import { LATEST_VIDEOS_SHOWN, latestVideos } from "../../latest-videos";
import Layout from "../../layouts/Layout.astro";
import { topOgImagePath } from "../../og-pages";
import { fetchLatestVideos } from "../../youtube-feed";

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({
    params: { lang },
    props: { lang },
  }))) satisfies GetStaticPaths;

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const posts = await getCollection("blog");

const result = await fetchLatestVideos({ limit: LATEST_VIDEOS_SHOWN });
if (!result.ok) {
  console.warn(`Latest videos: the YouTube feed failed (${result.reason}).`);
}
const { feature, list } = latestVideos(result);
---

<Layout lang={lang} image={topOgImagePath(lang)}>
  <main id="main" tabindex="-1">
    <Hero lang={lang} />
    <About lang={lang} />
    <LatestSection lang={lang}>
      <LatestVideoFeature slot="video-feature" lang={lang} video={feature} />
      <LatestVideoList slot="video-list" lang={lang} videos={list} />
      <LatestPosts slot="blog" lang={lang} posts={posts} />
    </LatestSection>
    <ContactBand lang={lang} />
  </main>
</Layout>
