---
/**
 * The contact page, `/ja/contact/` and `/en/contact/`: a head after the article pages of plan A
 * (the breadcrumb, `$ mail lina`, the heading, the lead and a line about a DM on Twitter
 * (self-proclaimed X) in `PageHead`) and the contact form in a window. The DM line has the size
 * of the lead, and its link opens in a new tab, says so to assistive technology with
 * `ExternalNote` and is underlined in every state.
 */
import type { GetStaticPaths } from "astro";
import ContactForm from "../../../components/contact/ContactForm.astro";
import Breadcrumb from "../../../components/site/Breadcrumb.astro";
import ExternalNote from "../../../components/site/ExternalNote.astro";
import { labelSegments } from "../../../components/site/label-break";
import PageHead from "../../../components/site/PageHead.astro";
import { LOCALES, type Locale } from "../../../i18n/locales";
import { useTranslations } from "../../../i18n/ui";
import Layout from "../../../layouts/Layout.astro";
import { externalLinkAttrs, requireSite } from "../../../lib/external-link";
import { profileLink } from "../../../lib/profile-links";

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({
    params: { lang },
    props: { lang },
  }))) satisfies GetStaticPaths;

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const site = requireSite(Astro.site);
const twitter = profileLink("twitter");
const twitterLabel = labelSegments(twitter.label[lang]);
const crumbs = [
  { text: "~", href: `/${lang}/`, label: t("nav.top") },
  { text: "contact" },
];
---

<Layout
  lang={lang}
  title={t("contact.title")}
  description={t("contact.description")}
>
  <main id="main" tabindex="-1">
    <PageHead>
      <Breadcrumb lang={lang} items={crumbs} />
      <p class="prompt">$ mail lina</p>
      <h1>{t("contact.title")}</h1>
      <p class="lead">{t("contact.lead")}</p>
      <p class="dm">
        {t("contact.dm.before")}<a
          href={twitter.url}
          {...externalLinkAttrs(twitter.url, site)}
          >{twitterLabel.map((segment, index) => (
  <>
    {index > 0 && <wbr />}
    <span class="segment">{segment}</span>
  </>
))}<ExternalNote lang={lang} /></a
        >{t("contact.dm.after")}
      </p>
    </PageHead>
    <div class="content page-width"><ContactForm lang={lang} /></div>
  </main>
</Layout>

<style>
.prompt {
  margin: 0;
  font-family: var(--font-mono);
  font-size: 14px;
  font-weight: 700;
  color: var(--acc-text);
}

.lead,
.dm {
  margin: 0;
  max-width: 560px;
  padding-right: 48px;
  font-size: 16px;
  font-weight: 500;
  line-height: 1.9;
}

.dm a {
  text-decoration-line: underline;
  text-underline-offset: 4px;
}

.segment {
  white-space: nowrap;
}

.content {
  padding-block: 28px 56px;
}

@media (min-width: 600px) {
  .content {
    padding-block: 40px 72px;
  }
}

@media (min-width: 900px) {
  .lead,
  .dm {
    padding-right: 0;
  }

  .content {
    padding-block: 56px 96px;
  }
}
</style>
