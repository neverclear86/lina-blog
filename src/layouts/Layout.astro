---
import { Font, getImage } from "astro:assets";
import logo from "../assets/logo-light.png";
import { FEED_PATH, FEED_TITLE } from "../blog-rss";
import { DEFAULT_LOCALE, LOCALES, type Locale } from "../i18n/locales";
import { localizedPath } from "../i18n/paths";
import { translate } from "../i18n/ui";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/shapes.css";

interface Props {
  /**
   * Language of the page, written to `<html lang>`. The language links point to every other
   * locale. Defaults to `DEFAULT_LOCALE`.
   */
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;

// Locales to link to: the same page in each of them, from `localizedPath`.
const targets = LOCALES.filter((locale) => locale !== lang);

/**
 * Background of the favicons, the light `--bg` of the design. The logo is black on a transparent
 * background, so without it the icon disappears on dark tab bars and on iOS home screens.
 */
const FAVICON_BACKGROUND = "#ECEAE5";

/** Renders the logo as an opaque square PNG of `size` pixels for a favicon link. */
function logoIcon(size: number) {
  return getImage({
    src: logo,
    width: size,
    height: size,
    format: "png",
    background: FAVICON_BACKGROUND,
  });
}

const [icon32, icon192, appleTouchIcon] = await Promise.all([
  logoIcon(32),
  logoIcon(192),
  logoIcon(180),
]);
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <link rel="icon" type="image/png" sizes="32x32" href={icon32.src}>
    <link rel="icon" type="image/png" sizes="192x192" href={icon192.src}>
    <link rel="apple-touch-icon" href={appleTouchIcon.src}>
    <link
      rel="alternate"
      type="application/rss+xml"
      title={FEED_TITLE}
      href={FEED_PATH}
    >
    <meta name="generator" content={Astro.generator}>
    <title>ikili.pro</title>
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-mono" />
    {/* Elements that a page adds to <head> with slot="head". */}
    <slot name="head" />
  </head>
  <body>
    <nav>
      {targets.map((target) => (
  <a
    href={localizedPath(Astro.url.pathname, target)}
    hreflang={target}
    lang={target}
  >
    {translate(target, "locale.name")}
  </a>
))}
    </nav>
    <slot />
  </body>
</html>

<style>
html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
}

/* Every element except form controls (which need `font: inherit`) inherits Zen Maru Gothic;
   components set var(--font-display) or var(--font-mono) where the design uses Saira Condensed
   or JetBrains Mono. */
html {
  font-family: var(--font-body);
  /* Only the loaded weights are drawn: no faux bold above JetBrains Mono 500. */
  font-synthesis-weight: none;
}
</style>
