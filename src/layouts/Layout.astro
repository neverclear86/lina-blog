---
import { Font, getImage } from "astro:assets";
import logo from "../assets/logo-light.png";
import { FEED_PATH, FEED_TITLE } from "../blog-rss";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { DEFAULT_LOCALE, type Locale } from "../i18n/locales";
import { alternateLinks, canonicalUrl } from "../i18n/paths";
import { THEME_SCRIPT } from "../theme";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/shapes.css";
import "../styles/motion.css";

interface Props {
  /**
   * Language of the page, written to `<html lang>` and passed to the site header. Defaults to
   * `DEFAULT_LOCALE`.
   */
  lang?: Locale;
  /**
   * Name of the page, such as the title of a work. `<title>` is `<name> | ikili.pro`, or
   * `ikili.pro` alone when the name is omitted or is `ikili.pro` itself.
   */
  title?: string;
}

const { lang = DEFAULT_LOCALE, title } = Astro.props;

const pageTitle =
  title && title !== "ikili.pro" ? `${title} | ikili.pro` : "ikili.pro";

const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const alternates = alternateLinks(Astro.url.pathname, Astro.site);

/**
 * Background of the favicons, the light `--bg` of the design. The logo is black on a transparent
 * background, so without it the icon disappears on dark tab bars and on iOS home screens.
 */
const FAVICON_BACKGROUND = "#ECEAE5";

/** Renders the logo as an opaque square PNG of `size` pixels for a favicon link. */
function logoIcon(size: number) {
  return getImage({
    src: logo,
    width: size,
    height: size,
    format: "png",
    background: FAVICON_BACKGROUND,
  });
}

const [icon32, icon192, appleTouchIcon] = await Promise.all([
  logoIcon(32),
  logoIcon(192),
  logoIcon(180),
]);
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    {/* Sets <html data-theme> before the first paint; see THEME_SCRIPT in src/theme.ts. */}
    <script is:inline set:html={THEME_SCRIPT} />
    <link rel="icon" type="image/png" sizes="32x32" href={icon32.src}>
    <link rel="icon" type="image/png" sizes="192x192" href={icon192.src}>
    <link rel="apple-touch-icon" href={appleTouchIcon.src}>
    <link
      rel="alternate"
      type="application/rss+xml"
      title={FEED_TITLE}
      href={FEED_PATH}
    >
    {/* The canonical URL and the same page in each language; see src/i18n/paths.ts. */}
    <link rel="canonical" href={canonical}>
    {alternates.map(({ hreflang, href }) => (
  <link rel="alternate" hreflang={hreflang} href={href}>
))}
    <meta name="generator" content={Astro.generator}>
    <title>{pageTitle}</title>
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-mono" />
    {/* Elements that a page adds to <head> with slot="head". */}
    <slot name="head" />
  </head>
  <body>
    <SiteHeader lang={lang} />
    {/* The page content; it grows so that the footer sits at the bottom of a short page. */}
    <div class="site-content"><slot /></div>
    {/* The site footer, after the page content. */}
    <SiteFooter lang={lang} />
  </body>
</html>

<style>
html,
body {
  margin: 0;
  width: 100%;
}

html {
  height: 100%;
}

/* On a page shorter than the viewport, .site-content grows and the footer sits at the bottom. */
body {
  display: flex;
  flex-direction: column;
  min-height: 100%;
}

/* Keeps the page in block layout, where its margin-inline: auto works as on a plain body. */
.site-content {
  flex-grow: 1;
}

/* Every element except form controls (which need `font: inherit`) inherits Zen Maru Gothic;
   components set var(--font-display) or var(--font-mono) where the design uses Saira Condensed
   or JetBrains Mono. */
html {
  font-family: var(--font-body);
  /* Only the loaded weights are drawn: no faux bold above JetBrains Mono 500. */
  font-synthesis-weight: none;
}
</style>
