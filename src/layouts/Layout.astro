---
import { Font } from "astro:assets";
import { FEED_PATH, FEED_TITLE } from "../blog-rss";
import type { FooterVariant } from "../components/footer-links";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { DEFAULT_LOCALE, type Locale } from "../i18n/locales";
import { absoluteUrl, alternateLinks, canonicalUrl } from "../i18n/paths";
import { openGraphTags, pageDescription, twitterTags } from "../page-meta";
import { THEME_SCRIPT } from "../theme";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/controls.css";
import "../styles/window.css";
import "../styles/labels.css";
import "../styles/motion.css";

interface Props {
  /**
   * Language of the page, written to `<html lang>` and passed to the site header and the site
   * footer. Defaults to `DEFAULT_LOCALE`.
   */
  lang?: Locale;
  /**
   * Name of the page, such as the title of a work. `<title>` is `<name> | ikili.pro`, or
   * `ikili.pro` alone when the name is omitted or is `ikili.pro` itself.
   */
  title?: string;
  /**
   * Description of the page, written to `<meta name="description">` and `og:description`, such as
   * the description of a work. Defaults to the description of the site in `lang`.
   */
  description?: string;
  /**
   * Site-relative path of the OGP image of the page, such as `/og/ja.png`. A page with an image
   * has `og:image` (as an absolute URL), its size and `twitter:image`, and its Twitter card is
   * `summary_large_image`. Defaults to no image.
   */
  image?: string;
  /** Footer of the page: "full" or "compact". Defaults to "full". */
  footer?: FooterVariant;
  /** Whether the site header shows how far the reader is in a post. */
  readingProgress?: boolean;
}

const {
  lang = DEFAULT_LOCALE,
  title,
  description,
  image,
  footer = "full",
  readingProgress = false,
} = Astro.props;

const pageTitle =
  title && title !== "ikili.pro" ? `${title} | ikili.pro` : "ikili.pro";

const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const alternates = alternateLinks(Astro.url.pathname, Astro.site);
const metaDescription = pageDescription(lang, description);
const imageUrl =
  image === undefined ? undefined : absoluteUrl(image, Astro.site);
const openGraph = openGraphTags({
  lang,
  title: pageTitle,
  description: metaDescription,
  url: canonical,
  image: imageUrl,
});
const twitter = twitterTags(imageUrl);
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    {/* Sets <html data-theme> before the first paint; see THEME_SCRIPT in src/theme.ts. */}
    <script is:inline set:html={THEME_SCRIPT} />
    {/* The mark /li of the brand kit on ink, unchanged in public/favicon/. The PNGs are for browsers without SVG favicons and for home screens. */}
    <link rel="icon" type="image/svg+xml" href="/favicon/t3_mark_on-ink.svg">
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon/t3_mark_on-ink_32.png"
    >
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/favicon/t3_mark_on-ink_192.png"
    >
    <link rel="apple-touch-icon" href="/favicon/t3_mark_on-ink_180.png">
    <link
      rel="alternate"
      type="application/rss+xml"
      title={FEED_TITLE}
      href={FEED_PATH}
    >
    {/* The canonical URL and the same page in each language; see src/i18n/paths.ts. */}
    <link rel="canonical" href={canonical}>
    {alternates.map(({ hreflang, href }) => (
  <link rel="alternate" hreflang={hreflang} href={href}>
))}
    {/* The description, the Open Graph tags and the Twitter card; see src/page-meta.ts. */}
    <meta name="description" content={metaDescription}>
    {openGraph.map(({ property, content }) => (
  <meta property={property} content={content}>
))}
    {twitter.map(({ name, content }) => <meta name={name} content={content}>)}
    <meta name="generator" content={Astro.generator}>
    <title>{pageTitle}</title>
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono-latin" />
    {/* Elements that a page adds to <head> with slot="head". */}
    <slot name="head" />
  </head>
  <body>
    <SiteHeader lang={lang} readingProgress={readingProgress} />
    {/* The page content; it grows so that the footer sits at the bottom of a short page. */}
    <div class="site-content"><slot /></div>
    {/* The site footer, after the page content. */}
    <SiteFooter lang={lang} variant={footer} />
  </body>
</html>

<style>
html,
body {
  margin: 0;
  width: 100%;
}

html {
  height: 100%;
}

/* On a page shorter than the viewport, .site-content grows and the footer sits at the bottom. */
body {
  display: flex;
  flex-direction: column;
  min-height: 100%;
}

/* Keeps the page in block layout, where its margin-inline: auto works as on a plain body. */
.site-content {
  flex-grow: 1;
}

/* Every element except form controls (which need `font: inherit`) inherits Zen Kaku Gothic New;
   components set var(--font-mono) where the design uses JetBrains Mono. --font-mono is the
   JetBrains Mono list followed by --font-body, so Japanese in a monospace label is drawn in the
   loaded Zen Kaku Gothic New. */
html {
  --font-mono: var(--font-mono-latin), var(--font-body);
  font-family: var(--font-body);
  /* Only the loaded faces are drawn: the browser never fakes a heavier weight. */
  font-synthesis-weight: none;
}
</style>
