---
import { Font } from "astro:assets";
import { DEFAULT_LOCALE, type Locale } from "../i18n/locales";

interface Props {
  /** Language of the page, written to `<html lang>`. Defaults to `DEFAULT_LOCALE`. */
  lang?: Locale;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" href="/favicon.ico">
    <meta name="generator" content={Astro.generator}>
    <title>ikili.pro</title>
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
}

/* Every element except form controls (which need `font: inherit`) inherits Zen Maru Gothic;
   components set var(--font-display) or var(--font-mono) where the design uses Saira Condensed
   or JetBrains Mono. */
html {
  font-family: var(--font-body);
  /* Only the loaded weights are drawn: no faux bold above JetBrains Mono 500. */
  font-synthesis-weight: none;
}
</style>
