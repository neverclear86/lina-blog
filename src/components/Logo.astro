---
import { Picture } from "astro:assets";
import logoBlack from "../assets/logo-black.png";
import logoWhite from "../assets/logo-white.png";

/**
 * The ikili.pro logo, black on the light theme and white on the dark theme.
 *
 * Both images are rendered as `<picture>` elements with AVIF and WebP sources at 1x and 2x
 * of `size`, and CSS hides the one that does not match the theme. The dark theme is
 * `<html data-theme="dark">`; when `<html>` has no `data-theme`, the OS setting
 * (`prefers-color-scheme`) decides. The hidden picture is `display: none`, so assistive
 * technology reads the `alt` only once and the lazily loaded image is not fetched.
 */
interface Props {
  /** Width and height in CSS pixels; the logo is square. */
  size: number;
  /**
   * Text alternative. Pass `""` when text next to the logo, such as `ikili.pro` in the
   * same link or heading, already names the site; otherwise describe the link target.
   */
  alt: string;
}

const { size, alt } = Astro.props;
---

<span class="logo">
  <Picture
    src={logoBlack}
    alt={alt}
    width={size}
    height={size}
    densities={[1, 2]}
    formats={["avif", "webp"]}
    pictureAttributes={{ class: "black" }}
  />
  <Picture
    src={logoWhite}
    alt={alt}
    width={size}
    height={size}
    densities={[1, 2]}
    formats={["avif", "webp"]}
    pictureAttributes={{ class: "white" }}
  />
</span>

<style>
.logo {
  display: inline-flex;
}
picture {
  display: flex;
}
.white {
  display: none;
}
:global(:root[data-theme="dark"]) .black {
  display: none;
}
:global(:root[data-theme="dark"]) .white {
  display: flex;
}
@media (prefers-color-scheme: dark) {
  :global(:root:not([data-theme])) .black {
    display: none;
  }
  :global(:root:not([data-theme])) .white {
    display: flex;
  }
}
</style>
