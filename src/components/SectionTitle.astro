---
/**
 * The heading of a section of plan A: a bar with the number chip (`01`), the English name
 * (`about`), a line that fades from `--keyword` to `--line2` and the path (`~/about`), and under
 * it the Japanese heading.
 *
 * With `title`, the heading element holds the title and the English name is a plain label. With
 * no `title`, the English name is the heading element, so that the section still has a heading.
 * A "\n" in `title` breaks the line. The number chip, the line and the path are hidden from
 * assistive technology, because the path only repeats the name.
 *
 * Below 768px the number chip is 12px, the path is hidden and the heading is 30px. From 768px
 * the heading is 40px, and from 900px it is 52px. A title too long for the width breaks between
 * any two letters. The line is drawn from the left, from `scaleX(0)` to `scaleX(1)`, while it
 * rises from the bottom edge of the viewport to 35% of the viewport height above it
 * (`animation-timeline: view()`); a line already above that point when the page opens is drawn
 * whole. A browser without scroll-driven animations, a printed page and
 * `prefers-reduced-motion: reduce` show the line whole from the start. The component sets no
 * margin; the margins around it are the caller's.
 */
interface Props {
  /** Number of the section in the chip, such as `01`. */
  no: string;
  /** English name of the section, such as `about`. */
  label: string;
  /** Path at the right end, such as `~/about`. Hidden below 768px. */
  path?: string;
  /** Japanese heading under the bar, such as `さいきんの配信`. */
  title?: string;
  /** Heading element, chosen by the level of the section in the page. */
  as?: "h1" | "h2" | "h3";
}

const { no, label, path, title, as: Heading = "h2" } = Astro.props;

const Name = title === undefined ? Heading : "span"; // without a title the name is the heading
---

<div class="section-title">
  <div class="bar">
    <span class="no" aria-hidden="true">{no}</span>
    <Name class="label name">{label}</Name>
    <span class="rule" aria-hidden="true"></span>
    {path !== undefined && (
  <span class="label path" aria-hidden="true">
    {path}
  </span>
)}
  </div>
  {title !== undefined && <Heading class="title">{title}</Heading>}
</div>

<style>
.section-title {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}

.bar {
  display: flex;
  align-items: center;
  gap: 12px;
}

.no {
  flex: none;
  padding: 2px 7px;
  background: var(--keyword);
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 800;
  color: var(--ink);
}

.label.name {
  min-width: 0;
  margin: 0;
  font-weight: 400;
  color: var(--text);
  overflow-wrap: anywhere;
}

.rule {
  flex: 1 1 0;
  min-width: 0;
  height: 1px;
  background: linear-gradient(90deg, var(--keyword), var(--line2) 35%);
}

@keyframes rule-draw {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}

/* The shorthand resets `animation-timeline` and `animation-range`, so they come after it. */
@supports (animation-timeline: view()) {
  @media screen {
    .rule {
      transform-origin: left center;
      animation: rule-draw linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 35%;
    }
  }
}

/* Same specificity as the rule above, so it comes after it. */
@media (prefers-reduced-motion: reduce) {
  .rule {
    animation: none;
  }
}

.label.path {
  display: none;
}

.title {
  margin: 0;
  font-weight: 900;
  white-space: pre-line;
  overflow-wrap: anywhere;
}

.section-title .title {
  font-size: 30px;
}

@media (min-width: 768px) {
  .section-title {
    gap: 20px;
  }

  .bar {
    gap: 16px;
  }

  .no {
    padding: 3px 8px;
    font-size: 13px;
  }

  .label.path {
    display: inline;
  }

  .section-title .title {
    font-size: 40px;
  }
}

@media (min-width: 900px) {
  .section-title .title {
    font-size: 52px;
  }
}
</style>
