---
/**
 * The large window of the Latest section for the newest video: a 16:9 thumbnail with a `NEW`
 * chip at its top left, then the date in Japan time and the title, all in one link to the watch
 * page. From 768px the date line also says `· youtube`.
 *
 * Without a video, such as when the feed could not be read, the window keeps the same frame: a
 * `[ no signal ]` mark in place of the thumbnail, then the source name, the message and the link
 * text to the channel, all in one link to the YouTube channel.
 *
 * The ring of `.win` goes over the thumbnail. A hovered or focused link underlines the title
 * only, in the light theme, through `.link-title` of `global.css`; in the dark theme the title
 * turns `--keyword` through the link rule there.
 */
import { externalLinkAttrs, requireSite } from "../external-link";
import type { Locale } from "../i18n/locales";
import { translate } from "../i18n/ui";
import { formatJstDate } from "../jst-date";
import { YOUTUBE_URL } from "../profile-links";
import type { YouTubeVideo } from "../youtube-feed";
import ExternalNote from "./ExternalNote.astro";

interface Props {
  /** Locale of the page, which chooses the texts shown without a video. */
  lang: Locale;
  /** The newest video, or `undefined` when there is none. */
  video: YouTubeVideo | undefined;
  /**
   * Classes for the window. Sample only (見本用): the sample page passes `is-hover` and
   * `is-focus` to show the hovered and focused states, and the home page leaves it out.
   */
  class?: string;
}

const { lang, video, class: className } = Astro.props;
const site = requireSite(Astro.site);

// Width of the window assumed for the images: from 1280px, two thirds of a box of up to 1440px
// less 64px padding on both sides and 14px between two columns; the screen less 64px on each
// side from 900px and less 20px on each side from 768px; the screen less 32px below.
const SIZES =
  "(min-width: 1280px) calc((min(100vw, 1440px) - 142px) * 2 / 3), (min-width: 900px) calc(100vw - 128px), (min-width: 768px) calc(100vw - 40px), calc(100vw - 32px)";
---

{video ? (
  <a
    class:list={["win", "feature", className]}
    href={video.url}
    {...externalLinkAttrs(video.url, site)}
  >
    <div class="gridbg thumb">
      <img
        src={video.thumbnail.src}
        srcset={video.thumbnail.srcset}
        sizes={SIZES}
        width="480"
        height="270"
        alt=""
        loading="lazy"
        decoding="async"
      />
      <span class="chip-acc new">NEW</span>
    </div>
    <div class="body">
      <span class="label">
        <time datetime={video.publishedAt.toISOString()}>
          {formatJstDate(video.publishedAt)}
        </time>{" "}
        <span class="source">· youtube</span>
      </span>
      <strong class="title link-title" lang="ja">
        {video.title}
      </strong>
    </div>
    <ExternalNote lang={lang} />
  </a>
) : (
  <a
    class:list={["win", "feature", className]}
    href={YOUTUBE_URL}
    {...externalLinkAttrs(YOUTUBE_URL, site)}
  >
    <div class="gridbg thumb">
      <span class="label" aria-hidden="true">
        [ no signal ]
      </span>
    </div>
    <div class="body">
      <span class="label">youtube</span>
      <span class="message">{translate(lang, "latest.videos.empty")}</span>
      <strong class="title link-title">
        {translate(lang, "latest.videos.channel")}{" "}
        <span aria-hidden="true">→</span>
      </strong>
    </div>
    <ExternalNote lang={lang} />
  </a>
)}

<style>
.feature {
  display: flex;
  flex-direction: column;
  min-width: 0;
  overflow: hidden;
  text-decoration: none;
}

/* The ring of .win is drawn under the positioned .thumb; this brings it over the thumbnail. */
.feature::before {
  z-index: 1;
}

.thumb {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 16 / 9;
}

.thumb img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* The NEW chip keeps its own size and letter spacing at every width, unlike `.chip-acc` alone. */
.new {
  position: absolute;
  top: 10px;
  left: 10px;
  padding: 3px 7px;
  font-size: 11px;
  letter-spacing: 0;
}

.body {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 14px 16px 16px;
}

.source {
  display: none;
}

.message {
  font-size: 15px;
  color: var(--muted);
}

.title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  overflow: hidden;
  font-size: 17px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

@media (min-width: 768px) {
  .new {
    top: 16px;
    left: 16px;
    padding: 4px 8px;
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .body {
    gap: 8px;
    padding: 18px 22px 22px;
  }

  .source {
    display: inline;
  }

  .title {
    font-size: 22px;
  }
}
</style>
