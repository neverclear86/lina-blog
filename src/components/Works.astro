---
import { getCollection } from "astro:content";
import type { Locale } from "../i18n/locales";
import { translate } from "../i18n/ui";
import { workCardLink, worksInOrder } from "../work-card";
import SectionTitle from "./SectionTitle.astro";
import WorkTile from "./WorkTile.astro";

/**
 * The Works section of the top page, `04 works`: the heading, then a window tile for each
 * work in the `works` collection, sorted by `order`.
 *
 * Each tile is a `WorkTile` that links to the page of the work, or else to its demo or
 * repository. The tiles sit in as many columns of at least 300px as fit from 768px, and in
 * one column below. Without works, the section shows the heading and "coming soon".
 */
interface Props {
  /** Language of the page, which picks the strings and the link targets. */
  lang: Locale;
}

const { lang } = Astro.props;

const works = worksInOrder(await getCollection("works"));
---

<section id="works" class="works">
  <SectionTitle no="04" label="works" />
  {works.length === 0 ? (
  <p class="empty">{translate(lang, "home.comingSoon")}</p>
) : (
  <ul class="tiles">
    {works.map(({ data }) => (
      <li>
        <WorkTile
          lang={lang}
          title={data.title}
          description={data.description[lang]}
          tech={data.tech}
          link={workCardLink(data, lang)}
        />
      </li>
    ))}
  </ul>
)}
</section>

<style>
.works {
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-sizing: border-box;
  max-width: 1440px;
  margin: 0 auto;
  padding: 48px 16px;
}

.empty {
  margin: 0;
  font-size: 15px;
  color: var(--muted);
}

.tiles {
  display: grid;
  gap: 12px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.tiles > li {
  display: grid;
  min-width: 0;
}

@media (min-width: 768px) {
  .works {
    gap: 28px;
    padding: 100px 20px;
  }

  .tiles {
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 14px;
  }
}

@media (min-width: 900px) {
  .works {
    padding-inline: 64px;
  }
}
</style>
