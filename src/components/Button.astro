---
/**
 * The orange main button of the design, such as "お問い合わせ" and "送信する" in
 * `design/CBMain.dc.html`.
 *
 * With `href` it renders an `<a>`, and without it a `<button>`. The element holds a shadow
 * element with `.lift`, and that holds the notched orange face, so that the focus outline of
 * `shapes.css` goes on the outer element. A `<button>` that is disabled or has
 * `aria-disabled="true"` keeps its 3px shadow, does not lift and dims to 55% opacity.
 */
type Props = {
  /** Height, padding and font size: "md" (44px, the header) or "lg" (54px, the form). */
  size?: "md" | "lg";
  /** Shadow color: "shadow" (`--shadow`) or "ink" (`--legacy-ink`, on the paper form). */
  shadow?: "shadow" | "ink";
  /** Classes for the outer element, such as a layout class of the caller. */
  class?: string;
} & (
  | {
      /** Link target. With it the button is an `<a>` and takes neither `type` nor `disabled`. */
      href: string;
      type?: never;
      disabled?: never;
    }
  | {
      href?: undefined;
      /** Type of the `<button>`. Defaults to "button". */
      type?: "button" | "submit" | "reset";
      /** Disables the `<button>`. */
      disabled?: boolean;
    }
);

const {
  size = "md",
  shadow = "shadow",
  class: className,
  href,
  type = "button",
  disabled,
} = Astro.props;
const shadowClass = shadow === "ink" ? "shadowInk" : "shadow";
---

{href ? (
  <a class:list={["button", className]} href={href}>
    <span class:list={[shadowClass, "lift"]}>
      <span class:list={["shape", "face", size]}>
        <slot />
      </span>
    </span>
  </a>
) : (
  <button class:list={["button", className]} type={type} disabled={disabled}>
    <span class:list={[shadowClass, "lift"]}>
      <span class:list={["shape", "face", size]}>
        <slot />
      </span>
    </span>
  </button>
)}

<style>
.button {
  display: inline-block;
  vertical-align: top;
  text-decoration: none;
}

button.button {
  font: inherit;
  color: inherit;
  background: none;
  border: 0;
  padding: 0;
  cursor: pointer;
}

.button > span {
  display: block;
}

.face {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: var(--orange);
  color: var(--legacy-ink);
  font-weight: 900;
  white-space: nowrap;
}

.md {
  height: 44px;
  padding: 0 22px;
  font-size: 15px;
}

.lg {
  height: 54px;
  padding: 0 34px;
  font-size: 16px;
}

.button:disabled,
.button[aria-disabled="true"] {
  cursor: default;
}

.button:disabled > .lift,
.button[aria-disabled="true"] > .lift {
  transform: none;
  filter: drop-shadow(3px 3px 0 var(--shadow-color));
  opacity: 0.55;
}
</style>
