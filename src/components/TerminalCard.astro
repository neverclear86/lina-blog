---
/**
 * A card drawn as a terminal window: a 34px title bar with three dots and the title in
 * JetBrains Mono, above the default slot.
 *
 * With `href` the card is a link of three layers, `<a>` > shadow and `.lift` > notched shape,
 * so that the keyboard focus outline goes on the `<a>` (`src/styles/global.css`). Without it
 * the card has the two inner layers only. The body of a link card must not contain links or
 * buttons. The body is placed right under the title bar, so the slot sets its own padding.
 * The layers fill the height of their parent, so cards in a grid row have the same height.
 */
interface Props {
  /**
   * Text in the title bar, such as `~/works/ikili.pro`. It is cut off with an ellipsis when it
   * does not fit.
   */
  title: string;
  /** Link target. Without it the card is not a link. */
  href?: string;
  /** Notched shape from `shapes.css`. */
  shape?: "shape" | "shapeL";
  /** Hard shadow: `--shadow` (`.shadow`) or `--fshadow` (`.shadowF`), for a card on `--cbg`. */
  shadow?: "shadow" | "fshadow";
  /**
   * `surface` follows the theme (`--surf` and `--fg`, the bar in `--inv`). `paper` keeps the
   * same colors in both themes (`--paper` and `--legacy-ink`, the bar in `--legacy-ink` and
   * `--paper-muted`) and sets `--focus-ring` to `--legacy-ink`, for a form on `--cbg`.
   */
  tone?: "surface" | "paper";
  /** Whether the card lifts on hover and, for a link, on keyboard focus. */
  lift?: boolean;
  /** Classes for the outer element: the `<a>` of a link card, otherwise the shadow layer. */
  class?: string;
}

const {
  title,
  href,
  shape = "shape",
  shadow = "shadow",
  tone = "surface",
  lift = true,
  class: className,
} = Astro.props;

const shadowClass = shadow === "fshadow" ? "shadowF" : "shadow";
---

{href ? (
  <a href={href} class:list={["link", className]}>
    <div class:list={[shadowClass, "frame", { lift }]}>
      <div class:list={[shape, "card", tone]}>
        <div class="tbar">
          <span class="dot pink" aria-hidden="true" />
          <span class="dot orange" aria-hidden="true" />
          <span class="dot green" aria-hidden="true" />
          <span class="title">{title}</span>
        </div>
        <slot />
      </div>
    </div>
  </a>
) : (
  <div class:list={[shadowClass, "frame", { lift }, className]}>
    <div class:list={[shape, "card", tone]}>
      <div class="tbar">
        <span class="dot pink" aria-hidden="true" />
        <span class="dot orange" aria-hidden="true" />
        <span class="dot green" aria-hidden="true" />
        <span class="title">{title}</span>
      </div>
      <slot />
    </div>
  </div>
)}

<style>
.link {
  display: block;
  height: 100%;
  color: inherit;
  text-decoration: none;
}

.frame {
  height: 100%;
}

.card {
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--surf);
  color: var(--fg);
}

.paper {
  --focus-ring: var(--legacy-ink);
  color-scheme: light;
  background: var(--paper);
  color: var(--legacy-ink);
}

.tbar {
  height: 34px;
  display: flex;
  align-items: center;
  gap: 8px;
  /* The right padding is at least the notch, so that the notch does not cut the title. */
  padding: 0 max(14px, var(--notch)) 0 14px;
  flex-shrink: 0;
  background: var(--inv);
  color: var(--invmuted);
  font-family: var(--font-mono);
  font-size: 12px;
}

.paper .tbar {
  background: var(--legacy-ink);
  color: var(--paper-muted);
}

.dot {
  width: 11px;
  height: 11px;
  border-radius: 50%;
  flex-shrink: 0;
}

.pink {
  background: var(--pink);
}

.orange {
  background: var(--orange);
}

.green {
  background: var(--green);
}

.title {
  margin-left: 8px;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
</style>
