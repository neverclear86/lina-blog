---
/**
 * Blog posts as `PostCard`s, in the order given: one column, and two columns from 1024px.
 * Without posts, one line of `emptyText` takes the place of the list.
 */
import type { ComponentProps } from "astro/types";
import PostCard from "./PostCard.astro";

interface Props {
  /** Posts to show, in the order they are shown. */
  posts: readonly ComponentProps<typeof PostCard>["post"][];
  /** Text shown when `posts` is empty, such as "まだ記事はありません。". */
  emptyText: string;
}

const { posts, emptyText } = Astro.props;
---

{posts.length === 0 ? (
  <p class="empty">{emptyText}</p>
) : (
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <PostCard post={post} />
      </li>
    ))}
  </ul>
)}

<style>
.posts {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 32px;
  margin: 0;
  padding: 0;
  list-style: none;
}

@media (min-width: 1024px) {
  .posts {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.empty {
  margin: 0;
  color: var(--muted);
  font-size: 15px;
  font-weight: 500;
}
</style>
