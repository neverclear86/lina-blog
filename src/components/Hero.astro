---
/**
 * The hero of the top page, copied from `#top` of `design/Main.dc.html` except for the right
 * column: on the grid background (`.gridbg`), the prompt, the full name logo with the sub line
 * (`NameLogo`, `full-sub`) in a box with corner ticks (`.ticks`), the heading (`<h1>`), the
 * intro, the button to the latest video (`#latest`) and the account window (`HeroAccount`). A
 * band of stripes (`.stripes`) closes the hero.
 *
 * The strings come from the `hero.*` keys of `src/i18n/ui.ts`. The prompt, the name of the logo,
 * `/tsukusu/lina $_ # 創好リナ ── VIRTUAL IKIRI PROGRAMMER`, and the text of the orange band are
 * the same in every locale. The prompt, the decorations behind the text (the tilted orange band
 * with its vertical text, the hatch, the two lines and the five crosses) and the stripes are
 * hidden from assistive technology. The band and the stripes stand still.
 *
 * From 901px the content is a grid of two columns, 1.08fr and 0.92fr, 64px from the sides and at
 * least 820px high. The left column holds the prompt, the logo, the heading, the intro and the
 * button, and ends with `.hero-account`, which holds the account window (`HeroAccount`).
 * `.hero-right` is empty. Up to 900px the grid is one column 20px from the sides, the heading is
 * 40px, the band is 150px wide and the two lines are left out. The band, the hatch and the lines
 * keep clear of the text: from 901px the band starts at 57% of the width, or further right where
 * the intro would reach it, and up to 900px at 46% or 390px, whichever is further right. Up to
 * 767px the logo box has neither the ticks nor the ground, the intro is in `--text`, and the
 * button fills the column, 48px high, without the triangle.
 *
 * The cursor of the logo blinks (`.blink-on` in `src/styles/motion.css`) while some part of the
 * logo is in the viewport, starting 1.6s after the page opens or the logo comes back into it. A
 * script sets `data-offscreen` on the logo while no part of it is; the cursor of the logo then
 * stops and the one of the logo in `SiteHeader` blinks in its place, so that one cursor blinks on
 * a screen. Without the script the logo keeps blinking and the header stays still.
 */
import type { Locale } from "../i18n/locales";
import { translate } from "../i18n/ui";
import HeroAccount from "./HeroAccount.astro";
import NameLogo from "./NameLogo.astro";

interface Props {
  /** Language of the page, which picks the strings. */
  lang: Locale;
}

const { lang } = Astro.props;

/** The text of the orange band, repeated to fill its length. `\xa0` joins the repeats. */
const BAND_TEXT = "LINA TSUKUSU // VIRTUAL IKIRI PROGRAMMER //\xa0".repeat(4);
---

<section id="top" class="hero gridbg">
  <div class="decor" aria-hidden="true">
    <div class="hatch"></div>
    <div class="band"><span class="band-text">{BAND_TEXT}</span></div>
    <div class="ln ln-thick"></div>
    <div class="ln ln-thin"></div>
    <span class="cross c1">+</span>
    <span class="cross c2">+</span>
    <span class="cross c3">+</span>
    <span class="cross c4">+</span>
    <span class="cross c5">+</span>
  </div>
  <div class="hero-grid">
    <div class="hero-left">
      <p class="whoami" aria-hidden="true">
        lina@tsukusu:~$ <span>whoami</span>
      </p>
      <div class="ticks hero-logo blink-on">
        <NameLogo
          variant="full-sub"
          label="/tsukusu/lina $_ # 創好リナ ── VIRTUAL IKIRI PROGRAMMER"
        />
      </div>
      <h1 class="heading">
        {translate(lang, "hero.headingLead")}<br>
        <span class="mark">{translate(lang, "hero.headingMark")}</span>
      </h1>
      <p class="intro">{translate(lang, "hero.intro")}</p>
      <a class="btn btn-acc latest" href="#latest">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 4l13 8-13 8z"></path>
        </svg>{translate(lang, "hero.latestVideo")}
      </a>
      <div class="hero-account"><HeroAccount lang={lang} /></div>
    </div>
    <div class="hero-right"></div>
  </div>
</section>
<div class="stripes" aria-hidden="true"></div>

<style>
.hero {
  position: relative;
  overflow: hidden;
}

.decor {
  --band-left: max(57%, calc(64px + min(520px, (100% - 128px) * 0.54) + 187px));
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.band {
  position: absolute;
  top: -35%;
  left: var(--band-left);
  display: flex;
  justify-content: center;
  width: 230px;
  height: 175%;
  overflow: hidden;
  background: var(--keyword);
  transform: rotate(22deg);
}

.band-text {
  align-self: flex-start;
  font-family: var(--font-mono);
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.42em;
  color: var(--ink);
  white-space: nowrap;
  writing-mode: vertical-rl;
  transform: rotate(180deg);
}

.hatch {
  position: absolute;
  top: -35%;
  left: calc(var(--band-left) - 110px);
  width: 36px;
  height: 175%;
  background: repeating-linear-gradient(
    to bottom,
    var(--keyword) 0 5px,
    transparent 5px 15px
  );
  opacity: 0.7;
  transform: rotate(22deg);
}

.ln {
  position: absolute;
  top: -35%;
  height: 175%;
  background: var(--text);
  transform: rotate(22deg);
}

.ln-thick {
  left: calc(var(--band-left) + 300px);
  width: 5px;
}

.ln-thin {
  left: calc(var(--band-left) + 340px);
  width: 1px;
  opacity: 0.45;
}

.cross {
  position: absolute;
  font-family: var(--font-mono);
  font-size: 18px;
  line-height: 1;
  color: var(--muted);
  opacity: 0.6;
}

.c1 {
  left: 6%;
  top: 9%;
}

.c2 {
  left: 34%;
  top: 22%;
}

.c3 {
  left: 29%;
  top: 70%;
}

.c4 {
  right: 4%;
  top: 40%;
}

.c5 {
  right: 11%;
  top: 86%;
}

.hero-grid {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
  box-sizing: border-box;
  min-height: 820px;
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 64px;
}

.hero-left {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 28px;
  min-width: 0;
  padding: 96px 0 72px;
}

.whoami {
  margin: 0;
  font-family: var(--font-mono);
  font-size: 14px;
  color: var(--muted);
}

.whoami span {
  color: var(--text);
}

.hero-logo {
  box-sizing: border-box;
  max-width: 640px;
  padding: 30px 32px;
  background-color: var(--shade);
}

.hero-logo :global(.cur) {
  animation-delay: 1.6s;
}

.hero-logo[data-offscreen] :global(.cur) {
  animation: none;
}

.heading {
  margin: 8px 0 0;
  font-size: 60px;
  font-weight: 900;
  line-height: 1.12;
  letter-spacing: 0.01em;
  text-wrap: balance;
}

.mark {
  background: linear-gradient(
    transparent 62%,
    color-mix(in srgb, var(--keyword) 55%, transparent) 62%
  );
}

.intro {
  max-width: 520px;
  margin: 0;
  font-size: 17px;
  line-height: 1.9;
  color: var(--muted);
  text-wrap: pretty;
}

.latest {
  align-self: flex-start;
}

.hero-account {
  max-width: 520px;
  margin-top: 8px;
}

.hero-right {
  position: relative;
  min-height: 560px;
}

@media (max-width: 900px) {
  .decor {
    --band-left: max(46%, 390px);
  }

  .band {
    top: 30%;
    width: 150px;
    height: 120%;
  }

  .hatch {
    top: 30%;
    left: calc(var(--band-left) - 70px);
    height: 120%;
  }

  .ln {
    display: none;
  }

  .hero-grid {
    grid-template-columns: minmax(0, 1fr);
    padding: 0 20px;
  }

  .heading {
    font-size: 40px;
  }

  .hero-right {
    height: 560px;
  }
}

@media (max-width: 767px) {
  .hero-logo {
    padding: 0;
    background: none;
  }

  .intro {
    color: var(--text);
  }

  .latest {
    align-self: stretch;
    justify-content: center;
    min-height: 48px;
  }

  .latest svg {
    display: none;
  }
}
</style>

<script>
// While no part of the logo of the hero is in the viewport, mark it with `data-offscreen`: its
// cursor stops, and the cursor of the logo in the site header blinks in its place (see
// `.hero-logo` in `SiteHeader.astro`).
const logo = document.querySelector<HTMLElement>(".hero-logo");
if (logo && "IntersectionObserver" in window) {
  new IntersectionObserver((entries) => {
    for (const entry of entries) {
      logo.toggleAttribute("data-offscreen", !entry.isIntersecting);
    }
  }).observe(logo);
}
</script>
