---
/**
 * The hero of the top page, copied from `#top` of `design/CBMain.dc.html` and the first view of
 * `design/CBMobile.dc.html` except for the name: `$ whoami`, the full name logo with the sub line
 * (`NameLogo`, `full-sub`) as the `<h1>` of the page, the tilted pink chip, the intro, and the
 * icon links of the profiles in `PROFILE_LINKS` followed by the RSS feed, on the grid background.
 *
 * The strings come from the `hero.*` keys of `src/i18n/ui.ts`. `$ whoami` and the name of the
 * logo, `/tsukusu/lina $_ # 創好リナ ── VIRTUAL IKIRI PROGRAMMER`, are the same in every locale.
 * Each profile link shows the icon of its `id` and has `rel="me"`.
 *
 * The section is a one-column grid. `.stage`, behind the text, holds the height of the stage:
 * 566px below 768px, and from 768px 840px at 1440px wide, shrinking with the section (`cqw`)
 * and growing with the content. Below 1024px the intro and the links sit in a row below the
 * stage; from 1024px they follow the chip in the text column. Below 768px the intro is
 * `hero.introShort`, and the English links sit in three columns.
 *
 * The cursor of the logo blinks (`.blink-on` in `src/styles/motion.css`) while some part of the
 * logo is in the viewport, starting 1.6s after the page opens or the logo comes back into it. A
 * script sets `data-offscreen` on the logo while no part of it is; the cursor of the logo then
 * stops and the one of the logo in `SiteHeader` blinks in its place, so that one cursor blinks on
 * a screen. Without the script the logo keeps blinking and the header stays still.
 *
 * The last row is the dark strip: the striped `Tape`, then "status: online" and the switching
 * kaomoji of `Kao` in JetBrains Mono. "status: online" is a fixed decoration, hidden from
 * assistive technology. From 768px the strip is 40px high with a 160px tape and ends with
 * `site.curlHint` on the right; below 768px it is 36px high with a 64px tape and leaves the
 * curl hint out, as in `design/CBMobile.dc.html`.
 */
import { FEED_PATH } from "../blog-rss";
import type { Locale } from "../i18n/locales";
import { translate } from "../i18n/ui";
import { PROFILE_LINKS, type ProfileLink } from "../profile-links";
import Chip from "./Chip.astro";
import IconLink from "./IconLink.astro";
import GitHubIcon from "./icons/GitHubIcon.astro";
import NostrIcon from "./icons/NostrIcon.astro";
import RssIcon from "./icons/RssIcon.astro";
import XIcon from "./icons/XIcon.astro";
import YouTubeIcon from "./icons/YouTubeIcon.astro";
import ZennIcon from "./icons/ZennIcon.astro";
import Kao from "./Kao.astro";
import NameLogo from "./NameLogo.astro";
import Tape from "./Tape.astro";

interface Props {
  /** Language of the page, which picks the strings. */
  lang: Locale;
}

const { lang } = Astro.props;

const ICONS = {
  youtube: YouTubeIcon,
  twitter: XIcon,
  github: GitHubIcon,
  nostr: NostrIcon,
  zenn: ZennIcon,
} satisfies Record<ProfileLink["id"], unknown>;
---

<section id="top" class="hero grid">
  <div class="stage"></div>
  <div class="text">
    <p class="prompt" aria-hidden="true">$ whoami</p>
    <h1 class="hero-logo blink-on">
      <NameLogo
        variant="full-sub"
        label="/tsukusu/lina $_ # 創好リナ ── VIRTUAL IKIRI PROGRAMMER"
      />
    </h1>
    <span class="tagline"
      ><Chip tone="pink" tilt>{translate(lang, "hero.tagline")}</Chip></span
    >
  </div>
  <div class="intro">
    <p class="intro-text">
      <span class="intro-long">{translate(lang, "hero.intro")}</span
      ><span class="intro-short">{translate(lang, "hero.introShort")}</span>
    </p>
    <nav class="links" aria-label={translate(lang, "hero.links")}>
      {PROFILE_LINKS.map((link) => {
  const Icon = ICONS[link.id];
  return (
    <IconLink href={link.url} label={link.label[lang]} rel="me">
      <Icon />
    </IconLink>
  );
})}
      <IconLink href={FEED_PATH} label="RSS"><RssIcon /></IconLink>
    </nav>
  </div>
  <div class="band">
    <span class="band-tape"><Tape width="100%" /></span>
    <div class="band-text">
      <span aria-hidden="true"
        >status: online<span class="band-kao"
          ><Kao faces={["⸜(*ˊᗜˋ*)⸝", "ᐠ( ᐛ )ᐟ", "(๑•̀ㅂ•́)و✧"]} /></span
        ></span
      >
      <span class="curl">{translate(lang, "site.curlHint")}</span>
    </div>
  </div>
</section>

<style>
.hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  grid-template-areas:
    "text"
    "intro"
    "band";
  overflow: hidden;
  border-bottom: 1px solid var(--legacy-line);
  container-type: inline-size;
}

.stage {
  grid-area: text;
  height: 566px;
}

.text {
  grid-area: text;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  padding: 12px 18px 0;
}

.prompt {
  margin: 0;
  font-family: var(--font-mono);
  font-size: 11px;
  line-height: 14px;
  color: var(--muted);
}

.hero-logo {
  width: min(576px, 100%);
  margin: 28px 0 0;
}

.hero-logo :global(.cur) {
  animation-delay: 1.6s;
}

.hero-logo[data-offscreen] :global(.cur) {
  animation: none;
}

.tagline {
  margin: 28px 0 0 -4px;
}

.intro {
  grid-area: intro;
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: 20px 18px 24px;
  border-top: 1px solid var(--legacy-line);
  background: var(--bg);
}

.intro-text {
  margin: 0;
  font-size: 15px;
  font-weight: 500;
  line-height: 1.8;
}

.intro-long {
  display: none;
}

.links {
  display: flex;
  justify-content: space-between;
}

.links:lang(en) {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  justify-items: center;
  row-gap: 16px;
}

.band {
  grid-area: band;
  display: flex;
  align-items: stretch;
  height: 36px;
  background: var(--inv);
  color: var(--invfg);
  font-family: var(--font-mono);
  font-size: 12px;
}

.band-tape {
  display: flex;
  flex-shrink: 0;
  width: 64px;
}

.band-text {
  display: flex;
  flex-grow: 1;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  padding: 0 12px;
  white-space: nowrap;
}

.band-kao {
  display: inline-block;
  min-width: 7em;
  margin-left: 8px;
  vertical-align: middle;
}

.curl {
  display: none;
  color: var(--invmuted);
}

@media (min-width: 768px) {
  .stage {
    height: auto;
    min-height: min(840px, 58.333cqw);
  }

  .text {
    padding: min(52px, 3.611cqw) 40px 0;
  }

  .prompt {
    font-size: 13px;
    line-height: 17px;
  }

  .tagline {
    margin-left: 0;
  }

  .intro {
    gap: 20px;
    padding: 24px 40px 32px;
  }

  .intro-text {
    max-width: 560px;
    font-size: 18px;
    line-height: 1.85;
  }

  .intro-long {
    display: inline;
  }

  .intro-short {
    display: none;
  }

  .links,
  .links:lang(en) {
    display: flex;
    gap: 20px;
    justify-content: flex-start;
  }

  .band {
    height: 40px;
    font-size: 13px;
  }

  .band-tape {
    width: 160px;
  }

  .band-text {
    padding: 0 24px;
  }

  .band-kao {
    min-width: 8em;
    margin-left: 1ch;
  }

  .curl {
    display: inline;
  }
}

@media (min-width: 1024px) {
  .hero {
    grid-template-areas:
      "text"
      "intro"
      "."
      "band";
    grid-template-rows: auto auto 1fr auto;
  }

  .stage {
    grid-area: 1 / 1 / 4 / 2;
  }

  .text {
    padding: min(52px, 3.611cqw) 64px 0;
  }

  .intro {
    gap: 31px;
    max-width: calc(51.389% - 64px - 24px);
    padding: 27px 0 min(83px, 5.764cqw) 64px;
    border-top: 0;
    background: none;
  }

  .links,
  .links:lang(en) {
    gap: 12px;
  }
}

@media (min-width: 1280px) {
  .links,
  .links:lang(en) {
    gap: 20px;
  }
}
</style>

<script>
// While no part of the logo of the hero is in the viewport, mark it with `data-offscreen`: its
// cursor stops, and the cursor of the logo in the site header blinks in its place (see
// `.hero-logo` in `SiteHeader.astro`).
const logo = document.querySelector<HTMLElement>(".hero-logo");
if (logo && "IntersectionObserver" in window) {
  new IntersectionObserver((entries) => {
    for (const entry of entries) {
      logo.toggleAttribute("data-offscreen", !entry.isIntersecting);
    }
  }).observe(logo);
}
</script>
