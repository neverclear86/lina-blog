---
/**
 * Wraps rendered Markdown (an article's `<Content />`) and styles the elements that Sätteri
 * and the plugins in src/markdown/ output: GFM tables, task lists, footnotes, the file names
 * of code blocks and YouTube embeds. The rules reach those elements through `:global()` under
 * `.article-body`, so they apply only inside this wrapper. Code blocks are styled by the imported
 * src/markdown/highlight.css, whose rules match `pre.shiki`.
 */
import "../markdown/highlight.css";
---

<div class="article-body"><slot /></div>

<style>
.article-body :global(table) {
  display: block;
  max-width: 100%;
  overflow-x: auto;
  border-collapse: collapse;
}

.article-body :global(th),
.article-body :global(td) {
  padding: 0.5em 0.75em;
  border-bottom: 1px solid var(--hair);
  text-align: start;
  min-width: 4em;
}

.article-body :global(th) {
  border-bottom-color: var(--line);
  background: var(--surf);
  white-space: nowrap;
}

.article-body :global(:is(th, td).align-left) {
  text-align: left;
}

.article-body :global(:is(th, td).align-center) {
  text-align: center;
}

.article-body :global(:is(th, td).align-right) {
  text-align: right;
}

.article-body :global(.contains-task-list) {
  padding-inline-start: 1.5em;
}

.article-body :global(.task-list-item) {
  list-style: none;
}

.article-body :global(.task-list-item > input) {
  margin: 0 0.5em 0 -1.5em;
  accent-color: var(--fg);
}

.article-body :global(.footnotes) {
  margin-top: 3em;
  padding-top: 1em;
  border-top: 1px solid var(--hair);
  color: var(--muted);
  font-size: 0.875em;
}

.article-body :global(.sr-only) {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

.article-body :global(figure.code-file) {
  margin: 1em 0;
}

.article-body :global(.code-file > pre) {
  margin: 0;
}

.article-body :global(.code-file > figcaption) {
  position: relative;
  min-height: 34px;
  box-sizing: border-box;
  padding: 9px 14px 9px 79px;
  background: var(--inv);
  color: var(--invmuted);
  font-family: var(--font-mono);
  font-size: 12px;
  line-height: 16px;
  overflow-wrap: anywhere;
}

.article-body :global(.code-file > figcaption)::before {
  content: "";
  position: absolute;
  top: 11.5px;
  left: 14px;
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: var(--pink);
  box-shadow:
    19px 0 0 var(--orange),
    38px 0 0 var(--green);
}

.article-body :global(.youtube-embed) {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  margin-block: 1.5em;
  border: 0;
  border-radius: 4px;
  background: var(--ph);
  box-shadow: 3px 3px 0 var(--shadow);
}
</style>
