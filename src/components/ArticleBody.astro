---
/**
 * Wraps rendered Markdown (an article's `<Content />`) and sets its type: body text, headings
 * (h2 to h4, with the marks `##` and `###` before h2 and h3), paragraphs, `strong`, inline code,
 * lists, block quotes, images and horizontal rules. The type is 16px below 768px and 17px from
 * 768px. It also styles the other elements that Sätteri and the plugins in src/markdown/ output:
 * GFM tables, task lists, footnotes, YouTube embeds and links. A link is underlined, because
 * `global.css` leaves a link plain and the text color alone would not set it apart (WCAG 1.4.1).
 * It styles the accordion too, a `<details>` with its `<summary>` that an article writes as raw
 * HTML: the window of `.win` (shared in `window.css`) with a `<summary>` of at least 48px in
 * JetBrains Mono, whose mark is a plus while the accordion is closed and a minus while it is
 * open. The browser opens and closes it, without script. It styles the message boxes too,
 * `<aside class="note">` and `<aside class="warning">` written as raw HTML, which take the ground
 * and the ring of `.win` from `window.css` and the look of their label from `labels.css`. A box
 * with the class `face` too shows the thinking face of `src/assets/hate.webp` at its left, as a
 * CSS background, so it adds no `<img>` and screen readers skip it: 52 by 70px with a 12px gap
 * below 768px, and 72 by 96px with a 16px gap from 768px. The
 * rules reach those elements through `:global()` under `.article-body`, so they apply only inside
 * this wrapper. The wrapper sets no width: the page around it decides the column. The windows of
 * code blocks are styled by the imported src/markdown/highlight.css, whose rules match
 * `figure.code-window` and `pre.shiki`.
 */
import "../markdown/highlight.css";
// The `face` background below is a `url()` in CSS, which Astro does not count as a use of the
// image, so the build would delete the original file. This import keeps it.
import "../assets/hate.webp?url";
---

<div class="article-body"><slot /></div>

<style>
.article-body :global(a) {
  text-decoration-line: underline;
  text-underline-offset: 4px;
}

/* Body text and the elements that plain Markdown outputs. */
.article-body {
  --block-gap: 1.4em;
  color: var(--text);
  font-size: 16px;
  font-weight: 400;
  line-height: 2;
  text-wrap: pretty;
  overflow-wrap: anywhere;
}

.article-body > :global(:first-child) {
  margin-top: 0;
}

.article-body :global(p) {
  margin: 0 0 var(--block-gap);
}

.article-body :global(:is(h2, h3, h4)) {
  font-weight: 900;
}

.article-body :global(:is(h2, h3)::before) {
  display: inline-block;
  color: var(--keyword);
  font-family: var(--font-mono);
  font-weight: 800;
}

.article-body :global(h2) {
  margin: 2em 0 0.7em;
  font-size: 22px;
  line-height: 1.45;
}

.article-body :global(h2::before) {
  content: "##" / "";
  margin-inline-end: 10px;
  font-size: 15px;
}

.article-body :global(h3) {
  margin: 1.8em 0 0.6em;
  font-size: 18px;
  line-height: 1.5;
}

.article-body :global(h3::before) {
  content: "###" / "";
  margin-inline-end: 8px;
  font-size: 13px;
}

.article-body :global(h4) {
  margin: 1.6em 0 0.5em;
  font-size: 16px;
  line-height: 1.6;
}

.article-body :global(strong) {
  font-weight: 700;
  background: linear-gradient(
    transparent 64%,
    color-mix(in srgb, var(--keyword) 45%, transparent) 64%
  );
}

.article-body :global(:not(pre) > code) {
  padding: 2px 5px;
  border: 1px solid var(--line);
  border-radius: 3px;
  background: var(--panel);
  color: var(--text);
  font-family: var(--font-mono);
  font-size: 0.86em;
}

.article-body :global(:is(ul, ol)) {
  margin: 0 0 var(--block-gap);
  padding-inline-start: 1.5em;
}

.article-body :global(ul) {
  list-style-type: square;
}

.article-body :global(ol) {
  padding-inline-start: 2em;
}

.article-body :global(li + li) {
  margin-top: 0.25em;
}

.article-body :global(li > :is(ul, ol)) {
  margin: 0.25em 0 0;
}

.article-body :global(li::marker) {
  color: var(--muted);
}

.article-body :global(ol > li::marker) {
  font-family: var(--font-mono);
}

.article-body :global(blockquote) {
  margin: 0 0 var(--block-gap);
  padding-inline-start: 1em;
  border-inline-start: 3px solid var(--line2);
  color: var(--muted);
}

.article-body :global(:is(blockquote, li) > :last-child) {
  margin-bottom: 0;
}

.article-body :global(hr) {
  height: 1px;
  margin: 3em 0;
  border: 0;
  background: var(--line);
}

.article-body :global(img) {
  display: block;
  max-width: 100%;
  height: auto;
  max-height: 80svh;
  object-fit: contain;
  margin: 0 auto var(--block-gap);
  border-radius: 6px;
}

.article-body :global(table) {
  display: block;
  max-width: 100%;
  margin: 0 0 var(--block-gap);
  overflow-x: auto;
  overflow-wrap: normal;
  border-collapse: collapse;
}

.article-body :global(th),
.article-body :global(td) {
  padding: 0.5em 0.75em;
  border-bottom: 1px solid var(--line);
  text-align: start;
  min-width: 4em;
}

.article-body :global(th) {
  border-bottom-color: var(--line2);
  background: var(--panel);
  font-weight: 700;
  white-space: nowrap;
}

.article-body :global(:is(th, td).align-left) {
  text-align: left;
}

.article-body :global(:is(th, td).align-center) {
  text-align: center;
}

.article-body :global(:is(th, td).align-right) {
  text-align: right;
}

.article-body :global(.contains-task-list) {
  padding-inline-start: 1.5em;
}

.article-body :global(.task-list-item) {
  list-style: none;
}

.article-body :global(.task-list-item > input) {
  margin: 0 0.5em 0 -1.5em;
  accent-color: var(--acc-text);
}

.article-body :global(.footnotes) {
  margin-top: 3em;
  padding-top: 1em;
  border-top: 1px solid var(--line);
  color: var(--muted);
  font-size: 0.875em;
}

.article-body :global(.sr-only) {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

.article-body :global(.youtube-embed) {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  box-sizing: border-box;
  margin-block: 0 var(--block-gap);
  border: 1px solid var(--line2);
  border-radius: 6px;
  background: var(--panel);
}

.article-body :global(details) {
  box-sizing: border-box;
  margin: 0 0 1.4em;
  padding: 0 16px;
}

.article-body :global(details[open]) {
  padding-bottom: 12px;
}

.article-body :global(summary) {
  position: relative;
  display: block;
  box-sizing: border-box;
  min-height: 48px;
  margin-inline: -16px;
  padding: 14px 44px 14px 16px;
  font-family: var(--font-mono);
  font-size: 13px;
  line-height: 20px;
  cursor: pointer;
  list-style: none;
}

.article-body :global(summary::-webkit-details-marker) {
  display: none;
}

.article-body :global(summary::after) {
  content: "+" / "";
  position: absolute;
  top: 50%;
  right: 16px;
  translate: 0 -50%;
  color: var(--muted);
  font-size: 16px;
  line-height: 1;
}

.article-body :global(details[open] > summary::after) {
  content: "\2212" / "";
}

.article-body :global(details > summary + *) {
  margin-top: 0;
}

.article-body :global(details > :last-child) {
  margin-bottom: 0;
}

/* From 768px the type is larger, as in the PC article of the design. */
@media (min-width: 768px) {
  .article-body {
    --block-gap: 1.5em;
    font-size: 17px;
    line-height: 2.05;
  }

  .article-body :global(h2) {
    margin: 2.2em 0 0.8em;
    font-size: 28px;
    line-height: 1.4;
  }

  .article-body :global(h2::before) {
    margin-inline-end: 12px;
    font-size: 18px;
  }

  .article-body :global(h3) {
    margin: 2em 0 0.7em;
    font-size: 21px;
  }

  .article-body :global(h3::before) {
    margin-inline-end: 10px;
    font-size: 14px;
  }

  .article-body :global(h4) {
    margin: 1.8em 0 0.5em;
    font-size: 17px;
  }

  .article-body :global(:not(pre) > code) {
    padding: 2px 6px;
  }

  .article-body :global(details) {
    margin-bottom: 1.6em;
  }
}

/* Message boxes: `<aside class="note">` and `<aside class="warning">`. The ground and ring come
   from window.css and the look of the label from labels.css. */
.article-body :global(aside:is(.note, .warning)) {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
  margin: 0 0 1.4em;
  padding: 12px 14px;
  font-weight: 700;
}

.article-body :global(aside:is(.note, .warning) > *) {
  margin: 0;
  font-size: 14px;
  line-height: 1.7;
}

.article-body :global(aside:is(.note, .warning) > * + *) {
  margin-top: 0.6em;
}

/* The label is a generated `::after`, because `.win::before` draws the ring. */
.article-body :global(aside.note::after) {
  content: "# note" / "note";
}

.article-body :global(aside.warning::after) {
  content: "# warning" / "warning";
}

.article-body :global(aside:is(.note, .warning)::after) {
  order: -1;
  color: var(--acc-text);
  font-weight: 400;
}

/* A warning has diagonal stripes at the top, as `.stripes` in window.css does (a 40px period
   across), and 6px of padding more to keep the text under them. */
.article-body :global(aside.warning) {
  --stripes:
    repeating-linear-gradient(
      -45deg,
      var(--keyword) 0 14.14px,
      var(--ink) 14.14px 28.28px
    )
    top / 100% 6px no-repeat;

  padding-top: 18px;
  background: var(--stripes), var(--panel);
}

/* The face of `face`: a background layer above the ground, centered on the box. A warning keeps
   its stripes above the face. The image is 453 by 600px, so the 3:4 box scales it by 0.7%. */
.article-body :global(aside:is(.note, .warning).face) {
  --face: url("../assets/hate.webp") 14px center / 52px 70px no-repeat;

  justify-content: center;
  min-height: 70px;
  padding-left: 78px;
  background: var(--face), var(--panel);
}

.article-body :global(aside.warning.face) {
  background: var(--stripes), var(--face), var(--panel);
}

@media (min-width: 768px) {
  .article-body :global(aside:is(.note, .warning).face) {
    --face: url("../assets/hate.webp") 20px center / 72px 96px no-repeat;

    min-height: 96px;
    padding-left: 108px;
  }

  .article-body :global(aside:is(.note, .warning)) {
    margin-bottom: 1.6em;
    padding: 16px 20px;
  }

  .article-body :global(aside:is(.note, .warning) > *) {
    font-size: 15px;
    line-height: 1.8;
  }

  .article-body :global(aside.warning) {
    padding-top: 22px;
  }
}
</style>
