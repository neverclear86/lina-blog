---
/**
 * The main part of a page of blog posts, `/blog/` or a tag's page `/blog/tags/<slug>/`: the head
 * (`PageHead`) with the breadcrumb (`Breadcrumb`), the `h1` and the tag filter, and below it the
 * posts as `PostRows`. Both kinds of page share this layout, so the filter and the rows stay in
 * place.
 *
 * The breadcrumb ends with the current page, which is not a link. The tag filter is a row of
 * `.ws` links to `/blog/` and the page of each tag, without JavaScript. The last element of the
 * breadcrumb and the filter link to the current page have `aria-current="page"`. The page is in
 * Japanese only.
 */
import type { ComponentProps } from "astro/types";
import { blogCrumbs, blogListText, tagFilterLinks } from "../../blog-pages";
import { translate } from "../../i18n/ui";
import type { BlogTag } from "../../latest-posts";
import Breadcrumb from "../site/Breadcrumb.astro";
import PageHead from "../site/PageHead.astro";
import PostRows from "./PostRows.astro";

interface Props {
  /** Tag of the page, or undefined for `/blog/`, which lists every post. */
  tag?: BlogTag;
  /** Posts of the page, newest first. */
  posts: ComponentProps<typeof PostRows>["posts"];
}

const { tag, posts } = Astro.props;
const text = blogListText(tag);
const crumbs = blogCrumbs(tag);
---

<main id="main" tabindex="-1">
  <PageHead>
    <Breadcrumb lang="ja" items={crumbs} />
    <h1>{translate("ja", text.subtitle)}</h1>
    <nav class="filter" aria-label={translate("ja", "blog.filter.label")}>
      <ul>
        {tagFilterLinks(tag).map((link) => (
  <li>
    <a
      class:list={["ws", { on: link.current }]}
      href={link.href}
      aria-current={link.current ? "page" : undefined}
    >
      {translate("ja", link.key)}
    </a>
  </li>
))}
      </ul>
    </nav>
  </PageHead>
  <div class="list page-width">
    <PostRows
      path={text.label}
      posts={posts}
      emptyText={translate("ja", text.noPosts)}
    />
  </div>
</main>

<style>
.filter ul {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.filter .ws {
  height: 36px;
}

.list {
  padding-block: 24px 56px;
}

@media (min-width: 768px) {
  .filter .ws {
    height: 30px;
  }

  .list {
    padding-block: 40px 72px;
  }
}

@media (min-width: 900px) {
  .list {
    padding-block: 56px 96px;
  }
}
</style>
