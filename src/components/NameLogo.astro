---
/**
 * The name logo `/tsukusu/lina $_` of the brand kit, drawn inline in one of three forms:
 * `compact` is `/lina $_` (`t3_compact`), `full` is `/tsukusu/lina $_` (`t3_full`), and `full-sub`
 * is `full` with the line `# 創好リナ ── VIRTUAL IKIRI PROGRAMMER` under it, whose `──` is a rule
 * (`t3_full_sub`). The paths are the ones in `name-logo/svg/transparent/` of the kit, as they
 * are, except that `fill` is replaced by a class that paints with a token, so that the colors
 * follow the theme as the `for-dark` and `for-light` files do: `.n` (`--lg-n`) for `lina` and
 * `創好リナ`, `.c` (`--lg-c`) for `tsukusu`, `$`, `#` and `VIRTUAL IKIRI PROGRAMMER`, `.r`
 * (`--lg-r`) for the rule, and `.k` (`--keyword`) for the slashes, the dot of the `i` and the
 * cursor.
 *
 * The cursor `_` has the class `cur` in every form, so that a parent can make it blink with
 * `:global(.cur)`. The component does not animate it.
 *
 * The SVG fills the width of its parent, so the parent sets the size. The kit's smallest size is
 * a slash 32px high for `full` and `full-sub` (a width of 296px) and 16px for `compact` (71px).
 * Keep a clear space of 3u (96 units of the SVG, of which the `viewBox` holds 16) around it.
 */
interface Props {
  /** Form of the logo. */
  variant: "compact" | "full" | "full-sub";
  /**
   * Accessible name. When given, the SVG is an image with this name; otherwise it is hidden
   * from assistive technology, for a logo inside a link or heading that already has a name.
   */
  label?: string;
}

const { variant, label } = Astro.props;
const VIEW_BOX = {
  compact: "-16.0 -203.0 941.0 245.4",
  full: "-16.0 -203.0 1972.8 245.4",
  "full-sub": "-16.0 -203.0 1972.8 361.2",
};
---

