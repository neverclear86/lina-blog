---
/**
 * The contact section of the top page, `#contact` in `design/CBMain.dc.html`: the heading and
 * the lead on `--cbg`, and the contact form in a paper terminal window.
 *
 * The form posts `kind`, `name`, `email` and `message`, the body of `POST /api/contact`, and
 * takes the choices of `kind` from `CONTACT_KINDS` and the `maxlength` of the text fields from
 * `CONTACT_LIMITS`. Every field is required and has its own `<label>`.
 *
 * From 1280px the heading and the form sit side by side; below that the form goes under the
 * heading, at most 640px wide. Below 768px the name and the email go on separate rows.
 */
import { CONTACT_KINDS, CONTACT_LIMITS } from "../contact";
import type { Locale } from "../i18n/locales";
import { translate } from "../i18n/ui";
import Button from "./Button.astro";
import PixelArt from "./PixelArt.astro";
import SectionHeading from "./SectionHeading.astro";
import TerminalCard from "./TerminalCard.astro";

interface Props {
  /** Language of the page, for the strings from `src/i18n/ui.ts`. */
  lang: Locale;
}

const { lang } = Astro.props;
const t = (key: Parameters<typeof translate>[1]) => translate(lang, key);
---

<section id="contact" class="cgrid contact">
  <div class="intro">
    <SectionHeading
      label="$ mail lina"
      title="CONTACT"
      subtitle={t("contact.subtitle")}
      variant="contact"
    />
    <p class="lead">{t("contact.lead")}</p>
  </div>
  <div class="window">
    <div class="pixel"><PixelArt bob /></div>
    <TerminalCard
      title="new-message.txt"
      shape="shapeL"
      shadow="fshadow"
      tone="paper"
      lift={false}
    >
      <form class="form" method="post" action="/api/contact">
        <div class="field">
          <label for="contact-kind">{t("contact.kind")}</label>
          <select id="contact-kind" name="kind" required>
            {CONTACT_KINDS.map((kind) => (
  <option value={kind}>{t(`contact.kind.${kind}`)}</option>
))}
          </select>
        </div>
        <div class="pair">
          <div class="field">
            <label for="contact-name">{t("contact.name")}</label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              maxlength={CONTACT_LIMITS.name}
              required
            >
          </div>
          <div class="field">
            <label for="contact-email">{t("contact.email")}</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              maxlength={CONTACT_LIMITS.email}
              required
            >
          </div>
        </div>
        <div class="field">
          <label for="contact-message">{t("contact.message")}</label>
          <textarea
            id="contact-message"
            name="message"
            rows="6"
            maxlength={CONTACT_LIMITS.message}
            required
          ></textarea>
        </div>
        <div class="actions">
          <span class="note"
            >{t("contact.note")} <span class="note-kao">(๑•̀ㅂ•́)و✧</span></span
          >
          <div class="submit">
            <Button size="lg" shadow="ink" type="submit">
              {t("contact.submit")}
            </Button>
          </div>
        </div>
      </form>
    </TerminalCard>
  </div>
</section>

<style>
.contact {
  --focus-ring: var(--cfg);
  display: grid;
  gap: 40px;
  padding: 64px 18px 40px;
  background-color: var(--cbg);
  color: var(--cfg);
}

@media (min-width: 768px) {
  .contact {
    padding: 88px 64px 40px;
  }
}

@media (min-width: 1280px) {
  .contact {
    grid-template-columns: minmax(0, 1fr) 640px;
    gap: 80px;
    align-items: start;
  }
}

.intro {
  display: flex;
  flex-direction: column;
  gap: 28px;
  min-width: 0;
}

.lead {
  margin: 0;
  max-width: 500px;
  font-size: 17px;
  font-weight: 500;
  line-height: 1.85;
}

.window {
  position: relative;
  max-width: 640px;
  margin-top: 60px;
}

.pixel {
  position: absolute;
  right: 100px;
  top: -62px;
  display: flex;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding: 24px 16px 28px;
}

@media (min-width: 768px) {
  .form {
    padding: 36px 40px 40px;
  }
}

.pair {
  display: grid;
  gap: 20px;
}

@media (min-width: 768px) {
  .pair {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
}

label,
.note {
  font-size: 14px;
  font-weight: 900;
}

select,
input,
textarea {
  font: inherit;
  font-size: 15px;
  font-weight: 500;
  box-sizing: border-box;
  width: 100%;
  border: 1.5px solid var(--ink);
  border-radius: 3px;
  background: var(--field);
  color: var(--ink);
}

select,
input {
  height: 48px;
  padding: 0 12px;
}

textarea {
  padding: 12px;
  resize: vertical;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.note-kao {
  white-space: nowrap;
}

.submit {
  margin-left: auto;
}
</style>
