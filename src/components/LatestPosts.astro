---
/**
 * The blog section of the home page (`03 blog`): the heading, then the newest
 * `LATEST_POSTS_SHOWN` posts in a `PostRows` window with the command `$ ls -lt ~/blog | head -3`.
 * The root has `id="blog"` unless `id` is given. It puts 56px above the heading, 96px from
 * 768px, so that the section that holds it adds no margin.
 *
 * From 768px the command line ends with a link to `/blog/`; below 768px the command loses
 * ` | head -3` and the link is left out, as the navigation of the header links to the list.
 * Without posts, the link is left out at any width.
 */
import type { ComponentProps } from "astro/types";
import type { Locale } from "../i18n/locales";
import { translate } from "../i18n/ui";
import { newestPosts } from "../latest-posts";
import PostRows from "./PostRows.astro";
import SectionTitle from "./SectionTitle.astro";

interface Props {
  /** Language of the page, for the strings and the tag labels. */
  lang: Locale;
  /** Posts of the `blog` collection, in any order. */
  posts: ComponentProps<typeof PostRows>["posts"];
  /** `id` of the root. A page that shows the section more than once gives each its own. */
  id?: string;
}

/** Number of posts shown, as in `design/Main.dc.html`. */
const LATEST_POSTS_SHOWN = 3;

const { lang, posts, id = "blog" } = Astro.props;
const latest = newestPosts(posts, LATEST_POSTS_SHOWN);
---

<section id={id} class="latest-posts">
  <SectionTitle
    no="03"
    label="blog"
    path="~/blog"
    title={translate(lang, "latest.blog.title")}
  />
  <PostRows
    path="~/blog"
    posts={latest}
    emptyText={translate(lang, "latest.blog.noPosts")}
    lang={lang}
  >
    <span slot="command" class="limit">{" | head -3"}</span>
    {latest.length > 0 && (
  <a
    slot="action"
    class="all"
    href="/blog/"
    hreflang={lang === "ja" ? undefined : "ja"}
  >
    {translate(lang, "latest.blog.all")} <span aria-hidden="true">→</span>
  </a>
)}
  </PostRows>
</section>

<style>
.latest-posts {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-top: 56px;
}

.limit {
  display: none;
}

@media (min-width: 768px) {
  .latest-posts {
    gap: 40px;
    margin-top: 96px;
  }

  .limit {
    display: inline;
  }

  .all {
    display: block;
    line-height: 44px;
    white-space: nowrap;
  }
}
</style>
