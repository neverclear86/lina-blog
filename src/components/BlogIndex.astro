---
/**
 * The main part of a page of blog posts, `/blog/` or a tag's page `/blog/tags/<slug>/`: the head
 * (`PageHead`) with the breadcrumb, the `h1` and the tag filter, and below it the posts as
 * `PostList`. Both kinds of page share this layout, so the filter and the cards stay in place.
 *
 * The breadcrumb ends with the current page, which is not a link. The tag filter is a row of
 * `.ws` links to `/blog/` and the page of each tag, without JavaScript. The last element of the
 * breadcrumb and the filter link to the current page have `aria-current="page"`. The page is in
 * Japanese only.
 */
import type { ComponentProps } from "astro/types";
import { blogCrumbs, blogListText, tagFilterLinks } from "../blog-pages";
import { translate } from "../i18n/ui";
import type { BlogTag } from "../latest-posts";
import PageHead from "./PageHead.astro";
import PostList from "./PostList.astro";

interface Props {
  /** Tag of the page, or undefined for `/blog/`, which lists every post. */
  tag?: BlogTag;
  /** Posts of the page, newest first. */
  posts: ComponentProps<typeof PostList>["posts"];
}

const { tag, posts } = Astro.props;
const text = blogListText(tag);
const crumbs = blogCrumbs(tag);
---

<main>
  <PageHead>
    <nav class="crumbs" aria-label={translate("ja", "nav.breadcrumb")}>
      {crumbs.map((crumb, index) => (
  <>
    {index > 0 && <span aria-hidden="true">/</span>}
    {crumb.href === undefined ? (
      <span aria-current={index === crumbs.length - 1 ? "page" : undefined}>
        {crumb.text}
      </span>
    ) : (
      <a href={crumb.href}>{crumb.text}</a>
    )}
  </>
))}
    </nav>
    <h1>{translate("ja", text.subtitle)}</h1>
    <nav class="filter" aria-label={translate("ja", "blog.filter.label")}>
      <ul>
        {tagFilterLinks(tag).map((link) => (
  <li>
    <a
      class:list={["ws", { on: link.current }]}
      href={link.href}
      aria-current={link.current ? "page" : undefined}
    >
      {translate("ja", link.key)}
    </a>
  </li>
))}
      </ul>
    </nav>
  </PageHead>
  <div class="list">
    <PostList posts={posts} emptyText={translate("ja", text.noPosts)} />
  </div>
</main>

<style>
.crumbs {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--muted);
}

.crumbs a {
  padding-block: 4px;
}

.crumbs [aria-current="page"] {
  padding-block: 4px;
  color: var(--text);
}

.filter ul {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.filter .ws {
  height: 36px;
}

.list {
  box-sizing: border-box;
  max-width: 1440px;
  margin: 0 auto;
  padding: 24px 16px 56px;
}

@media (min-width: 768px) {
  .crumbs {
    font-size: 13px;
  }

  .filter .ws {
    height: 30px;
  }

  .list {
    padding: 40px 20px 72px;
  }
}

@media (min-width: 900px) {
  .list {
    padding: 56px 64px 96px;
  }
}
</style>
