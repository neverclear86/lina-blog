---
/**
 * About のターミナル窓カード（lina.png）の中身として置く全身の画像なので、alt を付ける。
 * スクロールした先に置く画像なので、既定の遅延読み込みのままにする。
 * 親の入れ物の幅いっぱいに描く。sizes はデザインのカードの表示幅（151px）に合わせてあるので、
 * 表示幅を変えるときは widths と sizes も合わせる。
 */
import { Picture } from "astro:assets";
import fullBody from "../assets/lina-full-body.webp";
---

<Picture
  src={fullBody}
  alt="創好リナの全身"
  formats={["avif", "webp"]}
  fallbackFormat="webp"
  widths={[151, 302, 453]}
  sizes="151px"
  class="about-full-body"
/>

<style>
.about-full-body {
  display: block;
  width: 100%;
  height: auto;
}
</style>
