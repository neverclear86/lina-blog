---
/**
 * The button that switches between the light and dark themes, the icon button in the headers
 * of `design/CBMain.dc.html` and `design/CBMobile.dc.html`. It shows the moon in the light
 * theme and the sun in the dark theme, and its name says which theme a click switches to. CSS
 * picks the icon and the name from `<html data-theme>`, which `THEME_SCRIPT` in `src/theme.ts`
 * sets before the first paint, so they match the theme from then on. A click runs `toggleTheme`.
 * The icon is 18px below 768px and 20px from 768px.
 */
import type { Locale } from "../i18n/locales";
import { translate } from "../i18n/ui";
import IconButton from "./IconButton.astro";

interface Props {
  /** Language of the button's name. */
  lang: Locale;
}

const { lang } = Astro.props;
---

<IconButton class="theme-toggle">
  <svg
    class="moon"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"></path>
  </svg>
  <svg
    class="sun"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <Fragment slot="label"
    ><span class="to-dark">{translate(lang, "theme.toDark")}</span
    ><span class="to-light">{translate(lang, "theme.toLight")}</span></Fragment
  >
</IconButton>

<script>
import { toggleTheme } from "../theme";

for (const button of document.querySelectorAll(".theme-toggle")) {
  button.addEventListener("click", () => {
    toggleTheme(document.documentElement, () => localStorage);
  });
}
</script>

<style>
.sun,
.to-light {
  display: none;
}

:global(:root[data-theme="dark"]) .moon,
:global(:root[data-theme="dark"]) .to-dark {
  display: none;
}

:global(:root[data-theme="dark"]) .sun {
  display: block;
}

:global(:root[data-theme="dark"]) .to-light {
  display: inline;
}

svg {
  width: 18px;
  height: 18px;
}

@media (min-width: 768px) {
  svg {
    width: 20px;
    height: 20px;
  }
}
</style>
