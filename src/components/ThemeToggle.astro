---
/**
 * The button that switches between the light and dark themes. CSS picks what it shows from
 * `<html data-theme>`, which `THEME_SCRIPT` in `src/theme.ts` sets before the first paint, so it
 * matches the theme from then on. A click runs `toggleTheme`.
 *
 * `variant="icon"` is the icon button of the header of `design/AMobile.dc.html`: a `.iconbtn`
 * (`src/styles/controls.css`) with an 18px icon, the moon in the light theme and the sun in the
 * dark theme. Its name is hidden text that says which theme a click switches to.
 *
 * `variant="labeled"` is the button of the header of `design/Main.dc.html`: a sun and the name
 * of the current theme, `dark` or `light`. Its name is that text, the hidden text
 * `theme.nameSeparator` and the name of the theme a click switches to.
 */
import type { Locale } from "../i18n/locales";
import { translate } from "../i18n/ui";

interface Props {
  /** Language of the button's name. */
  lang: Locale;
  /** Look of the button. Defaults to "icon". */
  variant?: "icon" | "labeled";
}

const { lang, variant = "icon" } = Astro.props;
---

{variant === "labeled" ? (
  <button class="theme-toggle iconbtn labeled" type="button">
    <svg
      class="labeled-sun"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
    <span class="now-light">
      light
      <span class="sr-only">
        {translate(lang, "theme.nameSeparator")}
        {translate(lang, "theme.toDark")}
      </span>
    </span>
    <span class="now-dark">
      dark
      <span class="sr-only">
        {translate(lang, "theme.nameSeparator")}
        {translate(lang, "theme.toLight")}
      </span>
    </span>
  </button>
) : (
  <button class="theme-toggle iconbtn" type="button">
    <svg
      class="moon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"></path>
    </svg>
    <svg
      class="sun"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
    <span class="sr-only">
      <span class="to-dark">{translate(lang, "theme.toDark")}</span>
      <span class="to-light">{translate(lang, "theme.toLight")}</span>
    </span>
  </button>
)}

<script>
import { toggleTheme } from "../theme";

for (const button of document.querySelectorAll(".theme-toggle")) {
  button.addEventListener("click", () => {
    toggleTheme(document.documentElement, () => localStorage);
  });
}
</script>

<style>
.sun,
.to-light {
  display: none;
}

:global(:root[data-theme="dark"]) .moon,
:global(:root[data-theme="dark"]) .to-dark {
  display: none;
}

:global(:root[data-theme="dark"]) .sun {
  display: block;
}

:global(:root[data-theme="dark"]) .to-light {
  display: inline;
}

.labeled {
  position: relative;
  width: auto;
  min-width: 44px;
  padding: 0 10px;
  gap: 8px;
  font: 12px var(--font-mono);
}

.labeled-sun {
  width: 16px;
  height: 16px;
  flex: none;
}

.now-dark {
  display: none;
}

:global(:root[data-theme="dark"]) .now-light {
  display: none;
}

:global(:root[data-theme="dark"]) .now-dark {
  display: inline;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}
</style>
