---
/**
 * The button that switches between the light and dark themes. CSS picks what it shows from
 * `<html data-theme>`, which `THEME_SCRIPT` in `src/theme.ts` sets before the first paint, so it
 * matches the theme from then on. A click runs `toggleTheme`.
 *
 * It is an `.iconbtn` (`src/styles/controls.css`), 44px square at every width, with an 18px icon
 * that shows the current theme: the moon in the dark theme and the sun in the light theme. Both
 * icons are in the same box, so a switch does not change the size of the button. Its name is
 * hidden text that says which theme a click switches to.
 */
import type { Locale } from "../i18n/locales";
import { translate } from "../i18n/ui";

interface Props {
  /** Language of the button's name. */
  lang: Locale;
}

const { lang } = Astro.props;
---

<button class="theme-toggle iconbtn" type="button">
  <svg
    class="moon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"></path>
  </svg>
  <svg
    class="sun"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <span class="sr-only">
    <span class="to-dark">{translate(lang, "theme.toDark")}</span>
    <span class="to-light">{translate(lang, "theme.toLight")}</span>
  </span>
</button>

<script>
import { toggleTheme } from "../theme";

for (const button of document.querySelectorAll(".theme-toggle")) {
  button.addEventListener("click", () => {
    toggleTheme(document.documentElement, () => localStorage);
  });
}
</script>

<style>
.moon,
.to-light {
  display: none;
}

:global(:root[data-theme="dark"]) .sun,
:global(:root[data-theme="dark"]) .to-dark {
  display: none;
}

:global(:root[data-theme="dark"]) .moon {
  display: block;
}

:global(:root[data-theme="dark"]) .to-light {
  display: inline;
}
</style>
