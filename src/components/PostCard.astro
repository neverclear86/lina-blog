---
/**
 * A card for one blog post in a list of posts: the emoji of the post on a square tile at the
 * left, and the title, the date and the tag chips at the right. A post with `sponsor` gets a
 * "PR" chip after the tags.
 *
 * The whole card is a link to `/blog/<slug>/` of three layers, `<a>` > shadow and `.lift` >
 * notched shape (`src/styles/shapes.css`), so the chips are not links. The emoji is hidden from
 * assistive technology, so the link name starts with the title. The layers fill the height of
 * their parent, so cards in a grid row have the same height.
 */
import type { BlogFrontmatter } from "../blog-schema";
import { tagChipTone } from "../latest-posts";
import { formatVideoDate } from "../latest-videos";
import Chip from "./Chip.astro";

interface Props {
  /** The post, such as an entry of the `blog` collection. */
  post: {
    data: Pick<
      BlogFrontmatter,
      "title" | "slug" | "date" | "tags" | "emoji" | "sponsor"
    >;
  };
  /** Classes for the `<a>`, such as `is-focus` for a sample. */
  class?: string;
}

const { post, class: className } = Astro.props;
const { data } = post;
---

<a href={`/blog/${data.slug}/`} class:list={["link", className]}>
  <div class="shadow lift frame">
    <div class="shape card">
      <span class="tile shapeS" aria-hidden="true">{data.emoji}</span>
      <div class="body">
        <h2 class="title">{data.title}</h2>
        <div class="meta">
          <time datetime={data.date.toISOString()}
            >{formatVideoDate(data.date)}</time
          >
          {data.tags.map((tag) => <Chip tone={tagChipTone(tag)}>{tag}</Chip>)}
          {data.sponsor && <Chip tone="pink">PR</Chip>}
        </div>
      </div>
    </div>
  </div>
</a>

<style>
.link {
  display: block;
  height: 100%;
  color: inherit;
  text-decoration: none;
}

.frame {
  height: 100%;
}

.card {
  box-sizing: border-box;
  height: 100%;
  display: grid;
  grid-template-columns: 56px minmax(0, 1fr);
  column-gap: 14px;
  align-items: start;
  padding: 20px 22px;
  background: var(--surf);
  color: var(--fg);
}

.tile {
  display: grid;
  place-items: center;
  width: 56px;
  height: 56px;
  background: var(--ph);
  font-size: 32px;
  line-height: 1;
}

.title {
  margin: 0;
  font-size: 17px;
  font-weight: 900;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-top: 10px;
}

time {
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: 12px;
}

@media (min-width: 768px) {
  .card {
    grid-template-columns: 72px minmax(0, 1fr);
    column-gap: 18px;
  }

  .tile {
    width: 72px;
    height: 72px;
    font-size: 40px;
  }

  .title {
    font-size: 19px;
  }
}
</style>
