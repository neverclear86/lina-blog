---
/**
 * The Latest section of the home page, on the `--bg2` ground of plan A: the heading bar
 * (`02` / `latest` / `~/latest`) with the heading `latest.title`, then a grid of the
 * `video-feature` slot and the `video-list` slot, then the `blog` slot.
 *
 * The grid is one column below 1280px. From 1280px the `video-feature` slot takes two thirds
 * and the `video-list` slot one third. The slots are the grid items themselves, so the root
 * element of a slot can hide itself and leave no gap. The `blog` slot sits under the grid, 56px
 * below it (96px from 768px). A slot left empty leaves the heading and the rest in place.
 *
 * The content is at most 1440px wide and centered, and the ground fills the width. The side
 * padding is 16px, 20px from 768px and 64px from 900px.
 */
import type { Locale } from "../i18n/locales";
import { translate } from "../i18n/ui";
import SectionTitle from "./SectionTitle.astro";

interface Props {
  /** Locale of the page, which chooses the heading. */
  lang: Locale;
}

const { lang } = Astro.props;
---

<section id="latest">
  <div class="inner">
    <div class="head">
      <SectionTitle
        no="02"
        label="latest"
        path="~/latest"
        title={translate(lang, "latest.title")}
      />
    </div>
    <div class="windows">
      <slot name="video-feature" />
      <slot name="video-list" />
    </div>
    <div class="blog">
      <slot name="blog" />
    </div>
  </div>
</section>

<style>
#latest {
  border-top: 1px solid var(--line);
  background: var(--bg2);
}

.inner {
  box-sizing: border-box;
  max-width: 1440px;
  margin-inline: auto;
  padding: 48px 16px;
}

.head {
  margin-bottom: 16px;
}

.windows {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 14px;
}

.windows > :global(*) {
  min-width: 0;
}

.blog {
  margin-top: 56px;
}

@media (min-width: 768px) {
  .inner {
    padding: 100px 20px;
  }

  .head {
    margin-bottom: 40px;
  }

  .blog {
    margin-top: 96px;
  }
}

@media (min-width: 900px) {
  .inner {
    padding-inline: 64px;
  }
}

@media (min-width: 1280px) {
  .windows {
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
  }
}
</style>
