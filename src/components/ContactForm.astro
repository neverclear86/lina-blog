---
/**
 * The contact form in a window of plan A, `new-message.txt`: the topic, the name, the email
 * address and the message, each with its own `<label>`, then the Turnstile widget, the status
 * line and the send button. It is placed on the contact page (`src/pages/[lang]/contact/`).
 *
 * The form posts `kind`, `name`, `email`, `message` and the Turnstile token
 * `cf-turnstile-response` to `POST /api/contact`, and takes the choices of `kind` from
 * `CONTACT_KINDS` and the `maxlength` of the text fields from `CONTACT_LIMITS`. Every field is
 * required.
 *
 * The script loads Turnstile when focus first enters the form, or at the first submission, and
 * renders the widget with the site key `TURNSTILE_SITE_KEY` in the theme of the page when it is
 * rendered (`resolveTheme`); a later switch of the theme does not redraw it. It checks the
 * fields before sending, posts the form with `fetch`, and shows each `ContactFormState` in the
 * status line; rejected fields get `aria-invalid` and a text under them. While a request is in
 * flight the send button has `aria-disabled="true"` and is dimmed, and stays focusable. Without
 * JavaScript a notice says that sending needs it.
 *
 * The window is at most 760px wide. The name and the email address share a row when the window
 * is 560px wide or more.
 */
import { TURNSTILE_SITE_KEY } from "astro:env/client";
import { CONTACT_KINDS, CONTACT_LIMITS } from "../contact";
import type { Locale } from "../i18n/locales";
import { translate } from "../i18n/ui";

interface Props {
  /** Language of the page, for the strings from `src/i18n/ui.ts`. */
  lang: Locale;
}

const { lang } = Astro.props;
const t = (key: Parameters<typeof translate>[1]) => translate(lang, key);
---

<div class="win window">
  <p class="window-title">new-message.txt</p>
  <div class="body">
    <form
      class="contact-form"
      method="post"
      action="/api/contact"
      data-locale={lang}
    >
      <div class="field">
        <label for="contact-kind">{t("contact.kind")}</label>
        <select
          id="contact-kind"
          name="kind"
          aria-describedby="contact-kind-error"
          required
        >
          {CONTACT_KINDS.map((kind) => (
  <option value={kind}>{t(`contact.kind.${kind}`)}</option>
))}
        </select>
        <p id="contact-kind-error" class="error"></p>
      </div>
      <div class="pair">
        <div class="field">
          <label for="contact-name">{t("contact.name")}</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            maxlength={CONTACT_LIMITS.name}
            aria-describedby="contact-name-error"
            required
          >
          <p id="contact-name-error" class="error"></p>
        </div>
        <div class="field">
          <label for="contact-email">{t("contact.email")}</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            maxlength={CONTACT_LIMITS.email}
            aria-describedby="contact-email-error"
            required
          >
          <p id="contact-email-error" class="error"></p>
        </div>
      </div>
      <div class="field">
        <label for="contact-message">{t("contact.message")}</label>
        <textarea
          id="contact-message"
          name="message"
          rows="6"
          maxlength={CONTACT_LIMITS.message}
          aria-describedby="contact-message-error"
          required
        ></textarea>
        <p id="contact-message-error" class="error"></p>
      </div>
      <div class="check">
        <div class="turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>
        <p class="status" role="status" aria-live="polite"></p>
        <noscript><p class="noscript">{t("contact.noscript")}</p></noscript>
      </div>
      <div class="actions">
        <span class="note"
          >{t("contact.note")} <span class="note-kao">(๑•̀ㅂ•́)و✧</span></span
        >
        <button type="submit" class="btn btn-acc submit">
          {t("contact.submit")}
        </button>
      </div>
    </form>
  </div>
</div>

<style>
.window {
  max-width: 760px;
}

.window-title {
  margin: 0;
  padding: 12px 20px;
  border-bottom: 1px solid var(--line);
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--muted);
}

.body {
  container-type: inline-size;
}

.contact-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding: 20px 16px;
}

@media (min-width: 600px) {
  .contact-form {
    padding: 28px;
  }
}

.pair {
  display: grid;
  gap: 20px;
}

@container (min-width: 560px) {
  .pair {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
}

label {
  font-size: 14px;
  font-weight: 700;
  color: var(--text);
}

select,
input,
textarea {
  font: inherit;
  font-size: 15px;
  font-weight: 500;
  box-sizing: border-box;
  width: 100%;
  border: 1px solid var(--muted);
  border-radius: 4px;
  background: var(--bg);
  color: var(--text);
}

select,
input {
  height: 48px;
  padding: 0 12px;
}

textarea {
  padding: 12px;
  resize: vertical;
}

select:is(:hover, :focus),
input:is(:hover, :focus),
textarea:is(:hover, :focus) {
  border-color: var(--keyword);
}

select[aria-invalid="true"],
input[aria-invalid="true"],
textarea[aria-invalid="true"] {
  border: 2px solid var(--acc-text);
}

.error {
  margin: 0;
  font-size: 13px;
  font-weight: 700;
  color: var(--acc-text);
}

.error:empty {
  display: none;
}

.error::before {
  content: "! " / "";
}

.actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.note {
  font-size: 14px;
  color: var(--muted);
}

.note-kao {
  white-space: nowrap;
}

.submit {
  margin-left: auto;
  border: 0;
  font-family: inherit;
  cursor: pointer;
}

.submit[aria-disabled="true"] {
  opacity: 0.55;
  cursor: progress;
}

.submit[aria-disabled="true"]:is(:hover, :focus-visible) {
  background: var(--keyword);
}

.check {
  container-type: inline-size;
}

.turnstile {
  min-height: 65px;
  line-height: 0;
}

@container (width < 300px) {
  .turnstile {
    min-height: 140px;
  }
}

.status,
.noscript {
  margin: 0;
  color: var(--text);
  font-size: 14px;
  font-weight: 700;
}

.noscript {
  margin-top: 16px;
}

.status:not(:empty) {
  margin-top: 16px;
  padding: 2px 0 2px 12px;
  border-left: 3px solid var(--acc-text);
}

.status[data-state="sending"] {
  border-left-color: var(--muted);
}

.status[data-state="sent"] {
  border-left-color: var(--line2);
}
</style>

<script>
import type { ContactField } from "../contact";
import {
  type ContactFormState,
  contactFieldMessage,
  contactStateBeforeSend,
  contactStateFromFetch,
  contactStateMessage,
  turnstileSize,
} from "../contact-form";
import { DEFAULT_LOCALE, LOCALES } from "../i18n/locales";
import { resolveTheme } from "../theme";

declare global {
  interface Window {
    turnstile?: {
      render(
        el: HTMLElement,
        options: Record<string, unknown>,
      ): string | undefined;
      reset(id?: string): void;
      getResponse(id?: string): string | undefined;
    };
  }
}

const API_URL =
  "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
const FIELDS: ContactField[] = ["kind", "name", "email", "message"];

const form = document.querySelector<HTMLFormElement>("form.contact-form");
const status = form?.querySelector<HTMLElement>(".status");
const holder = form?.querySelector<HTMLElement>(".turnstile");
const button = form?.querySelector<HTMLButtonElement>("button[type=submit]");
if (form && status && holder && button) setUp(form, status, holder, button);

function setUp(
  form: HTMLFormElement,
  status: HTMLElement,
  holder: HTMLElement,
  button: HTMLButtonElement,
) {
  form.noValidate = true;
  const locale =
    LOCALES.find((l) => l === form.dataset.locale) ?? DEFAULT_LOCALE;
  let widgetId: string | undefined;
  let failed = false;
  let sending = false;

  let pending: ReturnType<typeof setTimeout> | undefined;
  const show = (state: ContactFormState) => {
    clearTimeout(pending);
    const text = contactStateMessage(locale, state);
    status.dataset.state = state.state;
    if (text !== "" && text === status.textContent) {
      status.textContent = "";
      pending = setTimeout(() => {
        status.textContent = text;
      }, 100);
    } else {
      status.textContent = text;
    }
  };
  const markField = (field: ContactField, message: string) => {
    const input = form.elements.namedItem(field) as HTMLElement;
    const error = document.getElementById(`contact-${field}-error`);
    if (!error) return;
    error.textContent = message;
    if (message) input.setAttribute("aria-invalid", "true");
    else input.removeAttribute("aria-invalid");
  };
  const markFields = (state: ContactFormState) => {
    const fields = state.state === "invalid" ? state.fields : {};
    for (const field of FIELDS) {
      const code = fields[field];
      markField(field, code ? contactFieldMessage(locale, field, code) : "");
    }
    const first = FIELDS.find((f) => fields[f]);
    if (first) (form.elements.namedItem(first) as HTMLElement).focus();
  };
  const fail = () => {
    failed = true;
    show({ state: "unavailable" });
  };

  let loading = false;
  const loadTurnstile = () => {
    if (loading) return;
    loading = true;
    const script = document.createElement("script");
    script.src = API_URL;
    script.async = true;
    script.onerror = fail;
    script.onload = () => {
      if (!window.turnstile) return fail();
      widgetId = window.turnstile.render(holder, {
        sitekey: holder.dataset.sitekey,
        theme: resolveTheme(document.documentElement.dataset.theme ?? null),
        language: locale,
        size: turnstileSize(holder.clientWidth),
        callback: () => {
          failed = false;
        },
        "error-callback": fail,
      });
    };
    document.head.append(script);
  };
  form.addEventListener("focusin", () => loadTurnstile());

  form.addEventListener("input", (event) => {
    const name = (event.target as HTMLInputElement).name;
    if ((FIELDS as string[]).includes(name))
      markField(name as ContactField, "");
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (sending) return;
    loadTurnstile();
    const data = new FormData(form);
    const before = contactStateBeforeSend(Object.fromEntries(data), {
      failed,
      token:
        widgetId === undefined
          ? undefined
          : window.turnstile?.getResponse(widgetId),
    });
    markFields(before);
    show(before);
    if (before.state !== "sending") return;
    sending = true;
    button.setAttribute("aria-disabled", "true");
    const result = await contactStateFromFetch(
      fetch(form.action, { method: "POST", body: data }),
    );
    sending = false;
    button.removeAttribute("aria-disabled");
    markFields(result);
    show(result);
    if (result.state === "sent") form.reset();
    if (result.state !== "invalid") window.turnstile?.reset(widgetId);
  });
}
</script>
