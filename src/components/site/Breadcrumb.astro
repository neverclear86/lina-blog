---
/**
 * The breadcrumb of a page, such as `~ / blog / tags / tech`: a `nav` named "Breadcrumb"
 * (`nav.breadcrumb`) with an `ol` of the items. The items are `/` apart, and the separator is
 * hidden from assistive technology, so that the list tells how many items there are.
 *
 * An item with `href` is a link; an item without it is plain text, such as a page that has no
 * address. The last item is the current page and has `aria-current="page"`, in `--text`; the
 * others are in `--muted`. `label` names a link when its text does not (`~`); it is not used for
 * an item without `href`. A link is at least 24px wide and high. Below 768px the list keeps
 * 24px clear of its right edge, for the diagonal band at the right edge of the head, and the
 * font is 12px; from 768px it is 13px. A long item, such as the file name of a post, breaks
 * anywhere, and the items wrap.
 */
import type { Locale } from "../../i18n/locales";
import { translate } from "../../i18n/ui";

/** One item of the breadcrumb. */
export interface BreadcrumbItem {
  /** Text of the item, such as `~` or `blog`. */
  text: string;
  /** Link target; undefined for an item that is not a link. */
  href?: string;
  /** Name of the link, when its text does not name it. Not used for an item without `href`. */
  label?: string;
}

interface Props {
  /** Items from the top page to the current page, which is the last one. */
  items: BreadcrumbItem[];
  /** Language of the name of the `nav`. */
  lang: Locale;
}

const { items, lang } = Astro.props;
const last = items.length - 1;
---

<nav aria-label={translate(lang, "nav.breadcrumb")}>
  <ol>
    {items.map((item, index) => (
  <li>
    {item.href === undefined ? (
      <span aria-current={index === last ? "page" : undefined}>
        {item.text}
      </span>
    ) : (
      <a
        href={item.href}
        aria-label={item.label}
        aria-current={index === last ? "page" : undefined}
      >
        {item.text}
      </a>
    )}
    {index < last && <span aria-hidden="true">/</span>}
  </li>
))}
  </ol>
</nav>

<style>
nav {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--muted);
}

ol {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin: 0;
  padding: 0 24px 0 0;
  list-style: none;
}

li {
  display: flex;
  align-items: center;
  gap: 4px;
  overflow-wrap: anywhere;
}

a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 24px;
  min-height: 24px;
}

[aria-current="page"] {
  color: var(--text);
}

@media (min-width: 768px) {
  nav {
    font-size: 13px;
  }

  ol {
    padding-right: 0;
  }
}
</style>
