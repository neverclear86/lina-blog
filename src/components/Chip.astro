---
/**
 * A small notched label, such as the post tags and "バーチャルイキリプログラマ" in
 * `design/CBMain.dc.html`.
 *
 * It is 28px high and stays on one line: a text longer than the space ends with an ellipsis.
 * It is not interactive; to make it a link, the caller wraps it in the three layers of
 * `shapes.css`.
 */
interface Props {
  /** Colors: "pink" or "orange" with `--legacy-ink` text, or "neutral" (`--chip`, `--fg`). */
  tone?: "pink" | "orange" | "neutral";
  /** Tilts the chip by -4deg, like the one in the hero. */
  tilt?: boolean;
  /** Classes for the chip, such as a layout class of the caller. */
  class?: string;
}

const { tone = "neutral", tilt = false, class: className } = Astro.props;
---

<span class:list={["chip", "shapeS", tone, { tilt }, className]}><slot /></span>

<style>
.chip {
  display: inline-block;
  box-sizing: border-box;
  height: 28px;
  max-width: 100%;
  padding: 0 12px;
  overflow: hidden;
  font-size: 13px;
  font-weight: 900;
  line-height: 28px;
  text-overflow: ellipsis;
  white-space: nowrap;
  vertical-align: middle;
}

.pink {
  background: var(--pink);
  color: var(--legacy-ink);
}

.orange {
  background: var(--orange);
  color: var(--legacy-ink);
}

.neutral {
  background: var(--chip);
  color: var(--fg);
}

.tilt {
  rotate: -4deg;
}
</style>
