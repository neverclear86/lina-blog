---
/**
 * The column of the Latest section after the large video window: one small window for each
 * given video, then a button to the YouTube channel. A small window is a link to the watch page
 * with the thumbnail, the date in Japan time and the title. The button stays when there are no
 * videos, such as when the feed could not be read.
 *
 * Below 768px the column is hidden with `display: none`, so the large window is the only video
 * of the section there. From 768px it takes the full width of its place and the height of its
 * content (`align-self: start`), so a short column does not stretch the large window.
 */
import type { Locale } from "../i18n/locales";
import { translate } from "../i18n/ui";
import { formatVideoDate } from "../latest-videos";
import { YOUTUBE_URL } from "../profile-links";
import type { YouTubeVideo } from "../youtube-feed";

interface Props {
  /** Locale of the page, which chooses the text of the button. */
  lang: Locale;
  /** Videos to list, newest first; all of them are shown. */
  videos: readonly YouTubeVideo[];
}

const { lang, videos } = Astro.props;
---

<div class="latest-video-list">
  {videos.length > 0 && (
  <ul class="list">
    {videos.map((v) => (
      <li>
        <a class="win video" href={v.url}>
          <div class="gridbg thumb">
            <img
              src={v.thumbnail.src}
              srcset={v.thumbnail.srcset}
              sizes="140px"
              width="480"
              height="270"
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="text">
            <time class="label" datetime={v.publishedAt.toISOString()}>
              {formatVideoDate(v.publishedAt)}
            </time>
            <span class="title" lang="ja">
              {v.title}
            </span>
          </div>
        </a>
      </li>
    ))}
  </ul>
)}
  <a class="btn btn-ghost channel" href={YOUTUBE_URL}>
    {translate(lang, "latest.videos.channel")}<span aria-hidden="true">→</span>
  </a>
</div>

<style>
.latest-video-list {
  display: none;
  flex-direction: column;
  gap: 14px;
}

@media (min-width: 768px) {
  .latest-video-list {
    display: flex;
    align-self: start;
    width: 100%;
    min-width: 0;
  }
}

.list {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin: 0;
  padding: 0;
  list-style: none;
}

li {
  min-width: 0;
}

.video {
  display: grid;
  grid-template-columns: 140px minmax(0, 1fr);
  align-items: center;
  gap: 14px;
  padding: 12px;
}

.thumb {
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border-radius: 4px;
}

.thumb img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.text {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 0;
}

.title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  overflow: hidden;
  font-size: 15px;
  font-weight: 700;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.channel {
  justify-content: space-between;
}
</style>
