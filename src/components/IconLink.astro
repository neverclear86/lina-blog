---
import { labelSegments } from "./label-break";

/**
 * A link shown as an icon square with a label below it, for the row of social links.
 *
 * The square is 44px with a 20px icon below 768px, and 56px with a 24px icon from 768px. The
 * icon comes in the default slot as an `<svg>` and is hidden from assistive technology, so the
 * label names the link. The label is split by `labelSegments` with a `<wbr>` before "(", so
 * that a label such as "Twitter(自称X)" wraps onto two lines in a narrow row.
 */
interface Props {
  /** Link target. */
  href: string;
  /** Visible label and the name of the link, such as `translate(lang, "social.twitter")`. */
  label: string;
  /** `rel` of the link, such as "me" for the profile links. */
  rel?: string;
  /** Classes for the `<a>`, such as a layout class of the caller. */
  class?: string;
}

const { href, label, rel, class: className } = Astro.props;
const segments = labelSegments(label);
---

<a class:list={["icon-link", className]} href={href} rel={rel}>
  <span class="shadow lift">
    <span class="shape icon" aria-hidden="true"><slot /></span>
  </span>
  <span class="label"
    >{segments.map((segment, index) => (
  <>
    {index > 0 && <wbr />}
    {segment}
  </>
))}</span
  >
</a>

<style>
.icon-link {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  color: var(--fg);
  text-decoration: none;
  vertical-align: top;
}

.icon-link > .lift {
  display: block;
}

.icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  background: var(--surf);
  color: var(--fg);
}

.icon > :global(svg) {
  width: 20px;
  height: 20px;
}

.label {
  font-size: 12px;
  font-weight: 900;
  text-align: center;
}

@media (min-width: 768px) {
  .icon-link {
    gap: 8px;
  }

  .icon {
    width: 56px;
    height: 56px;
  }

  .icon > :global(svg) {
    width: 24px;
    height: 24px;
  }
}
</style>
