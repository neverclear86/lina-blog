---
/**
 * The square icon-only button of the design, such as the theme switch and the menu button in
 * the headers of `design/CBMain.dc.html` and `design/CBMobile.dc.html`.
 *
 * The button shows no text. Its accessible name is `label`, written to `aria-label`, or the
 * content of the `label` slot, which is visually hidden and read instead of the icon; one of
 * the two is required. The icon comes in the default slot, hidden from assistive technology,
 * and the caller sets its size. The square is 40px below 768px and 44px from 768px.
 */
interface Props {
  /**
   * Accessible name of the button, such as "メニューを開く", written to `aria-label`. Leave it
   * out when the `label` slot names the button.
   */
  label?: string;
  /** Face and icon colors: "surface" (`--surf`, `--fg`) or "inverse" (`--inv`, `--invfg`). */
  tone?: "surface" | "inverse";
  /** Classes for the `<button>`, such as a layout class of the caller. */
  class?: string;
}

const { label, tone = "surface", class: className } = Astro.props;
if (label === undefined && !Astro.slots.has("label")) {
  throw new Error("IconButton needs a label prop or a label slot.");
}
---

<button
  class:list={["icon-button", className]}
  type="button"
  aria-label={label}
>
  <span class="shadow lift">
    <span class:list={["shape", "face", tone]} aria-hidden="true"
      ><slot /></span
    >
  </span>
  {Astro.slots.has("label") && (
  <span class="label">
    <slot name="label" />
  </span>
)}
</button>

<style>
.icon-button {
  display: inline-block;
  vertical-align: top;
  font: inherit;
  color: inherit;
  background: none;
  border: 0;
  padding: 0;
  cursor: pointer;
}

.icon-button > span {
  display: block;
}

.label {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

.face {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
}

.surface {
  background: var(--surf);
  color: var(--fg);
}

.inverse {
  background: var(--inv);
  color: var(--invfg);
}

@media (min-width: 768px) {
  .face {
    width: 44px;
    height: 44px;
  }
}
</style>
