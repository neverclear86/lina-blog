{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Publish Worker, deployed separately from the site Worker in the root wrangler.jsonc.
  // PUBLISH_TOKEN is a secret: `wrangler secret put` in production, `.dev.vars` locally.
  "name": "lina-blog-publish",
  "main": "src/app.ts",
  "compatibility_date": "2026-09-25",
  "observability": {
    "enabled": true
  }
}
